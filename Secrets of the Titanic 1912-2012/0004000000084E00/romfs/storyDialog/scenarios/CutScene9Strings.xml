<Strings>
	<ENGLISH>
	
		<LABEL CS_9_2_1_ARTHUR_1 = "Can yeleklerinin nerede saklandigini bilmiyorum, sen biliyor musun?" />.
		<LABEL CS_9_2_1_ELISABETH_1 = "Hayir, ama onlari bulup yolcular i&#231;in olabildigince &#231;ogunu g&#252;verteye tasiyalim." />
		
		<LABEL CS_9_3_1_ELISABETH_1 = "O da neydi? Bir ses duydum!" />
		<LABEL CS_9_3_1_ARTHUR_1 = "Sence buzdagi miydi?" />
		
		<LABEL CS_9_3_2_ELISABETH_1 = "Oh, s&#252;k&#252;r! Sadece oglunuzmus." />
		<LABEL CS_9_3_2_JACOB_1 = "Bir yapboz buldum, onunla oynayabilir miyim baba?" />
		<LABEL CS_9_3_2_ARTHUR_1 = "Iyi fikir, oglum. Seninle ger&#231;ekten gurur duyuyorum, &#231;ok cesursun." />
		
		<LABEL CS_9_3_3_JACOB_1 = "Sanirim bir seye &#231;arptik. Sen de hissettin mi?" />
		
		<LABEL CS_9_3_4_ELISABETH_1 = "Sanirim o buzdagiydi. Simdi cesur olma zamani..." />
		<LABEL CS_9_3_4_ARTHUR_1 = "Yanimiza birka&#231; sey alip g&#252;verteye &#231;ikalim." />
		
		
		<LABEL CS_9_3_5_ELISABETH_1 = "Kapi a&#231;ilmiyor!" />
		<LABEL CS_9_3_5_ARTHUR_1 = "Kilitli gibi g&#246;r&#252;n&#252;yor" />
		<LABEL CS_9_3_5_ELISABETH_2 = "Panik yapma, sanirim a&#231;abilirim. Bir deneyeyim..." />
		
		<LABEL CS_9_3_6_ELISABETH_1 = "&#199;ok tuhaf, kimse panik yapmiyor." />
		<LABEL CS_9_3_6_ARTHUR_1 = "Hasarin ne kadar b&#252;y&#252;k oldugunu hen&#252;z bilmiyorlar Elizabeth. B&#252;t&#252;n d&#252;nya Titanic'in batmaz olduguna inaniyor, o halde neden panik yapsinlar ki?" />
		<LABEL CS_9_3_6_LADY_1 = "Elizabeth, b&#252;t&#252;n bu yaygara da ne ve bu iki serseriyi nereden buldunuz?" />
		<LABEL CS_9_3_6_ELISABETH_2 = "Hemen filikalara gitmelisiniz, bu gemi batiyor." />
		<LABEL CS_9_3_6_LADY_2 = "Bu kadar sa&#231;ma olmayin, Titanic batamaz!" />
		<LABEL CS_9_3_6_ELISABETH_3 = "Ama batacak, hem de &#231;ok yakinda. L&#252;tfen dedigimi yapin ve bir filikaya gidin." />
		<LABEL CS_9_3_6_LADY_3 = "Neden bu batmaz geminin g&#252;venligini birakip dengesiz bir tahta filikayi tercih edeyim ki?" />
		<LABEL CS_9_3_6_ELISABETH_4 = "Olacak gibi degil, i&#231;inde bulunduklari tehlikeye onlari ikna edemeyecegiz." />
		<LABEL CS_9_3_6_ARTHUR_2 = "Bakin! Su y&#252;kseliyor, g&#252;verteye &#231;abucak &#231;ikmamiz gerekiyor!" />
		<LABEL CS_9_3_6_ELISABETH_5 = "Bu kapi sikismis gibi, baska bir yol bulmamiz gerekecek." />
		<LABEL CS_9_3_6_ARTHUR_3 = "Beni takip edin..." />
	
	</ENGLISH>
	
	<FRENCH>
		
		<LABEL CS_9_2_1_ARTHUR_1 = "Je ne sais pas où sont stockés les gilets de sauvetage, et vous ?" />.
		<LABEL CS_9_2_1_ELISABETH_1 = "Moi non plus, mais trouvons-les et apportons-en autant que nous le pouvons sur le pont pour les passagers." />
		
		<LABEL CS_9_3_1_ELISABETH_1 = "Qu'est-ce que c'était ? J'ai entendu un bruit !" />
		<LABEL CS_9_3_1_ARTHUR_1 = "Vous croyez que c'était l'iceberg ?" />
		
		<LABEL CS_9_3_2_ELISABETH_1 = "Oh, ouf ! C'est juste notre fils !" />
		<LABEL CS_9_3_2_JACOB_1 = "J'ai trouvé un puzzle, puis-je jouer avec, 'Pa" />
		<LABEL CS_9_3_2_ARTHUR_1 = "Bonne idée, fils. Je suis vraiment fier de toi, tu as été si courageux." />
		
		<LABEL CS_9_3_3_JACOB_1 = "Je crois que nous avons heurté quelque chose. Vous l’avez senti ?" />
		
		<LABEL CS_9_3_4_ELISABETH_1 = "Je pense que c'était l'iceberg. C'est l'heure d'être courageux..." />
		<LABEL CS_9_3_4_ARTHUR_1 = "Prenons quelques affaires et dirigeons-nous vers le pont." />
		
		
		<LABEL CS_9_3_5_ELISABETH_1 = "La porte ne s'ouvre pas !" />
		<LABEL CS_9_3_5_ARTHUR_1 = "Elle a l'air d'être fermée à clé" />
		<LABEL CS_9_3_5_ELISABETH_2 = "Ne paniquez pas, je crois que je peux la déverrouiller. Laissez-moi essayer..." />
		
		<LABEL CS_9_3_6_ELISABETH_1 = "C'est très étrange, personne ne panique." />
		<LABEL CS_9_3_6_ARTHUR_1 = "Ils ne savent pas encore l'étendue des dégats, Elizabeth. Le monde entier croit que le Titanic est insubmersible, pourquoi devraient-il paniquer ?" />
		<LABEL CS_9_3_6_LADY_1 = "Elizabeth, qu'est-ce que c'est que tout ce remue-ménage, et où donc avez-vous trouvé ces deux énergumènes ?" />
		<LABEL CS_9_3_6_ELISABETH_2 = "Il faut vite aller aux canots de sauvetage, ce bateau est en train de couler !" />
		<LABEL CS_9_3_6_LADY_2 = "Ne sois pas ridicule, le Titanic ne peut pas couler !" />
		<LABEL CS_9_3_6_ELISABETH_3 = "Mais il va le faire, et très bientôt. De grâce, faites ce que je vous dis et rejoignez un canot de sauvetage !" />
		<LABEL CS_9_3_6_LADY_3 = "Pourquoi devrais-je quitter la sécurité de ce bateau insubmersible en faveur d'une instable embarcation en bois ?" />
		<LABEL CS_9_3_6_ELISABETH_4 = "Ca ne marche pas, nous n'arriverons pas à les convaincre du danger qu'ils courent." />
		<LABEL CS_9_3_6_ARTHUR_2 = "Regardez ! L'eau monte, il faut rejoindre le pont très vite !" />
		<LABEL CS_9_3_6_ELISABETH_5 = "Cette porte a l'air bloquée, il faut qu'on trouve un autre passage." />
		<LABEL CS_9_3_6_ARTHUR_3 = "Suivez-moi..." />
		
	</FRENCH>
	
	<GERMAN>
	
		<LABEL CS_9_2_1_ARTHUR_1 = "Ich weiß nicht, wo die Schwimmwesten aufbewahrt werden, und Sie?" />.
		<LABEL CS_9_2_1_ELISABETH_1 = "Ich auch nicht, aber lassen Sie uns so viele wie möglich finden und zu den Passagieren an Deck bringen." />

		<LABEL CS_9_3_1_ELISABETH_1 = "Was war denn das? Ich habe ein Geräusch gehört!" />
		<LABEL CS_9_3_1_ARTHUR_1 = "Meinen Sie, das war der Eisberg?" />

		<LABEL CS_9_3_2_ELISABETH_1 = "Oh, uff! Es ist nur Ihr Sohn." />
		<LABEL CS_9_3_2_JACOB_1 = "Ich habe ein Puzzle gefunden, darf ich damit spielen, Papa?" />
		<LABEL CS_9_3_2_ARTHUR_1 = "Gute Idee, mein Sohn. Ich bin sehr stolz, dass du so tapfer bist." />

		<LABEL CS_9_3_3_JACOB_1 = "Ich glaube, wir haben etwas gerammt. Haben Sie das gespürt?" />

		<LABEL CS_9_3_4_ELISABETH_1 = "Ich glaube, das war der Eisberg. Jetzt heißt es tapfer sein ..." />
		<LABEL CS_9_3_4_ARTHUR_1 = "Lassen Sie uns ein paar Sachen schnappen und dann nach oben an Deck gehen." />


		<LABEL CS_9_3_5_ELISABETH_1 = "Die Tür geht nicht auf!" />
		<LABEL CS_9_3_5_ARTHUR_1 = "Sie scheint abgesperrt zu sein." />
		<LABEL CS_9_3_5_ELISABETH_2 = "Keine Panik, ich denke, ich kann sie öffnen. Lassen Sie mich mal versuchen ..." />

		<LABEL CS_9_3_6_ELISABETH_1 = "Es ist so seltsam, dass niemand in Panik gerät." />
		<LABEL CS_9_3_6_ARTHUR_1 = "Sie haben noch keine Ahnung vom Ausmaß des Schadens, Elizabeth. Alle Welt glaubt doch, dass die Titanic unsinkbar ist, warum also in Panik geraten?" />
		<LABEL CS_9_3_6_LADY_1 = "Elizabeth, was ist denn hier los, und wo haben Sie nur diese beiden Kerle aufgetrieben?" />
		<LABEL CS_9_3_6_ELISABETH_2 = "Sie müssen so schnell wie möglich zu den Rettungsbooten. Dieses Schiff sinkt!" />
		<LABEL CS_9_3_6_LADY_2 = "Machen Sie sich nicht lächerlich, die Titanic kann gar nicht sinken!" />
		<LABEL CS_9_3_6_ELISABETH_3 = "Aber sie wird, und zwar bald. Tun Sie bitte, was ich Ihnen sage und begeben Sie sich zu einem Rettungsboot." />
		<LABEL CS_9_3_6_LADY_3 = "Warum sollte ich mich aus der Sicherheit dieses unsinkbaren Schiffes auf ein wackeliges hölzernes Rettungsboot begeben?" />
		<LABEL CS_9_3_6_ELISABETH_4 = "Es hat keinen Zweck, wir werden ihnen nicht klarmachen können, in welcher Gefahr sie sich befinden." />
		<LABEL CS_9_3_6_ARTHUR_2 = "Sehen Sie! Das Wasser steigt, wir müssen schnell an Deck!" />
		<LABEL CS_9_3_6_ELISABETH_5 = "Diese Tür scheint zu klemmen, wir müssen einen anderen Weg finden." />
		<LABEL CS_9_3_6_ARTHUR_3 = "Folgen Sie mir ..." />

		
	</GERMAN>
	
	<ITALIAN>
	
		<LABEL CS_9_2_1_ARTHUR_1 = "Non so dove sono conservati i giubbotti di salvataggio. Voi lo sapete?" />.
		<LABEL CS_9_2_1_ELISABETH_1 = "No, ma troviamoli e portiamone quanti più possibile sul ponte per i passeggeri." />
		
		<LABEL CS_9_3_1_ELISABETH_1 = "Che cos'è stato? Ho sentito un rumore!" />
		<LABEL CS_9_3_1_ARTHUR_1 = "Credete sia stato l'iceberg?" />
		
		<LABEL CS_9_3_2_ELISABETH_1 = "Oh, uff! È solo vostro figlio." />
		<LABEL CS_9_3_2_JACOB_1 = "Ho trovato un puzzle, posso giocarci, papà?" />
		<LABEL CS_9_3_2_ARTHUR_1 = "Buona idea, figlio mio. Sono davvero orgoglioso di te, sei così coraggioso." />
		
		<LABEL CS_9_3_3_JACOB_1 = "Credo che abbiamo colpito qualcosa. L'avete sentito?" />
		
		<LABEL CS_9_3_4_ELISABETH_1 = "Credo sia l'iceberg. Ora dobbiamo davvero essere coraggiosi..." />
		<LABEL CS_9_3_4_ARTHUR_1 = "Prendiamo poche cose e raggiungiamo il ponte." />
		
		
		<LABEL CS_9_3_5_ELISABETH_1 = "La porta non si apre!" />
		<LABEL CS_9_3_5_ARTHUR_1 = "Sembra bloccata." />
		<LABEL CS_9_3_5_ELISABETH_2 = "Niente panico, credo di poterla sbloccare. Fatemi..." />
		
		<LABEL CS_9_3_6_ELISABETH_1 = "Che strano, nessuno è spaventato." />
		<LABEL CS_9_3_6_ARTHUR_1 = "Non conoscono ancora la vera entità del danno, Elizabeth. Tutto il mondo crede che il Titanic sia inaffondabile, perché dovrebbero avere paura?" />
		<LABEL CS_9_3_6_LADY_1 = "Elizabeth, che cos'è tutto questo caos e chi sono queste due canaglie che vi portate dietro?" />
		<LABEL CS_9_3_6_ELISABETH_2 = "Dovete raggiungere le scialuppe in fretta, la nave sta affondando." />
		<LABEL CS_9_3_6_LADY_2 = "Non siate ridicola, il Titanic non può affondare!" />
		<LABEL CS_9_3_6_ELISABETH_3 = "Ma affonderà, e presto anche. Fate come vi ho detto e raggiungete la scialuppa." />
		<LABEL CS_9_3_6_LADY_3 = "Perché dovrei lasciare questa sicurissima nave inaffondabile e salire su un'instabile scialuppa di legno?" />
		<LABEL CS_9_3_6_ELISABETH_4 = "Non va bene, non capiranno mai il pericolo che stanno correndo." />
		<LABEL CS_9_3_6_ARTHUR_2 = "Guardate! L'acqua sta salendo, dobbiamo raggiungere il ponte in fretta!" />
		<LABEL CS_9_3_6_ELISABETH_5 = "Questa porta sembra sbarrata, dobbiamo trovare un'altra strada." />
		<LABEL CS_9_3_6_ARTHUR_3 = "Seguitemi..." />
		 
	</ITALIAN>
	
	<SPANISH>
	
		<LABEL CS_9_2_1_ARTHUR_1="No sé dónde se guardan los chalecos salvavidas. ¿Y usted?"/>
		<LABEL CS_9_2_1_ELISABETH_1="No, pero tenemos que encontrar todos los que podamos para subirlos a cubierta para que los pasajeros puedan utilizarlos."/>
		  
		<LABEL CS_9_3_1_ELISABETH_1="¿Qué ha sido eso? ¡Se ha escuchado un ruido!"/>
		<LABEL CS_9_3_1_ARTHUR_1="¿Crees que ha sido el iceberg?"/>
		  
		<LABEL CS_9_3_2_ELISABETH_1="Oh... ¡Menos mal! Es su hijo."/>
		<LABEL CS_9_3_2_JACOB_1="He encontrado un rompecabezas. Papá, ¿puedo jugar?"/>
		<LABEL CS_9_3_2_ARTHUR_1="Buena idea, hijo. Estoy muy orgulloso de ti, estás siendo muy valiente."/>
		  
		<LABEL CS_9_3_3_JACOB_1="Creo que hemos chocado con algo. ¿Lo habéis notado?"/>
		  
		<LABEL CS_9_3_4_ELISABETH_1="Creo que ha sido el iceberg. Ahora es cuando tenemos que ser valientes..."/>
		<LABEL CS_9_3_4_ARTHUR_1="Cojamos algunas cosas y subamos a cubierta."/>
		  
		  
		<LABEL CS_9_3_5_ELISABETH_1="¡La puerta no se abre!"/>
		<LABEL CS_9_3_5_ARTHUR_1="Parece que está cerrada."/>
		<LABEL CS_9_3_5_ELISABETH_2="¡Que no cunda el pánico! Creo que sé como abrirla. Voy a probar..."/>
		  
		<LABEL CS_9_3_6_ELISABETH_1="Qué raro... Todavía no ha cundido el pánico."/>
		<LABEL CS_9_3_6_ARTHUR_1="Elizabeth, todavía no saben lo grave que es la situación. Todo el mundo cree que el Titanic es insumergible... ¿Por qué debería de cundir el pánico?"/>
		<LABEL CS_9_3_6_LADY_1="Elizabeth, ¿de qué va todo esto? ¿Quién es esta gentuza?"/>
		<LABEL CS_9_3_6_ELISABETH_2="Tiene que ir a los botes salvavidas cuanto antes. ¡El barco se está hundiendo!"/>
		<LABEL CS_9_3_6_LADY_2="No sea ridícula. ¡El Titanic no puede hundirse!"/>
		<LABEL CS_9_3_6_ELISABETH_3="Sí que puede, y lo está haciendo. Haga lo que le digo y vaya a un bote salvavidas."/>
		<LABEL CS_9_3_6_LADY_3="¿Por qué debería abandonar este barco insumergible para subirme a bordo de un bote salvavidas de madera?"/>
		<LABEL CS_9_3_6_ELISABETH_4="Esto no va bien. No vamos a convencerles del peligro en el que se encuentran."/>
		<LABEL CS_9_3_6_ARTHUR_2="¡Mire! ¡El agua está subiendo! ¡Tenemos que llegar a cubierta cuanto antes!"/>
		<LABEL CS_9_3_6_ELISABETH_5="Esta puerta está atrancada. Tenemos que encontrar otro camino."/>
		<LABEL CS_9_3_6_ARTHUR_3="Sígame..."/>
		
	</SPANISH>
	
	<DUTCH>
			
		<LABEL CS_9_2_1_ARTHUR_1 = "Ik weet niet waar de reddingsvesten liggen, jij?" />.
		<LABEL CS_9_2_1_ELISABETH_1 = "Nee, maar laten we ze zoeken en zoveel mogelijk vesten naar het dek brengen voor de passagiers." />
		
		<LABEL CS_9_3_1_ELISABETH_1 = "Wat was dat? Ik hoorde een geluid!" />
		<LABEL CS_9_3_1_ARTHUR_1 = "Denk je dat het de ijsberg was?" />
		
		<LABEL CS_9_3_2_ELISABETH_1 = "O, gelukkig! Het was je zoon maar." />
		<LABEL CS_9_3_2_JACOB_1 = "Ik heb een legpuzzel gevonden. Mag ik ermee spelen papa?" />
		<LABEL CS_9_3_2_ARTHUR_1 = "Goed idee, zoon. Ik ben heel trots op je. Je bent heel dapper." />
		
		<LABEL CS_9_3_3_JACOB_1 = "Volgens mij hebben we iets geraakt. Voelde je dat?" />
		
		<LABEL CS_9_3_4_ELISABETH_1 = "Dat was de ijsberg denk ik. Nu is het tijd om dapper te zijn..." />
		<LABEL CS_9_3_4_ARTHUR_1 = "Laten we een paar dingen meenemen en naar het dek gaan." />
		
		
		<LABEL CS_9_3_5_ELISABETH_1 = "De deur gaat niet open!" />
		<LABEL CS_9_3_5_ARTHUR_1 = "Hij zit op slot" />
		<LABEL CS_9_3_5_ELISABETH_2 = "Geen paniek, ik kan 'm wel open krijgen. Laat me maar even kijken..." />
		
		<LABEL CS_9_3_6_ELISABETH_1 = "Vreemd, niemand raakt in paniek." />
		<LABEL CS_9_3_6_ARTHUR_1 = "Ze weten de volle omvang van de schade nog niet, Elizabeth. De hele wereld gelooft dat de Titanic onzinkbaar is, dus waarom zouden ze in paniek raken?" />
		<LABEL CS_9_3_6_LADY_1 = "Elizabeth, wat is er toch allemaal aan de hand en waar heb je in hemelsnaam die twee sloebers gevonden?" />
		<LABEL CS_9_3_6_ELISABETH_2 = "Je moet zo snel mogelijk naar de reddingsboten, het schip zinkt." />
		<LABEL CS_9_3_6_LADY_2 = "Doe niet zo belachelijk, de Titanic kan niet zinken!" />
		<LABEL CS_9_3_6_ELISABETH_3 = "Maar dat doet-ie wel, en snel ook. Doe alsjeblieft wat ik zeg en zoek een reddingsboot." />
		<LABEL CS_9_3_6_LADY_3 = "Waarom zou ik de veiligheid van een onzinkbaar schip inruilen voor een gammele houten boot?" />
		<LABEL CS_9_3_6_ELISABETH_4 = "Het heeft geen zin, we kunnen ze niet van het gevaar overtuigen." />
		<LABEL CS_9_3_6_ARTHUR_2 = "Kijk! Het water stijgt. We moeten zo snel mogelijk naar het dek!" />
		<LABEL CS_9_3_6_ELISABETH_5 = "Deze deur zit vast, we moeten een andere weg zoeken." />
		<LABEL CS_9_3_6_ARTHUR_3 = "Volg mij..." />
		
	</DUTCH>
</Strings>
