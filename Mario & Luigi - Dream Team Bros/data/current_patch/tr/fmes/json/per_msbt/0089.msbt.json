      "original_text": "<C:0001,0004,>Oh honh!<C:0003,0000,0A00>\nNihayet geldiniz!<C:0003,0001,><C:0000,0004,><C:0001,0004,>Beni çok\nuzun süre beklettiniz!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Oh honh!<C:0003,0000,0A00>\nNihayet geldiniz!<C:0003,0001,><C:0000,0004,><C:0001,0004,>Beni çok\nuzun süre beklettiniz!<C:0003,0001,>",
