    },
    "29": {
      "text": "<C:0001,0004,>Oh...<C:0003,0000,0A00> Ah!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Oh...<C:0003,0000,0A00> Ah!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Oh...<C:0003,0000,0A00> Ah!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Oh...<C:0003,0000,0A00> Ah!<C:0003,0001,>",
      "raw_full_hex": "0E000100040000004F0068002E002E002E000E000300000002000A0020004100680021000E000300010000000000"
    },
    "30": {
      "text": "<C:0001,0004,>Mm?<C:0003,0000,0A00> Uyan hadi!<C:0003,0001,><C:0000,0004,>Şimdi!<C:0003,0000,0A00> Tembel canavar!<C:0003,0000,0A00>\nBurası uyuklama vakti değil!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Mm?<C:0003,0000,0A00> Uyan hadi!<C:0003,0001,><C:0000,0004,>Şimdi!<C:0003,0000,0A00> Tembel canavar!<C:0003,0000,0A00>\nBurası uyuklama vakti değil!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Mm?<C:0003,0000,0A00> Uyan hadi!<C:0003,0001,><C:0000,0004,>Şimdi!<C:0003,0000,0A00> Tembel canavar!<C:0003,0000,0A00>\nBurası uyuklama vakti değil!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Mm?<C:0003,0000,0A00> Uyan hadi!<C:0003,0001,><C:0000,0004,>Şimdi!<C:0003,0000,0A00> Tembel canavar!<C:0003,0000,0A00>\nBurası uyuklama vakti değil!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "31": {
      "text": "<C:0001,0004,>Bay Mario!<C:0003,0000,0A00>\nAnı yakalayın!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Bay Mario!<C:0003,0000,0A00>\nAnı yakalayın!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Bay Mario!<C:0003,0000,0A00>\nAnı yakalayın!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Bay Mario!<C:0003,0000,0A00>\nAnı yakalayın!<C:0003,0001,>",
      "raw_full_hex": "0E0001000400000042006100790020004D006100720069006F0021000E000300000002000A000A0041006E0031012000790061006B0061006C006100790031016E0021000E000300010000000000"
    },
    "32": {
      "text": "<C:0001,0004,>Savaşı başlatmak için o zavallı\ndüşmanın üstüne zıplayın!<C:0003,0001,><C:0000,0004,>Şansınız yaver giderse\ndövüş başlamadan biraz hasar\nverirsiniz!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Savaşı başlatmak için o zavallı\ndüşmanın üstüne zıplayın!<C:0003,0001,><C:0000,0004,>Şansınız yaver giderse\ndövüş başlamadan biraz hasar\nverirsiniz!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Savaşı başlatmak için o zavallı\ndüşmanın üstüne zıplayın!<C:0003,0001,><C:0000,0004,>Şansınız yaver giderse\ndövüş başlamadan biraz hasar\nverirsiniz!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Savaşı başlatmak için o zavallı\ndüşmanın üstüne zıplayın!<C:0003,0001,><C:0000,0004,>Şansınız yaver giderse\ndövüş başlamadan biraz hasar\nverirsiniz!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "33": {
      "text": "<C:0001,0004,>Eh, o da öyle oldu işte...<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Eh, o da öyle oldu işte...<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Eh, o da öyle oldu işte...<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Eh, o da öyle oldu işte...<C:0003,0001,>",
      "raw_full_hex": "0E00010004000000450068002C0020006F002000640061002000F60079006C00650020006F006C0064007500200069005F01740065002E002E002E000E000300010000000000"
    },
    "34": {
      "text": "<C:0001,0004,>Şurada burada birkaç hata oldu...<C:0003,0000,0A00>\nAma yine de ne gösteriydi, non?<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Şurada burada birkaç hata oldu...<C:0003,0000,0A00>\nAma yine de ne gösteriydi, non?<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Şurada burada birkaç hata oldu...<C:0003,0000,0A00>\nAma yine de ne gösteriydi, non?<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Şurada burada birkaç hata oldu...<C:0003,0000,0A00>\nAma yine de ne gösteriydi, non?<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "35": {
      "text": "<C:0001,0004,>Bu<C:0003,0000,0A00> bir gösteri miydi?<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Bu<C:0003,0000,0A00> bir gösteri miydi?<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Bu<C:0003,0000,0A00> bir gösteri miydi?<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Bu<C:0003,0000,0A00> bir gösteri miydi?<C:0003,0001,>",
      "raw_full_hex": "0E00010004000000420075000E000300000002000A00200062006900720020006700F6007300740065007200690020006D0069007900640069003F000E000300010000000000"
    },
    "36": {
      "text": "<C:0001,0004,>Ama tabii ki!<C:0003,0001,><C:0000,0004,>Bu, sizin için hazırladığımız\npek çok etkinlikten yalnızca biri!<C:0003,0001,><C:0000,0004,>Heyecanı hissettiniz, non?\nCanavar yemeği, ha!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Ama tabii ki!<C:0003,0001,><C:0000,0004,>Bu, sizin için hazırladığımız\npek çok etkinlikten yalnızca biri!<C:0003,0001,><C:0000,0004,>Heyecanı hissettiniz, non?\nCanavar yemeği, ha!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Ama tabii ki!<C:0003,0001,><C:0000,0004,>Bu, sizin için hazırladığımız\npek çok etkinlikten yalnızca biri!<C:0003,0001,><C:0000,0004,>Heyecanı hissettiniz, non?\nCanavar yemeği, ha!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Ama tabii ki!<C:0003,0001,><C:0000,0004,>Bu, sizin için hazırladığımız\npek çok etkinlikten yalnızca biri!<C:0003,0001,><C:0000,0004,>Heyecanı hissettiniz, non?\nCanavar yemeği, ha!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "37": {
      "text": "<C:0001,0004,>Oh, çok rahatladım!\nKalbim neredeyse duruyordu!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Oh, çok rahatladım!\nKalbim neredeyse duruyordu!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Oh, çok rahatladım!\nKalbim neredeyse duruyordu!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Oh, çok rahatladım!\nKalbim neredeyse duruyordu!<C:0003,0001,>",
      "raw_full_hex": "0E000100040000004F0068002C002000E7006F006B002000720061006800610074006C006100640031016D0021000A004B0061006C00620069006D0020006E00650072006500640065007900730065002000640075007200750079006F0072006400750021000E000300010000000000"
    },
    "38": {
      "text": "<C:0001,0004,>Honh, oui, bu tatmin edici oldu.<C:0003,0000,0A00>\nŞimdi yolumuza devam edelim!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Honh, oui, bu tatmin edici oldu.<C:0003,0000,0A00>\nŞimdi yolumuza devam edelim!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Honh, oui, bu tatmin edici oldu.<C:0003,0000,0A00>\nŞimdi yolumuza devam edelim!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Honh, oui, bu tatmin edici oldu.<C:0003,0000,0A00>\nŞimdi yolumuza devam edelim!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "39": {
      "text": "<C:0001,0004,>Mışilos Kalesi,\nişte tam önümüzde!<C:0003,0001,><C:0000,0004,>Sadece un moment\nkaldı!<C:0003,0000,0A00> Gelin!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Mışilos Kalesi,\nişte tam önümüzde!<C:0003,0001,><C:0000,0004,>Sadece un moment\nkaldı!<C:0003,0000,0A00> Gelin!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Mışilos Kalesi,\nişte tam önümüzde!<C:0003,0001,><C:0000,0004,>Sadece un moment\nkaldı!<C:0003,0000,0A00> Gelin!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Mışilos Kalesi,\nişte tam önümüzde!<C:0003,0001,><C:0000,0004,>Sadece un moment\nkaldı!<C:0003,0000,0A00> Gelin!<C:0003,0001,>",
      "raw_full_hex": ""
    },
