    "23": {
      "text": "<C:0001,0004,>Bay Mario!<C:0003,0000,0A00> İşler\nbayağı tehlikeli bir hâl aldı!<C:0003,0001,><C:0000,0004,>Ben ve sağlam yapılı dostlarım\nburada kalıp prensesi koruyacağız.<C:0003,0001,><C:0000,0004,>Siz de önden gidip neler\nolduğuna bakın. Haydi bakalım,\naslanım.<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Bay Mario!<C:0003,0000,0A00> İşler\nbayağı tehlikeli bir hâl aldı!<C:0003,0001,><C:0000,0004,>Ben ve sağlam yapılı dostlarım\nburada kalıp prensesi koruyacağız.<C:0003,0001,><C:0000,0004,>Siz de önden gidip neler\nolduğuna bakın. Haydi bakalım,\naslanım.<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Bay Mario!<C:0003,0000,0A00> İşler\nbayağı tehlikeli bir hâl aldı!<C:0003,0001,><C:0000,0004,>Ben ve sağlam yapılı dostlarım\nburada kalıp prensesi koruyacağız.<C:0003,0001,><C:0000,0004,>Siz de önden gidip neler\nolduğuna bakın. Haydi bakalım,\naslanım.<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Bay Mario!<C:0003,0000,0A00> İşler\nbayağı tehlikeli bir hâl aldı!<C:0003,0001,><C:0000,0004,>Ben ve sağlam yapılı dostlarım\nburada kalıp prensesi koruyacağız.<C:0003,0001,><C:0000,0004,>Siz de önden gidip neler\nolduğuna bakın. Haydi bakalım,\naslanım.<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "24": {
      "text": "<C:0001,0004,>Oh honh!<C:0003,0000,0A00>\nNihayet geldiniz!<C:0003,0001,><C:0000,0004,><C:0001,0004,>Beni çok\nuzun süre beklettiniz!<C:0003,0001,>",
