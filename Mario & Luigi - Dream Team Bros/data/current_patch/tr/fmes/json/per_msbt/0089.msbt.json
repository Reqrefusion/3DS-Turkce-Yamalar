    },
    "26": {
      "text": "<C:0001,0004,>Voilà!<C:0003,0000,0A00><C:0000,0004,>Bu olan daha güçlü!\nOui, hem de aç gözlü!<C:0003,0001,><C:0000,0004,>Kemirmeye hazır olun!<C:0003,0001,><C:0000,0004,>Son lokma da yenmeden\nbu iş bitmeyecek!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Voilà!<C:0003,0000,0A00><C:0000,0004,>Bu olan daha güçlü!\nOui, hem de aç gözlü!<C:0003,0001,><C:0000,0004,>Kemirmeye hazır olun!<C:0003,0001,><C:0000,0004,>Son lokma da yenmeden\nbu iş bitmeyecek!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Voilà!<C:0003,0000,0A00><C:0000,0004,>Bu olan daha güçlü!\nOui, hem de aç gözlü!<C:0003,0001,><C:0000,0004,>Kemirmeye hazır olun!<C:0003,0001,><C:0000,0004,>Son lokma da yenmeden\nbu iş bitmeyecek!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Voilà!<C:0003,0000,0A00><C:0000,0004,>Bu olan daha güçlü!\nOui, hem de aç gözlü!<C:0003,0001,><C:0000,0004,>Kemirmeye hazır olun!<C:0003,0001,><C:0000,0004,>Son lokma da yenmeden\nbu iş bitmeyecek!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "27": {
      "text": "<C:0001,0004,>Şimdi!<C:0003,0000,1E00>",
      "tokenized_text": "<C:0001,0004,>Şimdi!<C:0003,0000,1E00>",
      "original_text": "<C:0001,0004,>Şimdi!<C:0003,0000,1E00>",
      "original_tokenized_text": "<C:0001,0004,>Şimdi!<C:0003,0000,1E00>",
      "raw_full_hex": "0E000100040000005E0169006D006400690021000E000300000002001E000000"
    },
    "28": {
      "text": "<C:0001,0004,>Üstüne çullanın!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Üstüne çullanın!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Üstüne çullanın!<C:0003,0001,>",
