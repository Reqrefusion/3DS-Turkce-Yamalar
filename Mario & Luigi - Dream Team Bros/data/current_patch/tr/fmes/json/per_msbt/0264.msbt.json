    "2": {
      "text": "Rehbere göre orası<U:000A>delicesine hareketliymiş.<C:0003,0001,><C:0000,0004,>Oraya gitmek için sabırsızlanıyorum!<U:000A>Deliler gibi alışveriş yapacağım!<C:0003,0001,>",
      "tokenized_text": "Rehbere göre orası<U:000A>delicesine hareketliymiş.<C:0003,0001,><C:0000,0004,>Oraya gitmek için sabırsızlanıyorum!<U:000A>Deliler gibi alışveriş yapacağım!<C:0003,0001,>",
      "original_text": "Rehbere göre orası<U:000A>delicesine hareketliymiş.<C:0003,0001,><C:0000,0004,>Oraya gitmek için sabırsızlanıyorum!<U:000A>Deliler gibi alışveriş yapacağım!<C:0003,0001,>",
      "original_tokenized_text": "Rehbere göre orası<U:000A>delicesine hareketliymiş.<C:0003,0001,><C:0000,0004,>Oraya gitmek için sabırsızlanıyorum!<U:000A>Deliler gibi alışveriş yapacağım!<C:0003,0001,>",
