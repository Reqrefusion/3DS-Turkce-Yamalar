    "1": {
      "text": "<C:0007,0000,>Ne var ne yok?<C:0003,0000,000A>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,000A><C:0000,0003,0000FF00>Benimle konuş\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,000A><C:0000,0003,0000FF00>Rüya dünyasına gir\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,000A><C:0000,0003,0000FF00>Boş ver<C:0003,0000,000A>",
      "tokenized_text": "<C:0007,0000,>Ne var ne yok?<C:0003,0000,000A>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,000A><C:0000,0003,0000FF00>Benimle konuş\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,000A><C:0000,0003,0000FF00>Rüya dünyasına gir\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,000A><C:0000,0003,0000FF00>Boş ver<C:0003,0000,000A>",
      "original_text": "<C:0007,0000,>Ne var ne yok?<C:0003,0000,000A>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,000A><C:0000,0003,0000FF00>Benimle konuş\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,000A><C:0000,0003,0000FF00>Rüya dünyasına gir\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,000A><C:0000,0003,0000FF00>Boş ver<C:0003,0000,000A>",
      "original_tokenized_text": "<C:0007,0000,>Ne var ne yok?<C:0003,0000,000A>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,000A><C:0000,0003,0000FF00>Benimle konuş\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,000A><C:0000,0003,0000FF00>Rüya dünyasına gir\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,000A><C:0000,0003,0000FF00>Boş ver<C:0003,0000,000A>",
      "raw_full_hex": ""
    },
