    "17": {
      "text": "\u0002\u0002d<C:0001,0004,>Tapınağa girebilmek için\nçok sayıda Uyurgezer Taşı gerekecek.<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "tokenized_text": "\u0002\u0002d<C:0001,0004,>Tapınağa girebilmek için\nçok sayıda Uyurgezer Taşı gerekecek.<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "original_text": "\u0002\u0002d<C:0001,0004,>Tapınağa girebilmek için\nçok sayıda Uyurgezer Taşı gerekecek.<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "original_tokenized_text": "\u0002\u0002d<C:0001,0004,>Tapınağa girebilmek için\nçok sayıda Uyurgezer Taşı gerekecek.<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
