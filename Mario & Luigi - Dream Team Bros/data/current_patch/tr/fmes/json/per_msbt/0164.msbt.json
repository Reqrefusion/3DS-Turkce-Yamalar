    "18": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Onh!<C:0003,0000,0A00> Ne kardeş sevgisi ama...\nLuigi, sen harikasın!<C:0003,0001,><C:0000,0003,000000FF>",
