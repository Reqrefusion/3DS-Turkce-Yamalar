    },
    "16": {
      "text": "<C:0001,0004,>Bir de şu bıyık! İçinde öyle\nbir...\nhava var ki! Tam bir... je ne sais\nquoi!<C:0003,0001,><C:0000,0004,>Non, artık inkâr edilemez!\nLuigi tam bir... rüya delikanlısı!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Bir de şu bıyık! İçinde öyle\nbir...\nhava var ki! Tam bir... je ne sais\nquoi!<C:0003,0001,><C:0000,0004,>Non, artık inkâr edilemez!\nLuigi tam bir... rüya delikanlısı!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Bir de şu bıyık! İçinde öyle\nbir...\nhava var ki! Tam bir... je ne sais\nquoi!<C:0003,0001,><C:0000,0004,>Non, artık inkâr edilemez!\nLuigi tam bir... rüya delikanlısı!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Bir de şu bıyık! İçinde öyle\nbir...\nhava var ki! Tam bir... je ne sais\nquoi!<C:0003,0001,><C:0000,0004,>Non, artık inkâr edilemez!\nLuigi tam bir... rüya delikanlısı!<C:0003,0001,>",
