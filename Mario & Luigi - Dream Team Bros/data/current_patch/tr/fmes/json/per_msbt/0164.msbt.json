    },
    "14": {
      "text": "<C:0001,0004,>Fark ettiniz mi, bu Luigi biraz... şey...\ngerçek dünyadakinden farklı.<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Fark ettiniz mi, bu Luigi biraz... şey...\ngerçek dünyadakinden farklı.<C:0003,0001,>",
