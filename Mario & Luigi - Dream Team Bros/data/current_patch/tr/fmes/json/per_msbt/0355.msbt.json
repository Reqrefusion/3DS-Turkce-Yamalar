    "4": {
      "text": "<C:0001,0004,>Etrafa saçtığım o tatlı\nganimetlerin hepsini topladınız mı?<C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0001,0004,>Etrafa saçtığım o tatlı\nganimetlerin hepsini topladınız mı?<C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0001,0004,>Etrafa saçtığım o tatlı\nganimetlerin hepsini topladınız mı?<C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0001,0004,>Etrafa saçtığım o tatlı\nganimetlerin hepsini topladınız mı?<C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": ""
    },
    "5": {
      "text": "<C:0001,0004,>Dur bakalım. Yani ben\nhem ganimet hem canavar mı saçmışım?!<C:0003,0001,>",
