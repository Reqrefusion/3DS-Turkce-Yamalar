    "7": {
      "text": "<C:0001,0004,>Bak, eğer burada gerçekten canavar varsa onları\nburaya kötü... bir şey çekmiş olmalı!<C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0001,0004,>Bak, eğer burada gerçekten canavar varsa onları\nburaya kötü... bir şey çekmiş olmalı!<C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0001,0004,>Bak, eğer burada gerçekten canavar varsa onları\nburaya kötü... bir şey çekmiş olmalı!<C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0001,0004,>Bak, eğer burada gerçekten canavar varsa onları\nburaya kötü... bir şey çekmiş olmalı!<C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": ""
    },
