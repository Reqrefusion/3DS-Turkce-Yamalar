      "tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Vi serviranno molte pietre sonnambule\nper avere accesso al tempio.<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,6400><C:0001,0004,>Vi serviranno molte pietre sonnambule\nper avere accesso al tempio.<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Vi serviranno molte pietre sonnambule\nper avere accesso al tempio.<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "raw_full_hex": ""
    },
    "18": {
      "text": "<C:0000,0002,6400><C:0001,0004,>Ci sono altri Arciguanciali\npietrificati lungo la strada...<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Ci sono altri Arciguanciali\npietrificati lungo la strada...<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,6400><C:0001,0004,>Ci sono altri Arciguanciali\npietrificati lungo la strada...<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Ci sono altri Arciguanciali\npietrificati lungo la strada...<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "raw_full_hex": ""
    },
    "19": {
      "text": "<C:0000,0002,6400><C:0001,0004,>Aiutateli tutti e vi ricompenseranno\ncon delle pietre sonnambule.<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Vi servirà l'aiuto di molti Arciguanciali\nper raggiungere il tempio.<C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Aiutateli tutti e vi ricompenseranno\ncon delle pietre sonnambule.<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Vi servirà l'aiuto di molti Arciguanciali\nper raggiungere il tempio.<C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,6400><C:0001,0004,>Aiutateli tutti e vi ricompenseranno\ncon delle pietre sonnambule.<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Vi servirà l'aiuto di molti Arciguanciali\nper raggiungere il tempio.<C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Aiutateli tutti e vi ricompenseranno\ncon delle pietre sonnambule.<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Vi servirà l'aiuto di molti Arciguanciali\nper raggiungere il tempio.<C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "raw_full_hex": ""
    },
    "20": {
      "text": "<C:0000,0002,6400><C:0001,0004,>Vi auguro di riuscire\nnell'impresa.<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Vi auguro di riuscire\nnell'impresa.<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,6400><C:0001,0004,>Vi auguro di riuscire\nnell'impresa.<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Vi auguro di riuscire\nnell'impresa.<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "raw_full_hex": "0E0000000200020064000E00010004000000560069002000610075006700750072006F002000640069002000720069007500730063006900720065000A006E0065006C006C00270069006D00700072006500730061002E000E0000000200020064000E000300010000000E0000000200020064000E0000000200020064000000"
    },
    "21": {
      "text": "<C:0000,0002,6400><C:0001,0004,>Inkubak sta per\nessere annientato!<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Tenete duro fino alla fine e\nnon abbassate la guardia!<C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Inkubak sta per\nessere annientato!<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Tenete duro fino alla fine e\nnon abbassate la guardia!<C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,6400><C:0001,0004,>Inkubak sta per\nessere annientato!<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Tenete duro fino alla fine e\nnon abbassate la guardia!<C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Inkubak sta per\nessere annientato!<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Tenete duro fino alla fine e\nnon abbassate la guardia!<C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "raw_full_hex": ""
    },
    "22": {
      "text": "<C:0001,0004,><C:0000,0003,2C65FFFF><C:0007,0000,><C:0000,0003,FFFFFFFF>Hai ottenuto una <C:0000,0003,00EAFFFF>pietra sonnambula<C:0000,0003,FFFFFFFF>!<C:0003,0000,1E00><C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,><C:0000,0003,2C65FFFF><C:0007,0000,><C:0000,0003,FFFFFFFF>Hai ottenuto una <C:0000,0003,00EAFFFF>pietra sonnambula<C:0000,0003,FFFFFFFF>!<C:0003,0000,1E00><C:0003,0001,>",
      "original_text": "<C:0001,0004,><C:0000,0003,2C65FFFF><C:0007,0000,><C:0000,0003,FFFFFFFF>Hai ottenuto una <C:0000,0003,00EAFFFF>pietra sonnambula<C:0000,0003,FFFFFFFF>!<C:0003,0000,1E00><C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,><C:0000,0003,2C65FFFF><C:0007,0000,><C:0000,0003,FFFFFFFF>Hai ottenuto una <C:0000,0003,00EAFFFF>pietra sonnambula<C:0000,0003,FFFFFFFF>!<C:0003,0000,1E00><C:0003,0001,>",
      "raw_full_hex": ""
    },
    "23": {
      "text": "Posiziona le pietre...<C:0003,0001,><C:0000,0004,>... per creare una via.<C:0003,0001,>",
      "tokenized_text": "Posiziona le pietre...<C:0003,0001,><C:0000,0004,>... per creare una via.<C:0003,0001,>",
      "original_text": "Posiziona le pietre...<C:0003,0001,><C:0000,0004,>... per creare una via.<C:0003,0001,>",
      "original_tokenized_text": "Posiziona le pietre...<C:0003,0001,><C:0000,0004,>... per creare una via.<C:0003,0001,>",
      "raw_full_hex": "50006F00730069007A0069006F006E00610020006C00650020007000690065007400720065002E002E002E000E000300010000000E000000040000002E002E002E0020007000650072002000630072006500610072006500200075006E00610020007600690061002E000E000300010000000000"
    },
    "24": {
      "text": "Seleziona una pietra\nnelle vicinanze...<C:0003,0001,>",
