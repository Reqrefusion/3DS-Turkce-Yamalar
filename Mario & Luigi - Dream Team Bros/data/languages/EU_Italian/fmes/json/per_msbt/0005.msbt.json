    "6": {
      "text": "<C:0000,0003,FFFFFFFF><C:0007,0000,><C:0001,0001,><C:0001,0004,>1) Come cambiare l'altezza<C:0003,0001,><C:0000,0004,><C:0001,0000,><C:0007,0000,>Martellare uno dei due fungopistoni\nper <C:0000,0003,00EAFFFF>aumentare l'altezza dell'altro<C:0000,0003,FFFFFFFF>.<C:0003,0001,><C:0000,0004,><C:0007,0000,>Così si aziona il meccanismo!<C:0003,0001,><C:0000,0003,FFFFFFFF>",
      "tokenized_text": "<C:0000,0003,FFFFFFFF><C:0007,0000,><C:0001,0001,><C:0001,0004,>1) Come cambiare l'altezza<C:0003,0001,><C:0000,0004,><C:0001,0000,><C:0007,0000,>Martellare uno dei due fungopistoni\nper <C:0000,0003,00EAFFFF>aumentare l'altezza dell'altro<C:0000,0003,FFFFFFFF>.<C:0003,0001,><C:0000,0004,><C:0007,0000,>Così si aziona il meccanismo!<C:0003,0001,><C:0000,0003,FFFFFFFF>",
      "original_text": "<C:0000,0003,FFFFFFFF><C:0007,0000,><C:0001,0001,><C:0001,0004,>1) Come cambiare l'altezza<C:0003,0001,><C:0000,0004,><C:0001,0000,><C:0007,0000,>Martellare uno dei due fungopistoni\nper <C:0000,0003,00EAFFFF>aumentare l'altezza dell'altro<C:0000,0003,FFFFFFFF>.<C:0003,0001,><C:0000,0004,><C:0007,0000,>Così si aziona il meccanismo!<C:0003,0001,><C:0000,0003,FFFFFFFF>",
      "original_tokenized_text": "<C:0000,0003,FFFFFFFF><C:0007,0000,><C:0001,0001,><C:0001,0004,>1) Come cambiare l'altezza<C:0003,0001,><C:0000,0004,><C:0001,0000,><C:0007,0000,>Martellare uno dei due fungopistoni\nper <C:0000,0003,00EAFFFF>aumentare l'altezza dell'altro<C:0000,0003,FFFFFFFF>.<C:0003,0001,><C:0000,0004,><C:0007,0000,>Così si aziona il meccanismo!<C:0003,0001,><C:0000,0003,FFFFFFFF>",
      "raw_full_hex": ""
    },
    "7": {
      "text": "<C:0000,0003,FFFFFFFF><C:0007,0000,><C:0001,0001,><C:0001,0004,>2) Come ricominciare<C:0003,0001,><C:0000,0004,><C:0000,0003,FFFFFFFF><C:0000,0003,000000FF><C:0000,0003,FFFFFFFF><C:0001,0000,><C:0000,0003,000000FF><C:0000,0003,2C65FFFF><C:0000,0003,FFFFFFFF><C:0007,0000,>I fungopistoni tornano all'altezza\niniziale quando si <C:0000,0003,2C65FFFF><C:0000,0003,000000FF><C:0000,0003,00EAFFFF>tocca terra<C:0000,0003,000000FF><C:0000,0003,FFFFFFFF>.<C:0000,0003,000000FF><C:0000,0003,2C65FFFF><C:0000,0003,000000FF><C:0000,0003,FFFFFFFF><C:0000,0003,FFFFFFFF><C:0003,0001,><C:0000,0004,><C:0007,0000,>Per cambiare l'altezza, è sufficiente\ntoccare il terreno e attendere!<C:0003,0001,><C:0000,0003,FFFFFFFF>",
