    "27": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,><C:0007,0000,><C:0001,0001,><C:0000,0003,FFFFFFFF>Hai ottenuto un <C:0000,0003,00EAFFFF>Uovo onirico<C:0000,0003,FFFFFFFF>! <C:0000,0003,000000FF><C:0003,0000,1E00><C:0003,0001,><C:0000,0003,FFFFFFFF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,><C:0007,0000,><C:0001,0001,><C:0000,0003,FFFFFFFF>Hai ottenuto un <C:0000,0003,00EAFFFF>Uovo onirico<C:0000,0003,FFFFFFFF>! <C:0000,0003,000000FF><C:0003,0000,1E00><C:0003,0001,><C:0000,0003,FFFFFFFF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,><C:0007,0000,><C:0001,0001,><C:0000,0003,FFFFFFFF>Hai ottenuto un <C:0000,0003,00EAFFFF>Uovo onirico<C:0000,0003,FFFFFFFF>! <C:0000,0003,000000FF><C:0003,0000,1E00><C:0003,0001,><C:0000,0003,FFFFFFFF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,><C:0007,0000,><C:0001,0001,><C:0000,0003,FFFFFFFF>Hai ottenuto un <C:0000,0003,00EAFFFF>Uovo onirico<C:0000,0003,FFFFFFFF>! <C:0000,0003,000000FF><C:0003,0000,1E00><C:0003,0001,><C:0000,0003,FFFFFFFF>",
      "raw_full_hex": ""
    },
    "28": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Ora abbiamo tutte e tre le <C:0000,0003,2C65FFFF>Uova\noniriche<C:0000,0003,000000FF>!<C:0003,0001,><C:0000,0004,>Torniamo nel Mondo onirico dove\nci sta aspettando Peach!<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Ora abbiamo tutte e tre le <C:0000,0003,2C65FFFF>Uova\noniriche<C:0000,0003,000000FF>!<C:0003,0001,><C:0000,0004,>Torniamo nel Mondo onirico dove\nci sta aspettando Peach!<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Ora abbiamo tutte e tre le <C:0000,0003,2C65FFFF>Uova\noniriche<C:0000,0003,000000FF>!<C:0003,0001,><C:0000,0004,>Torniamo nel Mondo onirico dove\nci sta aspettando Peach!<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Ora abbiamo tutte e tre le <C:0000,0003,2C65FFFF>Uova\noniriche<C:0000,0003,000000FF>!<C:0003,0001,><C:0000,0004,>Torniamo nel Mondo onirico dove\nci sta aspettando Peach!<C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": ""
    },
