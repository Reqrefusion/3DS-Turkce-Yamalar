    "9": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Als dat zo is,<C:0000,0003,000000FF><C:0003,0000,0A00><C:0000,0003,000000FF> moeten we uitvinden\nhoe we hem kunnen laten uitbarsten<C:0000,0003,000000FF>.<C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Als dat zo is,<C:0000,0003,000000FF><C:0003,0000,0A00><C:0000,0003,000000FF> moeten we uitvinden\nhoe we hem kunnen laten uitbarsten<C:0000,0003,000000FF>.<C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Als dat zo is,<C:0000,0003,000000FF><C:0003,0000,0A00><C:0000,0003,000000FF> moeten we uitvinden\nhoe we hem kunnen laten uitbarsten<C:0000,0003,000000FF>.<C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Als dat zo is,<C:0000,0003,000000FF><C:0003,0000,0A00><C:0000,0003,000000FF> moeten we uitvinden\nhoe we hem kunnen laten uitbarsten<C:0000,0003,000000FF>.<C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
