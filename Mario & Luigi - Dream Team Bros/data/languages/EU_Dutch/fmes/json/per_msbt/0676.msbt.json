      "raw_full_hex": "550069007400650072006100610072006400210020004C006100610074000A006D006100610072002000610061006E0020006D0069006A0020006F0076006500720021000E000300010000000000"
    },
    "25": {
      "text": "Bam! Moet je kijken!\nEEN DROOMMUNT!<C:0003,0001,>",
      "tokenized_text": "Bam! Moet je kijken!\nEEN DROOMMUNT!<C:0003,0001,>",
