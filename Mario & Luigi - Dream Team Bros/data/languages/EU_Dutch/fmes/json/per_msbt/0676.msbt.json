    "12": {
      "text": "En meneer Mario!\nEn meneer Luigi!<C:0003,0001,><C:0000,0004,>Jullie zijn in orde! En jullie\nhebben ons gered!<C:0003,0001,>",
      "tokenized_text": "En meneer Mario!\nEn meneer Luigi!<C:0003,0001,><C:0000,0004,>Jullie zijn in orde! En jullie\nhebben ons gered!<C:0003,0001,>",
      "original_text": "En meneer Mario!\nEn meneer Luigi!<C:0003,0001,><C:0000,0004,>Jullie zijn in orde! En jullie\nhebben ons gered!<C:0003,0001,>",
      "original_tokenized_text": "En meneer Mario!\nEn meneer Luigi!<C:0003,0001,><C:0000,0004,>Jullie zijn in orde! En jullie\nhebben ons gered!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "13": {
      "text": "'et gruwelkasteel van Antasma\nen Bowser ies verdwenen!<C:0003,0001,><C:0000,0004,>En alles ies weer très\nbon! Merci beaucoup!<C:0003,0001,>",
      "tokenized_text": "'et gruwelkasteel van Antasma\nen Bowser ies verdwenen!<C:0003,0001,><C:0000,0004,>En alles ies weer très\nbon! Merci beaucoup!<C:0003,0001,>",
