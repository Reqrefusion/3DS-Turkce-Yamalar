    },
    "26": {
      "text": "En gelijk nog een wijze raad: hecht niet\nzo veel waarde aan de droomsteen!<C:0003,0001,>",
      "tokenized_text": "En gelijk nog een wijze raad: hecht niet\nzo veel waarde aan de droomsteen!<C:0003,0001,>",
