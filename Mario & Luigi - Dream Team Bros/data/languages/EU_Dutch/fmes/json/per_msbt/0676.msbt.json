    },
    "18": {
      "text": "Ik heb de hulp ingeroepen\nvan alle eilandbewoners...<C:0003,0001,><C:0000,0004,>...en we hebben alle stukjes verzameld\ndie van Bowser af zijn gekomen!<C:0003,0001,>",
      "tokenized_text": "Ik heb de hulp ingeroepen\nvan alle eilandbewoners...<C:0003,0001,><C:0000,0004,>...en we hebben alle stukjes verzameld\ndie van Bowser af zijn gekomen!<C:0003,0001,>",
      "original_text": "Ik heb de hulp ingeroepen\nvan alle eilandbewoners...<C:0003,0001,><C:0000,0004,>...en we hebben alle stukjes verzameld\ndie van Bowser af zijn gekomen!<C:0003,0001,>",
      "original_tokenized_text": "Ik heb de hulp ingeroepen\nvan alle eilandbewoners...<C:0003,0001,><C:0000,0004,>...en we hebben alle stukjes verzameld\ndie van Bowser af zijn gekomen!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "19": {
      "text": "O!<C:0003,0000,0A00> Gossie...\nHet spijt me...<C:0003,0001,>",
      "tokenized_text": "O!<C:0003,0000,0A00> Gossie...\nHet spijt me...<C:0003,0001,>",
      "original_text": "O!<C:0003,0000,0A00> Gossie...\nHet spijt me...<C:0003,0001,>",
      "original_tokenized_text": "O!<C:0003,0000,0A00> Gossie...\nHet spijt me...<C:0003,0001,>",
