      "raw_full_hex": "0E000100010000000E00010004000000470065006C0075006B006B006900670021000E000300010000000000"
    },
    "2": {
      "text": "Dat ik jullie op het laatste nippertje\nheb gevangen was cool, hè?<C:0003,0001,><C:0000,0004,>Superhelden en supergoden zoals ik\nwachten altijd tot het laatste moment.<C:0003,0001,>",
      "tokenized_text": "Dat ik jullie op het laatste nippertje\nheb gevangen was cool, hè?<C:0003,0001,><C:0000,0004,>Superhelden en supergoden zoals ik\nwachten altijd tot het laatste moment.<C:0003,0001,>",
      "original_text": "Dat ik jullie op het laatste nippertje\nheb gevangen was cool, hè?<C:0003,0001,><C:0000,0004,>Superhelden en supergoden zoals ik\nwachten altijd tot het laatste moment.<C:0003,0001,>",
      "original_tokenized_text": "Dat ik jullie op het laatste nippertje\nheb gevangen was cool, hè?<C:0003,0001,><C:0000,0004,>Superhelden en supergoden zoals ik\nwachten altijd tot het laatste moment.<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "3": {
      "text": "Normaal gesproken zou zoiets\njullie extra munten kosten...<C:0003,0001,><C:0000,0004,>Maar ik ben in een goede bui,\ndus deze keer is het gratis.<C:0003,0001,>",
      "tokenized_text": "Normaal gesproken zou zoiets\njullie extra munten kosten...<C:0003,0001,><C:0000,0004,>Maar ik ben in een goede bui,\ndus deze keer is het gratis.<C:0003,0001,>",
      "original_text": "Normaal gesproken zou zoiets\njullie extra munten kosten...<C:0003,0001,><C:0000,0004,>Maar ik ben in een goede bui,\ndus deze keer is het gratis.<C:0003,0001,>",
