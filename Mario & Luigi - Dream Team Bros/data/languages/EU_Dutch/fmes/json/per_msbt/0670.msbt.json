    "4": {
      "text": "En wanneer de Snurkvogel\nboos is, is hij woedend!<C:0003,0001,><C:0000,0004,>Ik kom pas tot rust als ik\ndie barrière heb vernietigd!<C:0003,0001,>",
      "tokenized_text": "En wanneer de Snurkvogel\nboos is, is hij woedend!<C:0003,0001,><C:0000,0004,>Ik kom pas tot rust als ik\ndie barrière heb vernietigd!<C:0003,0001,>",
      "original_text": "En wanneer de Snurkvogel\nboos is, is hij woedend!<C:0003,0001,><C:0000,0004,>Ik kom pas tot rust als ik\ndie barrière heb vernietigd!<C:0003,0001,>",
      "original_tokenized_text": "En wanneer de Snurkvogel\nboos is, is hij woedend!<C:0003,0001,><C:0000,0004,>Ik kom pas tot rust als ik\ndie barrière heb vernietigd!<C:0003,0001,>",
      "raw_full_hex": ""
