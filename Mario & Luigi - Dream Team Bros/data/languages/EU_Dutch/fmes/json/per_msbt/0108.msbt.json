    "10": {
      "text": "Is spierbalactie.\nHeet <C:0000,0003,2C65FFFF>draaisprong<C:0000,0003,000000FF>!<C:0003,0001,><C:0000,0004,>Zonder actie, uitgelachen\ndoor berg!<C:0003,0001,>",
      "tokenized_text": "Is spierbalactie.\nHeet <C:0000,0003,2C65FFFF>draaisprong<C:0000,0003,000000FF>!<C:0003,0001,><C:0000,0004,>Zonder actie, uitgelachen\ndoor berg!<C:0003,0001,>",
      "original_text": "Is spierbalactie.\nHeet <C:0000,0003,2C65FFFF>draaisprong<C:0000,0003,000000FF>!<C:0003,0001,><C:0000,0004,>Zonder actie, uitgelachen\ndoor berg!<C:0003,0001,>",
      "original_tokenized_text": "Is spierbalactie.\nHeet <C:0000,0003,2C65FFFF>draaisprong<C:0000,0003,000000FF>!<C:0003,0001,><C:0000,0004,>Zonder actie, uitgelachen\ndoor berg!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "11": {
      "text": "Kleine worstjes moet\ndraaisprong lukken...<C:0003,0001,><C:0000,0004,>...anders huilie-huilietijd!\nToer meteen voorbij!<C:0003,0001,>",
      "tokenized_text": "Kleine worstjes moet\ndraaisprong lukken...<C:0003,0001,><C:0000,0004,>...anders huilie-huilietijd!\nToer meteen voorbij!<C:0003,0001,>",
      "original_text": "Kleine worstjes moet\ndraaisprong lukken...<C:0003,0001,><C:0000,0004,>...anders huilie-huilietijd!\nToer meteen voorbij!<C:0003,0001,>",
      "original_tokenized_text": "Kleine worstjes moet\ndraaisprong lukken...<C:0003,0001,><C:0000,0004,>...anders huilie-huilietijd!\nToer meteen voorbij!<C:0003,0001,>",
      "raw_full_hex": ""
    },
