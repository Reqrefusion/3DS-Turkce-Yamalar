    },
    "12": {
      "text": "Ik zal je vertellen hoe: dit kasteel...\nPeach... de droomsteen...<C:0003,0001,><C:0000,0004,>ALLEMAAL VAN MIJ, hoor je?\nAllemaal van Bowser!<C:0003,0001,>",
      "tokenized_text": "Ik zal je vertellen hoe: dit kasteel...\nPeach... de droomsteen...<C:0003,0001,><C:0000,0004,>ALLEMAAL VAN MIJ, hoor je?\nAllemaal van Bowser!<C:0003,0001,>",
      "original_text": "Ik zal je vertellen hoe: dit kasteel...\nPeach... de droomsteen...<C:0003,0001,><C:0000,0004,>ALLEMAAL VAN MIJ, hoor je?\nAllemaal van Bowser!<C:0003,0001,>",
      "original_tokenized_text": "Ik zal je vertellen hoe: dit kasteel...\nPeach... de droomsteen...<C:0003,0001,><C:0000,0004,>ALLEMAAL VAN MIJ, hoor je?\nAllemaal van Bowser!<C:0003,0001,>",
      "raw_full_hex": ""
    },
