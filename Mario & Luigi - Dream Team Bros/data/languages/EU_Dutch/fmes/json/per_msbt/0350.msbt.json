    "10": {
      "text": "Jij dacht dat je mij aan het\ngebruiken was? MIJ?!<C:0003,0001,><C:0000,0004,>Ik heb JOU bespeeld\nals een vleermuisviool!<C:0003,0001,>",
      "tokenized_text": "Jij dacht dat je mij aan het\ngebruiken was? MIJ?!<C:0003,0001,><C:0000,0004,>Ik heb JOU bespeeld\nals een vleermuisviool!<C:0003,0001,>",
      "original_text": "Jij dacht dat je mij aan het\ngebruiken was? MIJ?!<C:0003,0001,><C:0000,0004,>Ik heb JOU bespeeld\nals een vleermuisviool!<C:0003,0001,>",
      "original_tokenized_text": "Jij dacht dat je mij aan het\ngebruiken was? MIJ?!<C:0003,0001,><C:0000,0004,>Ik heb JOU bespeeld\nals een vleermuisviool!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "11": {
      "text": "Wie, wat... Nein!\nHoe durf je?!<C:0003,0001,>",
