    "6": {
      "text": "<C:0000,0003,FFFFFFFF><C:0007,0000,><C:0001,0001,><C:0001,0004,>1) Hoogte instellen.<C:0003,0001,><C:0000,0004,><C:0001,0000,><C:0007,0000,>Sla met je hamer op de ene\nkant om <C:0000,0003,00EAFFFF>de andere kant\nomhoog te laten gaan<C:0000,0003,FFFFFFFF>.<C:0003,0001,><C:0000,0004,><C:0007,0000,>En in een wip heb je... een wip!<C:0003,0001,><C:0000,0003,FFFFFFFF>",
      "tokenized_text": "<C:0000,0003,FFFFFFFF><C:0007,0000,><C:0001,0001,><C:0001,0004,>1) Hoogte instellen.<C:0003,0001,><C:0000,0004,><C:0001,0000,><C:0007,0000,>Sla met je hamer op de ene\nkant om <C:0000,0003,00EAFFFF>de andere kant\nomhoog te laten gaan<C:0000,0003,FFFFFFFF>.<C:0003,0001,><C:0000,0004,><C:0007,0000,>En in een wip heb je... een wip!<C:0003,0001,><C:0000,0003,FFFFFFFF>",
      "original_text": "<C:0000,0003,FFFFFFFF><C:0007,0000,><C:0001,0001,><C:0001,0004,>1) Hoogte instellen.<C:0003,0001,><C:0000,0004,><C:0001,0000,><C:0007,0000,>Sla met je hamer op de ene\nkant om <C:0000,0003,00EAFFFF>de andere kant\nomhoog te laten gaan<C:0000,0003,FFFFFFFF>.<C:0003,0001,><C:0000,0004,><C:0007,0000,>En in een wip heb je... een wip!<C:0003,0001,><C:0000,0003,FFFFFFFF>",
      "original_tokenized_text": "<C:0000,0003,FFFFFFFF><C:0007,0000,><C:0001,0001,><C:0001,0004,>1) Hoogte instellen.<C:0003,0001,><C:0000,0004,><C:0001,0000,><C:0007,0000,>Sla met je hamer op de ene\nkant om <C:0000,0003,00EAFFFF>de andere kant\nomhoog te laten gaan<C:0000,0003,FFFFFFFF>.<C:0003,0001,><C:0000,0004,><C:0007,0000,>En in een wip heb je... een wip!<C:0003,0001,><C:0000,0003,FFFFFFFF>",
