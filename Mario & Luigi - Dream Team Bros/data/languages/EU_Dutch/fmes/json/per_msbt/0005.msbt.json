    "7": {
      "text": "<C:0000,0003,FFFFFFFF><C:0007,0000,><C:0001,0001,><C:0001,0004,>2) Opnieuw beginnen.<C:0003,0001,><C:0000,0004,><C:0000,0003,FFFFFFFF><C:0000,0003,000000FF><C:0000,0003,FFFFFFFF><C:0001,0000,><C:0000,0003,000000FF><C:0000,0003,2C65FFFF><C:0000,0003,FFFFFFFF><C:0007,0000,>Beide kanten komen weer\nop gelijke hoogte zodra\nje <C:0000,0003,2C65FFFF><C:0000,0003,000000FF><C:0000,0003,00EAFFFF>de grond raakt<C:0000,0003,000000FF><C:0000,0003,FFFFFFFF>.<C:0000,0003,000000FF><C:0000,0003,2C65FFFF><C:0000,0003,000000FF><C:0000,0003,FFFFFFFF><C:0000,0003,FFFFFFFF><C:0003,0001,><C:0000,0004,><C:0007,0000,>Dus als je niet tevreden bent\nen opnieuw wilt beginnen, spring\ndan even op de grond en wacht!<C:0003,0001,><C:0000,0003,FFFFFFFF>",
      "tokenized_text": "<C:0000,0003,FFFFFFFF><C:0007,0000,><C:0001,0001,><C:0001,0004,>2) Opnieuw beginnen.<C:0003,0001,><C:0000,0004,><C:0000,0003,FFFFFFFF><C:0000,0003,000000FF><C:0000,0003,FFFFFFFF><C:0001,0000,><C:0000,0003,000000FF><C:0000,0003,2C65FFFF><C:0000,0003,FFFFFFFF><C:0007,0000,>Beide kanten komen weer\nop gelijke hoogte zodra\nje <C:0000,0003,2C65FFFF><C:0000,0003,000000FF><C:0000,0003,00EAFFFF>de grond raakt<C:0000,0003,000000FF><C:0000,0003,FFFFFFFF>.<C:0000,0003,000000FF><C:0000,0003,2C65FFFF><C:0000,0003,000000FF><C:0000,0003,FFFFFFFF><C:0000,0003,FFFFFFFF><C:0003,0001,><C:0000,0004,><C:0007,0000,>Dus als je niet tevreden bent\nen opnieuw wilt beginnen, spring\ndan even op de grond en wacht!<C:0003,0001,><C:0000,0003,FFFFFFFF>",
