    },
    "3": {
      "text": "Wat is dit voor\nenorm gebouw?<C:0003,0001,><C:0000,0004,>Waarom sta ik hier?<C:0003,0001,>",
      "tokenized_text": "Wat is dit voor\nenorm gebouw?<C:0003,0001,><C:0000,0004,>Waarom sta ik hier?<C:0003,0001,>",
      "original_text": "Wat is dit voor\nenorm gebouw?<C:0003,0001,><C:0000,0004,>Waarom sta ik hier?<C:0003,0001,>",
      "original_tokenized_text": "Wat is dit voor\nenorm gebouw?<C:0003,0001,><C:0000,0004,>Waarom sta ik hier?<C:0003,0001,>",
      "raw_full_hex": "5700610074002000690073002000640069007400200076006F006F0072000A0065006E006F0072006D0020006700650062006F00750077003F000E000300010000000E0000000400000057006100610072006F006D002000730074006100200069006B00200068006900650072003F000E000300010000000000"
    },
    "4": {
      "text": "Wie bouwt er nou\nzo'n lelijk kasteel?<C:0003,0000,0A00><C:0003,0001,>",
      "tokenized_text": "Wie bouwt er nou\nzo'n lelijk kasteel?<C:0003,0000,0A00><C:0003,0001,>",
      "original_text": "Wie bouwt er nou\nzo'n lelijk kasteel?<C:0003,0000,0A00><C:0003,0001,>",
      "original_tokenized_text": "Wie bouwt er nou\nzo'n lelijk kasteel?<C:0003,0000,0A00><C:0003,0001,>",
      "raw_full_hex": "570069006500200062006F0075007700740020006500720020006E006F0075000A007A006F0027006E0020006C0065006C0069006A006B0020006B00610073007400650065006C003F000E000300000002000A000E000300010000000000"
    },
    "5": {
      "text": "Weten jullie wie dit kasteel\nheeft gebouwd?<C:0003,0001,><C:0000,0004,>Is er soms een festival voor\nlelijke kastelen aan de gang?<C:0003,0001,>",
      "tokenized_text": "Weten jullie wie dit kasteel\nheeft gebouwd?<C:0003,0001,><C:0000,0004,>Is er soms een festival voor\nlelijke kastelen aan de gang?<C:0003,0001,>",
      "original_text": "Weten jullie wie dit kasteel\nheeft gebouwd?<C:0003,0001,><C:0000,0004,>Is er soms een festival voor\nlelijke kastelen aan de gang?<C:0003,0001,>",
      "original_tokenized_text": "Weten jullie wie dit kasteel\nheeft gebouwd?<C:0003,0001,><C:0000,0004,>Is er soms een festival voor\nlelijke kastelen aan de gang?<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "6": {
      "text": "Alle Sluimers zijn gered!<C:0003,0001,><C:0000,0004,>We staan bij jullie in het\nkrijt, Mario en Luigi!<C:0003,0001,><C:0000,0004,>Laten we naar het <C:0000,0003,2C65FFFF>Dauwpark<C:0000,0003,000000FF> gaan\nom het <C:0000,0003,2C65FFFF>Eldream<C:0000,0003,000000FF> te vertellen!<C:0003,0001,>",
      "tokenized_text": "Alle Sluimers zijn gered!<C:0003,0001,><C:0000,0004,>We staan bij jullie in het\nkrijt, Mario en Luigi!<C:0003,0001,><C:0000,0004,>Laten we naar het <C:0000,0003,2C65FFFF>Dauwpark<C:0000,0003,000000FF> gaan\nom het <C:0000,0003,2C65FFFF>Eldream<C:0000,0003,000000FF> te vertellen!<C:0003,0001,>",
      "original_text": "Alle Sluimers zijn gered!<C:0003,0001,><C:0000,0004,>We staan bij jullie in het\nkrijt, Mario en Luigi!<C:0003,0001,><C:0000,0004,>Laten we naar het <C:0000,0003,2C65FFFF>Dauwpark<C:0000,0003,000000FF> gaan\nom het <C:0000,0003,2C65FFFF>Eldream<C:0000,0003,000000FF> te vertellen!<C:0003,0001,>",
      "original_tokenized_text": "Alle Sluimers zijn gered!<C:0003,0001,><C:0000,0004,>We staan bij jullie in het\nkrijt, Mario en Luigi!<C:0003,0001,><C:0000,0004,>Laten we naar het <C:0000,0003,2C65FFFF>Dauwpark<C:0000,0003,000000FF> gaan\nom het <C:0000,0003,2C65FFFF>Eldream<C:0000,0003,000000FF> te vertellen!<C:0003,0001,>",
      "raw_full_hex": ""
    },
