    },
    "9": {
      "text": "En met wanhopige klanten kun\nje MEGAWINSTEN boeken!<C:0003,0001,><C:0000,0004,>Dus kop op en laat het wanhopen\nmaar over aan je portemonnee!<C:0003,0001,>",
      "tokenized_text": "En met wanhopige klanten kun\nje MEGAWINSTEN boeken!<C:0003,0001,><C:0000,0004,>Dus kop op en laat het wanhopen\nmaar over aan je portemonnee!<C:0003,0001,>",
      "original_text": "En met wanhopige klanten kun\nje MEGAWINSTEN boeken!<C:0003,0001,><C:0000,0004,>Dus kop op en laat het wanhopen\nmaar over aan je portemonnee!<C:0003,0001,>",
      "original_tokenized_text": "En met wanhopige klanten kun\nje MEGAWINSTEN boeken!<C:0003,0001,><C:0000,0004,>Dus kop op en laat het wanhopen\nmaar over aan je portemonnee!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "10": {
      "text": "<C:0007,0000,>Hoe kan ik van dienst zijn?<C:0003,0000,0A00>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Ik zoek voorwerpen.\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Ik zoek uitrusting.<C:0000,0003,FFFFFFFF><C:0000,0003,000000FF>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Sluimerkoffie, alsjeblieft.<C:0001,0002,>      <C:0005,0001,>Laat maar.<C:0003,0000,0A00>",
      "tokenized_text": "<C:0007,0000,>Hoe kan ik van dienst zijn?<C:0003,0000,0A00>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Ik zoek voorwerpen.\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Ik zoek uitrusting.<C:0000,0003,FFFFFFFF><C:0000,0003,000000FF>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Sluimerkoffie, alsjeblieft.<C:0001,0002,>      <C:0005,0001,>Laat maar.<C:0003,0000,0A00>",
      "original_text": "<C:0007,0000,>Hoe kan ik van dienst zijn?<C:0003,0000,0A00>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Ik zoek voorwerpen.\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Ik zoek uitrusting.<C:0000,0003,FFFFFFFF><C:0000,0003,000000FF>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Sluimerkoffie, alsjeblieft.<C:0001,0002,>      <C:0005,0001,>Laat maar.<C:0003,0000,0A00>",
      "original_tokenized_text": "<C:0007,0000,>Hoe kan ik van dienst zijn?<C:0003,0000,0A00>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Ik zoek voorwerpen.\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Ik zoek uitrusting.<C:0000,0003,FFFFFFFF><C:0000,0003,000000FF>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Sluimerkoffie, alsjeblieft.<C:0001,0002,>      <C:0005,0001,>Laat maar.<C:0003,0000,0A00>",
      "raw_full_hex": ""
    },
    "11": {
