    "1": {
      "text": "<C:0007,0000,>Wat gebeurt er allemaal?<C:0003,0000,0A00>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Ik wil praten.\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Ik wil naar dromenland.\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Laat maar.<C:0003,0000,0A00>",
      "tokenized_text": "<C:0007,0000,>Wat gebeurt er allemaal?<C:0003,0000,0A00>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Ik wil praten.\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Ik wil naar dromenland.\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Laat maar.<C:0003,0000,0A00>",
      "original_text": "<C:0007,0000,>Wat gebeurt er allemaal?<C:0003,0000,0A00>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Ik wil praten.\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Ik wil naar dromenland.\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Laat maar.<C:0003,0000,0A00>",
      "original_tokenized_text": "<C:0007,0000,>Wat gebeurt er allemaal?<C:0003,0000,0A00>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Ik wil praten.\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Ik wil naar dromenland.\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Laat maar.<C:0003,0000,0A00>",
      "raw_full_hex": ""
    },
    "2": {
      "text": "Waar...<C:0003,0000,0A00> waar ben ik?<C:0003,0001,>",
      "tokenized_text": "Waar...<C:0003,0000,0A00> waar ben ik?<C:0003,0001,>",
      "original_text": "Waar...<C:0003,0000,0A00> waar ben ik?<C:0003,0001,>",
