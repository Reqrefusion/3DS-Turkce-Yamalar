    },
    "47": {
      "text": "<C:0000,0002,4B00><C:0001,0004,>Als ik maar mijn best doe,\nkan ik zelfs jullie verslaan?<C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,4B00><C:0001,0004,>Als ik maar mijn best doe,\nkan ik zelfs jullie verslaan?<C:0003,0001,><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,4B00><C:0001,0004,>Als ik maar mijn best doe,\nkan ik zelfs jullie verslaan?<C:0003,0001,><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,4B00><C:0001,0004,>Als ik maar mijn best doe,\nkan ik zelfs jullie verslaan?<C:0003,0001,><C:0000,0002,6400>",
