    },
    "3": {
      "text": "<C:0001,0004,>Oké, even diep ademhalen...\n<C:0003,0000,2800>Zo. Hoe kunnen we hier vandaan komen?<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Oké, even diep ademhalen...\n<C:0003,0000,2800>Zo. Hoe kunnen we hier vandaan komen?<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Oké, even diep ademhalen...\n<C:0003,0000,2800>Zo. Hoe kunnen we hier vandaan komen?<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Oké, even diep ademhalen...\n<C:0003,0000,2800>Zo. Hoe kunnen we hier vandaan komen?<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "4": {
      "text": "<C:0001,0004,>Hmm... Zie je die <C:0000,0003,2C65FFFF>tornado<C:0000,0003,000000FF> daar?<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Hmm... Zie je die <C:0000,0003,2C65FFFF>tornado<C:0000,0003,000000FF> daar?<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Hmm... Zie je die <C:0000,0003,2C65FFFF>tornado<C:0000,0003,000000FF> daar?<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Hmm... Zie je die <C:0000,0003,2C65FFFF>tornado<C:0000,0003,000000FF> daar?<C:0003,0001,>",
      "raw_full_hex": "0E0001000400000048006D006D002E002E002E0020005A006900650020006A006500200064006900650020000E000000030004002C65FFFF74006F0072006E00610064006F000E00000003000400000000FF200064006100610072003F000E000300010000000000"
    },
    "5": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Het lijkt ook een soort luigillusie te zijn...<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Het lijkt ook een soort luigillusie te zijn...<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Het lijkt ook een soort luigillusie te zijn...<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Het lijkt ook een soort luigillusie te zijn...<C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": "0E00000003000400000000FF0E0001000400000048006500740020006C0069006A006B00740020006F006F006B002000650065006E00200073006F006F007200740020006C0075006900670069006C006C00750073006900650020007400650020007A0069006A006E002E002E002E000E000300010000000E00000003000400000000FF0000"
