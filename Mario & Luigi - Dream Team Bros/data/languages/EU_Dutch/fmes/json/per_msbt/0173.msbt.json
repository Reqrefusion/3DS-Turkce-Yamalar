    "7": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Weet je nog hoe je luigillusies bedient?<C:0000,0003,000000FF><C:0003,0001,>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Weet je nog hoe je luigillusies bedient?<C:0000,0003,000000FF><C:0003,0001,>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Weet je nog hoe je luigillusies bedient?<C:0000,0003,000000FF><C:0003,0001,>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Weet je nog hoe je luigillusies bedient?<C:0000,0003,000000FF><C:0003,0001,>",
      "raw_full_hex": "0E00000003000400000000FF0E00010004000000570065006500740020006A00650020006E006F006700200068006F00650020006A00650020006C0075006900670069006C006C00750073006900650073002000620065006400690065006E0074003F000E00000003000400000000FF0E000300010000000000"
    },
    "8": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Ik kan het nog een keer uitleggen, als je wilt.<C:0003,0000,0A00> \n<C:0001,0001,><C:0005,0001,>Nee, bedankt.<C:0000,0003,000000FF>        <C:0000,0003,000000FF><C:0005,0001,>Oké!<C:0000,0003,000000FF><C:0000,0003,000000FF><C:0003,0000,0A00><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Ik kan het nog een keer uitleggen, als je wilt.<C:0003,0000,0A00> \n<C:0001,0001,><C:0005,0001,>Nee, bedankt.<C:0000,0003,000000FF>        <C:0000,0003,000000FF><C:0005,0001,>Oké!<C:0000,0003,000000FF><C:0000,0003,000000FF><C:0003,0000,0A00><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Ik kan het nog een keer uitleggen, als je wilt.<C:0003,0000,0A00> \n<C:0001,0001,><C:0005,0001,>Nee, bedankt.<C:0000,0003,000000FF>        <C:0000,0003,000000FF><C:0005,0001,>Oké!<C:0000,0003,000000FF><C:0000,0003,000000FF><C:0003,0000,0A00><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Ik kan het nog een keer uitleggen, als je wilt.<C:0003,0000,0A00> \n<C:0001,0001,><C:0005,0001,>Nee, bedankt.<C:0000,0003,000000FF>        <C:0000,0003,000000FF><C:0005,0001,>Oké!<C:0000,0003,000000FF><C:0000,0003,000000FF><C:0003,0000,0A00><C:0000,0003,000000FF>",
      "raw_full_hex": ""
    },
    "9": {
      "text": "<C:0001,0004,>Haal diep adem, en laat de informatie\ndit keer goed tot je doordringen.<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Haal diep adem, en laat de informatie\ndit keer goed tot je doordringen.<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Haal diep adem, en laat de informatie\ndit keer goed tot je doordringen.<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Haal diep adem, en laat de informatie\ndit keer goed tot je doordringen.<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "10": {
      "text": "<C:0001,0004,>Druk allereerst op <C:0000,0002,4B00><C:0000,0003,2C65FFFF><C:0000,0003,000000FF><C:0000,0002,6400> om het\n<C:0000,0003,2C65FFFF>actiepictogram<C:0000,0003,000000FF> te wijzigen.",
      "tokenized_text": "<C:0001,0004,>Druk allereerst op <C:0000,0002,4B00><C:0000,0003,2C65FFFF><C:0000,0003,000000FF><C:0000,0002,6400> om het\n<C:0000,0003,2C65FFFF>actiepictogram<C:0000,0003,000000FF> te wijzigen.",
      "original_text": "<C:0001,0004,>Druk allereerst op <C:0000,0002,4B00><C:0000,0003,2C65FFFF><C:0000,0003,000000FF><C:0000,0002,6400> om het\n<C:0000,0003,2C65FFFF>actiepictogram<C:0000,0003,000000FF> te wijzigen.",
      "original_tokenized_text": "<C:0001,0004,>Druk allereerst op <C:0000,0002,4B00><C:0000,0003,2C65FFFF><C:0000,0003,000000FF><C:0000,0002,6400> om het\n<C:0000,0003,2C65FFFF>actiepictogram<C:0000,0003,000000FF> te wijzigen.",
      "raw_full_hex": ""
    },
    "11": {
      "text": "<C:0001,0004,>Druk daarna op <C:0000,0002,4B00><C:0000,0003,0EAD43FF><C:0000,0003,000000FF><C:0000,0002,6400> om één\nte worden met de tornado.",
      "tokenized_text": "<C:0001,0004,>Druk daarna op <C:0000,0002,4B00><C:0000,0003,0EAD43FF><C:0000,0003,000000FF><C:0000,0002,6400> om één\nte worden met de tornado.",
      "original_text": "<C:0001,0004,>Druk daarna op <C:0000,0002,4B00><C:0000,0003,0EAD43FF><C:0000,0003,000000FF><C:0000,0002,6400> om één\nte worden met de tornado.",
      "original_tokenized_text": "<C:0001,0004,>Druk daarna op <C:0000,0002,4B00><C:0000,0003,0EAD43FF><C:0000,0003,000000FF><C:0000,0002,6400> om één\nte worden met de tornado.",
      "raw_full_hex": ""
    },
    "12": {
      "text": "<C:0001,0004,>Nu heb je hulp nodig van iemand\nuit de wakkere wereld.<C:0003,0001,><C:0000,0004,>Ik zal de boodschap doorgeven\naan de andere kant van\nde droomgrens.<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Nu heb je hulp nodig van iemand\nuit de wakkere wereld.<C:0003,0001,><C:0000,0004,>Ik zal de boodschap doorgeven\naan de andere kant van\nde droomgrens.<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Nu heb je hulp nodig van iemand\nuit de wakkere wereld.<C:0003,0001,><C:0000,0004,>Ik zal de boodschap doorgeven\naan de andere kant van\nde droomgrens.<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Nu heb je hulp nodig van iemand\nuit de wakkere wereld.<C:0003,0001,><C:0000,0004,>Ik zal de boodschap doorgeven\naan de andere kant van\nde droomgrens.<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "13": {
      "text": "<C:0001,0004,>Ik ben zo terug...<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Ik ben zo terug...<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Ik ben zo terug...<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Ik ben zo terug...<C:0003,0001,>",
      "raw_full_hex": "0E0001000400000049006B002000620065006E0020007A006F002000740065007200750067002E002E002E000E000300010000000000"
    },
