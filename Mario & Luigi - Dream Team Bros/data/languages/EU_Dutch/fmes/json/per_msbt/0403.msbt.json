    },
    "6": {
      "text": "<C:0001,0004,>Jullie reizigers...<C:0003,0001,><C:0000,0004,>Jullie hebben alle\nSluimermeesters gered!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Jullie reizigers...<C:0003,0001,><C:0000,0004,>Jullie hebben alle\nSluimermeesters gered!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Jullie reizigers...<C:0003,0001,><C:0000,0004,>Jullie hebben alle\nSluimermeesters gered!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Jullie reizigers...<C:0003,0001,><C:0000,0004,>Jullie hebben alle\nSluimermeesters gered!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "7": {
      "text": "<C:0001,0004,>We zijn jullie dankbaar!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>We zijn jullie dankbaar!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>We zijn jullie dankbaar!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>We zijn jullie dankbaar!<C:0003,0001,>",
      "raw_full_hex": "0E000100040000005700650020007A0069006A006E0020006A0075006C006C00690065002000640061006E006B00620061006100720021000E000300010000000000"
    },
    "8": {
      "text": "<C:0001,0004,>Hier hebben jullie de laatste\nslaapwandelsteen.<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Hier hebben jullie de laatste\nslaapwandelsteen.<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Hier hebben jullie de laatste\nslaapwandelsteen.<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Hier hebben jullie de laatste\nslaapwandelsteen.<C:0003,0001,>",
      "raw_full_hex": "0E0001000400000048006900650072002000680065006200620065006E0020006A0075006C006C006900650020006400650020006C006100610074007300740065000A0073006C00610061007000770061006E00640065006C0073007400650065006E002E000E000300010000000000"
    },
    "9": {
      "text": "<C:0001,0004,>Nu hebben jullie de\nsleutel tot de tempel!<C:0003,0001,><C:0000,0004,>Ga er meteen heen.<C:0003,0001,><C:0000,0004,>Red deze mooie wereld\nvan het kwaad!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Nu hebben jullie de\nsleutel tot de tempel!<C:0003,0001,><C:0000,0004,>Ga er meteen heen.<C:0003,0001,><C:0000,0004,>Red deze mooie wereld\nvan het kwaad!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Nu hebben jullie de\nsleutel tot de tempel!<C:0003,0001,><C:0000,0004,>Ga er meteen heen.<C:0003,0001,><C:0000,0004,>Red deze mooie wereld\nvan het kwaad!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Nu hebben jullie de\nsleutel tot de tempel!<C:0003,0001,><C:0000,0004,>Ga er meteen heen.<C:0003,0001,><C:0000,0004,>Red deze mooie wereld\nvan het kwaad!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "10": {
      "text": "<C:0001,0004,><C:0000,0003,2C65FFFF><C:0007,0000,><C:0000,0003,FFFFFFFF>Je hebt een <C:0000,0003,00EAFFFF>slaapwandelsteen<C:0000,0003,FFFFFFFF> gekregen!<C:0003,0000,1E00><C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,><C:0000,0003,2C65FFFF><C:0007,0000,><C:0000,0003,FFFFFFFF>Je hebt een <C:0000,0003,00EAFFFF>slaapwandelsteen<C:0000,0003,FFFFFFFF> gekregen!<C:0003,0000,1E00><C:0003,0001,>",
      "original_text": "<C:0001,0004,><C:0000,0003,2C65FFFF><C:0007,0000,><C:0000,0003,FFFFFFFF>Je hebt een <C:0000,0003,00EAFFFF>slaapwandelsteen<C:0000,0003,FFFFFFFF> gekregen!<C:0003,0000,1E00><C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,><C:0000,0003,2C65FFFF><C:0007,0000,><C:0000,0003,FFFFFFFF>Je hebt een <C:0000,0003,00EAFFFF>slaapwandelsteen<C:0000,0003,FFFFFFFF> gekregen!<C:0003,0000,1E00><C:0003,0001,>",
