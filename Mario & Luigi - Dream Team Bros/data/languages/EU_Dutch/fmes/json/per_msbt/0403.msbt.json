    },
    "14": {
      "text": "<C:0000,0002,6400><C:0001,0004,>Nom, neusbaarden!<C:0003,0001,><C:0000,0004,>Grootspeelneusbaarden\nzijn terug!<C:0003,0001,><C:0000,0002,6400>",
