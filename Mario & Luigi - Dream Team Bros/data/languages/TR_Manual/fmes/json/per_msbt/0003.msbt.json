    "6": {
      "text": "<C:0007,0000,>Rüya dünyasına gidilsin mi?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Hayır         <C:0005,0001,>Evet<C:0003,0000,0A00>",
