    "4": {
      "text": "<C:0001,0004,><C:0001,0001,><C:0000,0002,9600>Antasma!<C:0003,0001,><C:0000,0002,6400><C:0000,0004,><C:0000,0002,6400><C:0001,0000,><C:0001,0003,>Beni taşa\nçevirdin!<C:0003,0001,><C:0000,0004,>Üstelik beni böyle\nun ufak, döküle saçılır yaptın!<C:0003,0001,><C:0000,0004,>O yüzden de şimdi\nfena öfkeliyim!<C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "<C:0001,0004,><C:0001,0001,><C:0000,0002,9600>Antasma!<C:0003,0001,><C:0000,0002,6400><C:0000,0004,><C:0000,0002,6400><C:0001,0000,><C:0001,0003,>Beni taşa\nçevirdin!<C:0003,0001,><C:0000,0004,>Üstelik beni böyle\nun ufak, döküle saçılır yaptın!<C:0003,0001,><C:0000,0004,>O yüzden de şimdi\nfena öfkeliyim!<C:0003,0001,><C:0000,0002,6400>",
      "original_text": "<C:0001,0004,><C:0001,0001,><C:0000,0002,9600>Antasma!<C:0003,0001,><C:0000,0002,6400><C:0000,0004,><C:0000,0002,6400><C:0001,0000,><C:0001,0003,>Beni taşa\nçevirdin!<C:0003,0001,><C:0000,0004,>Üstelik beni böyle\nun ufak, döküle saçılır yaptın!<C:0003,0001,><C:0000,0004,>O yüzden de şimdi\nfena öfkeliyim!<C:0003,0001,><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0001,0004,><C:0001,0001,><C:0000,0002,9600>Antasma!<C:0003,0001,><C:0000,0002,6400><C:0000,0004,><C:0000,0002,6400><C:0001,0000,><C:0001,0003,>Beni taşa\nçevirdin!<C:0003,0001,><C:0000,0004,>Üstelik beni böyle\nun ufak, döküle saçılır yaptın!<C:0003,0001,><C:0000,0004,>O yüzden de şimdi\nfena öfkeliyim!<C:0003,0001,><C:0000,0002,6400>",
      "raw_full_hex": ""
    },
    "5": {
      "text": "Gördünüz mü?\nŞu ürkütücü şatoyu?<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Eminim bunun arkasında\nAntasma var!<C:0003,0001,><C:0000,0002,6400><C:0000,0004,>Dünyadaki bütün kötülüklerin\nkaynağı o!<C:0000,0002,6400><C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "Gördünüz mü?\nŞu ürkütücü şatoyu?<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Eminim bunun arkasında\nAntasma var!<C:0003,0001,><C:0000,0002,6400><C:0000,0004,>Dünyadaki bütün kötülüklerin\nkaynağı o!<C:0000,0002,6400><C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400>",
      "original_text": "Gördünüz mü?\nŞu ürkütücü şatoyu?<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Eminim bunun arkasında\nAntasma var!<C:0003,0001,><C:0000,0002,6400><C:0000,0004,>Dünyadaki bütün kötülüklerin\nkaynağı o!<C:0000,0002,6400><C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400>",
