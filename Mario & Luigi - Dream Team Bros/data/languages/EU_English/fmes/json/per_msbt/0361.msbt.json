    "19": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>I do hope it will be possible for\nme to hide deeper in the dream...<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>I do hope it will be possible for\nme to hide deeper in the dream...<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>I do hope it will be possible for\nme to hide deeper in the dream...<C:0003,0001,><C:0000,0003,000000FF>",
