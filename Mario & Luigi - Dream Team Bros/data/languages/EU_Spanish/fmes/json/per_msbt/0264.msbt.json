    "1": {
      "text": "Este camino lleva hasta\nla ciudad de vacaciones...<C:0003,0001,><C:0000,0004,>Aunque creo que aún no está abierto.\nAcaban de mandar de vuelta a un tío\nque quería pasar.<C:0003,0001,>",
      "tokenized_text": "Este camino lleva hasta\nla ciudad de vacaciones...<C:0003,0001,><C:0000,0004,>Aunque creo que aún no está abierto.\nAcaban de mandar de vuelta a un tío\nque quería pasar.<C:0003,0001,>",
      "original_text": "Este camino lleva hasta\nla ciudad de vacaciones...<C:0003,0001,><C:0000,0004,>Aunque creo que aún no está abierto.\nAcaban de mandar de vuelta a un tío\nque quería pasar.<C:0003,0001,>",
      "original_tokenized_text": "Este camino lleva hasta\nla ciudad de vacaciones...<C:0003,0001,><C:0000,0004,>Aunque creo que aún no está abierto.\nAcaban de mandar de vuelta a un tío\nque quería pasar.<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "2": {
