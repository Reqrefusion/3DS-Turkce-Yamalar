      "raw_full_hex": ""
    },
    "6": {
      "text": "¡Rayos y estrellas! Los pesados\nde siempre. ¿¡Se puede saber\nqué hacéis aquí!?<C:0003,0001,>",
      "tokenized_text": "¡Rayos y estrellas! Los pesados\nde siempre. ¿¡Se puede saber\nqué hacéis aquí!?<C:0003,0001,>",
