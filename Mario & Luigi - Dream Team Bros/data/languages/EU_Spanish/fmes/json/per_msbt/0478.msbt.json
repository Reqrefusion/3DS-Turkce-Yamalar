      "raw_full_hex": "0E000100040000004100640065006D00E10073002E002E002E000E000300010000000000"
    },
    "7": {
      "text": "<C:0001,0004,>Puedes golpear los bloques\nque tienen una \"S\" escrita.<C:0003,0001,><C:0000,0004,>También sirven para guardar.<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Puedes golpear los bloques\nque tienen una \"S\" escrita.<C:0003,0001,><C:0000,0004,>También sirven para guardar.<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Puedes golpear los bloques\nque tienen una \"S\" escrita.<C:0003,0001,><C:0000,0004,>También sirven para guardar.<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Puedes golpear los bloques\nque tienen una \"S\" escrita.<C:0003,0001,><C:0000,0004,>También sirven para guardar.<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "8": {
      "text": "<C:0001,0004,>¡En los viajes puede\nocurrir de todo!<C:0003,0001,><C:0000,0004,>Pero si guardas con frecuencia,\nno hay de qué preocuparse.<C:0003,0001,><C:0000,0004,>¡No te olvides de guardar!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>¡En los viajes puede\nocurrir de todo!<C:0003,0001,><C:0000,0004,>Pero si guardas con frecuencia,\nno hay de qué preocuparse.<C:0003,0001,><C:0000,0004,>¡No te olvides de guardar!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>¡En los viajes puede\nocurrir de todo!<C:0003,0001,><C:0000,0004,>Pero si guardas con frecuencia,\nno hay de qué preocuparse.<C:0003,0001,><C:0000,0004,>¡No te olvides de guardar!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>¡En los viajes puede\nocurrir de todo!<C:0003,0001,><C:0000,0004,>Pero si guardas con frecuencia,\nno hay de qué preocuparse.<C:0003,0001,><C:0000,0004,>¡No te olvides de guardar!<C:0003,0001,>",
