    },
    "17": {
      "text": "<C:0001,0004,>¡La Isla Almohada es\nun lugar de ensueño!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>¡La Isla Almohada es\nun lugar de ensueño!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>¡La Isla Almohada es\nun lugar de ensueño!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>¡La Isla Almohada es\nun lugar de ensueño!<C:0003,0001,>",
      "raw_full_hex": "0E00010004000000A1004C0061002000490073006C006100200041006C006D006F0068006100640061002000650073000A0075006E0020006C007500670061007200200064006500200065006E00730075006500F1006F0021000E000300010000000000"
    },
    "18": {
      "text": "<C:0001,0004,>¡Ve por aquí!<C:0003,0000,0A00>\n¡Llegarás al castillo!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>¡Ve por aquí!<C:0003,0000,0A00>\n¡Llegarás al castillo!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>¡Ve por aquí!<C:0003,0000,0A00>\n¡Llegarás al castillo!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>¡Ve por aquí!<C:0003,0000,0A00>\n¡Llegarás al castillo!<C:0003,0001,>",
