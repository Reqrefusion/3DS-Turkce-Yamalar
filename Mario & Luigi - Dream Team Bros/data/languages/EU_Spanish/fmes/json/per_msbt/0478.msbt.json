    },
    "19": {
      "text": "<C:0001,0004,>¡Turista!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>¡Turista!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>¡Turista!<C:0003,0001,>",
