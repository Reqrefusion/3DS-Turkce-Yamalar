    },
    "12": {
      "text": "<C:0001,0004,>¡Hola!<C:0003,0000,0A00>\n¡Emoción!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>¡Hola!<C:0003,0000,0A00>\n¡Emoción!<C:0003,0001,>",
