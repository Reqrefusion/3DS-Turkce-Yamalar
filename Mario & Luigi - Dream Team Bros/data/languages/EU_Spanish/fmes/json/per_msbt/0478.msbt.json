    },
    "1": {
      "text": "<C:0001,0004,>Me gustaría hablarte de uno de los servicios\nque ofrece la Isla Almohada: ¡<C:0000,0003,2C65FFFF>guardar<C:0000,0003,000000FF>!<C:0003,0001,><C:0000,0004,>Gracias a él podrás conservar los bellos\nrecuerdos de tu estancia en la isla.<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Me gustaría hablarte de uno de los servicios\nque ofrece la Isla Almohada: ¡<C:0000,0003,2C65FFFF>guardar<C:0000,0003,000000FF>!<C:0003,0001,><C:0000,0004,>Gracias a él podrás conservar los bellos\nrecuerdos de tu estancia en la isla.<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Me gustaría hablarte de uno de los servicios\nque ofrece la Isla Almohada: ¡<C:0000,0003,2C65FFFF>guardar<C:0000,0003,000000FF>!<C:0003,0001,><C:0000,0004,>Gracias a él podrás conservar los bellos\nrecuerdos de tu estancia en la isla.<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Me gustaría hablarte de uno de los servicios\nque ofrece la Isla Almohada: ¡<C:0000,0003,2C65FFFF>guardar<C:0000,0003,000000FF>!<C:0003,0001,><C:0000,0004,>Gracias a él podrás conservar los bellos\nrecuerdos de tu estancia en la isla.<C:0003,0001,>",
