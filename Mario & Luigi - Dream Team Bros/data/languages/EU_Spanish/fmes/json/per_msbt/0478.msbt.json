    },
    "14": {
      "text": "<C:0001,0004,>¡Disfruta de tu estancia!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>¡Disfruta de tu estancia!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>¡Disfruta de tu estancia!<C:0003,0001,>",
