      "text": "<C:0001,0004,>Mira la pantalla táctil.<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Mira la pantalla táctil.<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Mira la pantalla táctil.<C:0003,0001,>",
