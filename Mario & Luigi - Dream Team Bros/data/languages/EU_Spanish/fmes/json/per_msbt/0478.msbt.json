    },
    "16": {
      "text": "<C:0001,0004,>¡Bienvenido!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>¡Bienvenido!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>¡Bienvenido!<C:0003,0001,>",
