    "10": {
      "text": "¿Te creías que me\nestabas utilizando?<C:0003,0001,><C:0000,0004,>¡Todo lo contrario, chaval!\nAquí el que llevaba la voz cantante\nera yo.<C:0003,0001,>",
      "tokenized_text": "¿Te creías que me\nestabas utilizando?<C:0003,0001,><C:0000,0004,>¡Todo lo contrario, chaval!\nAquí el que llevaba la voz cantante\nera yo.<C:0003,0001,>",
      "original_text": "¿Te creías que me\nestabas utilizando?<C:0003,0001,><C:0000,0004,>¡Todo lo contrario, chaval!\nAquí el que llevaba la voz cantante\nera yo.<C:0003,0001,>",
      "original_tokenized_text": "¿Te creías que me\nestabas utilizando?<C:0003,0001,><C:0000,0004,>¡Todo lo contrario, chaval!\nAquí el que llevaba la voz cantante\nera yo.<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "11": {
      "text": "Pero... ¡No!\n¿¡Cómo has podido!?<C:0003,0001,>",
