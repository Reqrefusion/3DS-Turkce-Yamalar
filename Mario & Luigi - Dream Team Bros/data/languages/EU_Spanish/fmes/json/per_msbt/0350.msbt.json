    },
    "12": {
      "text": "Te lo voy a dejar bien clarito:\n¿qué me dices del castillo?\n¿Y de Peach? ¿Y de la piedra de los sueños?<C:0003,0001,><C:0000,0004,>¡Pues todo eso me pertenece! ¿Te enteras?\n¡Son propiedad única e intransferible de Bowser!<C:0003,0001,>",
      "tokenized_text": "Te lo voy a dejar bien clarito:\n¿qué me dices del castillo?\n¿Y de Peach? ¿Y de la piedra de los sueños?<C:0003,0001,><C:0000,0004,>¡Pues todo eso me pertenece! ¿Te enteras?\n¡Son propiedad única e intransferible de Bowser!<C:0003,0001,>",
      "original_text": "Te lo voy a dejar bien clarito:\n¿qué me dices del castillo?\n¿Y de Peach? ¿Y de la piedra de los sueños?<C:0003,0001,><C:0000,0004,>¡Pues todo eso me pertenece! ¿Te enteras?\n¡Son propiedad única e intransferible de Bowser!<C:0003,0001,>",
      "original_tokenized_text": "Te lo voy a dejar bien clarito:\n¿qué me dices del castillo?\n¿Y de Peach? ¿Y de la piedra de los sueños?<C:0003,0001,><C:0000,0004,>¡Pues todo eso me pertenece! ¿Te enteras?\n¡Son propiedad única e intransferible de Bowser!<C:0003,0001,>",
      "raw_full_hex": ""
