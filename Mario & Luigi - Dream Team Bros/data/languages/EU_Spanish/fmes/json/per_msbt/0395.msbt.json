    },
    "25": {
      "text": "Mantén pulsado con\nel lápiz táctil...<C:0003,0001,><C:0000,0004,>y desliza la piedra\nhasta el panel.<C:0003,0001,>",
      "tokenized_text": "Mantén pulsado con\nel lápiz táctil...<C:0003,0001,><C:0000,0004,>y desliza la piedra\nhasta el panel.<C:0003,0001,>",
      "original_text": "Mantén pulsado con\nel lápiz táctil...<C:0003,0001,><C:0000,0004,>y desliza la piedra\nhasta el panel.<C:0003,0001,>",
      "original_tokenized_text": "Mantén pulsado con\nel lápiz táctil...<C:0003,0001,><C:0000,0004,>y desliza la piedra\nhasta el panel.<C:0003,0001,>",
      "raw_full_hex": ""
    },
