      "tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Necesitáis muchas piedras Sonambulón\npara entrar al templo.<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,6400><C:0001,0004,>Necesitáis muchas piedras Sonambulón\npara entrar al templo.<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Necesitáis muchas piedras Sonambulón\npara entrar al templo.<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "raw_full_hex": ""
    },
    "18": {
      "text": "<C:0000,0002,6400><C:0001,0004,>En el camino encontraréis\na otros Sacerdotes petrificados...<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,6400><C:0001,0004,>En el camino encontraréis\na otros Sacerdotes petrificados...<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,6400><C:0001,0004,>En el camino encontraréis\na otros Sacerdotes petrificados...<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,6400><C:0001,0004,>En el camino encontraréis\na otros Sacerdotes petrificados...<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "raw_full_hex": ""
    },
    "19": {
      "text": "<C:0000,0002,6400><C:0001,0004,>Ayudadlos, y seguro que\nos entregarán sus piedras Sonambulón.<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Necesitaréis la ayuda de muchos\nSacerdotes para llegar al templo.<C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Ayudadlos, y seguro que\nos entregarán sus piedras Sonambulón.<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Necesitaréis la ayuda de muchos\nSacerdotes para llegar al templo.<C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,6400><C:0001,0004,>Ayudadlos, y seguro que\nos entregarán sus piedras Sonambulón.<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Necesitaréis la ayuda de muchos\nSacerdotes para llegar al templo.<C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Ayudadlos, y seguro que\nos entregarán sus piedras Sonambulón.<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Necesitaréis la ayuda de muchos\nSacerdotes para llegar al templo.<C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "raw_full_hex": ""
    },
    "20": {
      "text": "<C:0000,0002,6400><C:0001,0004,>Os estaré observando\ndesde aquí.<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Os estaré observando\ndesde aquí.<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,6400><C:0001,0004,>Os estaré observando\ndesde aquí.<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Os estaré observando\ndesde aquí.<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "raw_full_hex": "0E0000000200020064000E000100040000004F007300200065007300740061007200E90020006F006200730065007200760061006E0064006F000A00640065007300640065002000610071007500ED002E000E0000000200020064000E000300010000000E0000000200020064000E0000000200020064000000"
    },
    "21": {
      "text": "<C:0000,0002,6400><C:0001,0004,>¡La derrota definitiva\ndel conde Pesadillo se acerca!<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>¡No descanséis hasta que\nhaya acabado todo de verdad!<C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,6400><C:0001,0004,>¡La derrota definitiva\ndel conde Pesadillo se acerca!<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>¡No descanséis hasta que\nhaya acabado todo de verdad!<C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,6400><C:0001,0004,>¡La derrota definitiva\ndel conde Pesadillo se acerca!<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>¡No descanséis hasta que\nhaya acabado todo de verdad!<C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,6400><C:0001,0004,>¡La derrota definitiva\ndel conde Pesadillo se acerca!<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>¡No descanséis hasta que\nhaya acabado todo de verdad!<C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "raw_full_hex": ""
    },
    "22": {
      "text": "<C:0001,0004,><C:0000,0003,2C65FFFF><C:0007,0000,><C:0000,0003,FFFFFFFF>¡Has obtenido una <C:0000,0003,00EAFFFF>piedra Sonambulón<C:0000,0003,FFFFFFFF>!<C:0003,0000,1E00><C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,><C:0000,0003,2C65FFFF><C:0007,0000,><C:0000,0003,FFFFFFFF>¡Has obtenido una <C:0000,0003,00EAFFFF>piedra Sonambulón<C:0000,0003,FFFFFFFF>!<C:0003,0000,1E00><C:0003,0001,>",
      "original_text": "<C:0001,0004,><C:0000,0003,2C65FFFF><C:0007,0000,><C:0000,0003,FFFFFFFF>¡Has obtenido una <C:0000,0003,00EAFFFF>piedra Sonambulón<C:0000,0003,FFFFFFFF>!<C:0003,0000,1E00><C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,><C:0000,0003,2C65FFFF><C:0007,0000,><C:0000,0003,FFFFFFFF>¡Has obtenido una <C:0000,0003,00EAFFFF>piedra Sonambulón<C:0000,0003,FFFFFFFF>!<C:0003,0000,1E00><C:0003,0001,>",
      "raw_full_hex": ""
    },
    "23": {
      "text": "Coloca las piedras...<C:0003,0001,><C:0000,0004,>para crear un camino.<C:0003,0001,>",
      "tokenized_text": "Coloca las piedras...<C:0003,0001,><C:0000,0004,>para crear un camino.<C:0003,0001,>",
