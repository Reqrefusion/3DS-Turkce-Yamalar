    },
    "27": {
      "text": "Elige una piedra que\nya hayas colocado...<C:0003,0001,><C:0000,0004,>para cambiarla\nde sitio.<C:0003,0001,>",
      "tokenized_text": "Elige una piedra que\nya hayas colocado...<C:0003,0001,><C:0000,0004,>para cambiarla\nde sitio.<C:0003,0001,>",
