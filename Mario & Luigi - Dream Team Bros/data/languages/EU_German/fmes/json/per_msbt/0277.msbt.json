      "original_text": "<C:0001,0004,><C:0000,0003,2C65FFFF>Muskulone<C:0000,0003,000000FF> hat mir bestätigt, dass\ner auch dorthin kommen wird<C:0000,0003,2C65FFFF><C:0000,0003,000000FF>.<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,><C:0000,0003,2C65FFFF>Muskulone<C:0000,0003,000000FF> hat mir bestätigt, dass\ner auch dorthin kommen wird<C:0000,0003,2C65FFFF><C:0000,0003,000000FF>.<C:0003,0001,>",
      "raw_full_hex": ""
