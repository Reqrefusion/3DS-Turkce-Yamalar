    },
    "5": {
      "text": "И никаких драгоценных\nкамней тут вовсе нет...<C:0003,0001,><C:0000,0004,><C:0001,0001,><C:0001,0004,>Это конец...<C:0003,0001,>",
      "tokenized_text": "И никаких драгоценных\nкамней тут вовсе нет...<C:0003,0001,><C:0000,0004,><C:0001,0001,><C:0001,0004,>Это конец...<C:0003,0001,>",
      "original_text": "И никаких драгоценных\nкамней тут вовсе нет...<C:0003,0001,><C:0000,0004,><C:0001,0001,><C:0001,0004,>Это конец...<C:0003,0001,>",
      "original_tokenized_text": "И никаких драгоценных\nкамней тут вовсе нет...<C:0003,0001,><C:0000,0004,><C:0001,0001,><C:0001,0004,>Это конец...<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "6": {
      "text": "Блокинда, нет!\nНе сдавайся!<C:0003,0001,>",
      "tokenized_text": "Блокинда, нет!\nНе сдавайся!<C:0003,0001,>",
      "original_text": "Блокинда, нет!\nНе сдавайся!<C:0003,0001,>",
      "original_tokenized_text": "Блокинда, нет!\nНе сдавайся!<C:0003,0001,>",
