    },
    "31": {
      "text": "Эх...<C:0003,0000,0A00> и то правда.<C:0003,0001,>",
      "tokenized_text": "Эх...<C:0003,0000,0A00> и то правда.<C:0003,0001,>",
      "original_text": "Эх...<C:0003,0000,0A00> и то правда.<C:0003,0001,>",
      "original_tokenized_text": "Эх...<C:0003,0000,0A00> и то правда.<C:0003,0001,>",
      "raw_full_hex": "2D0445042E002E002E000E000300000002000A0020003804200042043E0420003F04400430043204340430042E000E000300010000000000"
    },
    "32": {
      "text": "Нам нужны какие-то\nзацепки, чтобы отыскать их.<C:0003,0001,>",
      "tokenized_text": "Нам нужны какие-то\nзацепки, чтобы отыскать их.<C:0003,0001,>",
      "original_text": "Нам нужны какие-то\nзацепки, чтобы отыскать их.<C:0003,0001,>",
      "original_tokenized_text": "Нам нужны какие-то\nзацепки, чтобы отыскать их.<C:0003,0001,>",
      "raw_full_hex": "1D0430043C0420003D04430436043D044B0420003A0430043A04380435042D0042043E040A0037043004460435043F043A0438042C002000470442043E0431044B0420003E0442044B0441043A04300442044C042000380445042E000E000300010000000000"
    },
