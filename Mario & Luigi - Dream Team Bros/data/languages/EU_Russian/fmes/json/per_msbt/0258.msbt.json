    },
    "49": {
      "text": "Гора на севере\nза замком засыпайя.<C:0003,0001,>",
      "tokenized_text": "Гора на севере\nза замком засыпайя.<C:0003,0001,>",
      "original_text": "Гора на севере\nза замком засыпайя.<C:0003,0001,>",
      "original_tokenized_text": "Гора на севере\nза замком засыпайя.<C:0003,0001,>",
