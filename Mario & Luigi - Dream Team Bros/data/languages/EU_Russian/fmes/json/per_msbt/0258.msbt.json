    },
    "50": {
      "text": "За замком засыпайя?\nВсе, поняла!<C:0003,0001,>",
      "tokenized_text": "За замком засыпайя?\nВсе, поняла!<C:0003,0001,>",
      "original_text": "За замком засыпайя?\nВсе, поняла!<C:0003,0001,>",
      "original_tokenized_text": "За замком засыпайя?\nВсе, поняла!<C:0003,0001,>",
