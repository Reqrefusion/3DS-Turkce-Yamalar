    "0": {
      "text": "<C:0001,0001,>Владыка Боузер!<C:0003,0001,><C:0000,0004,><C:0001,0000,>Мы приготовили вкусную мясную\nвырастишку! Угощение-объедение!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0001,>Владыка Боузер!<C:0003,0001,><C:0000,0004,><C:0001,0000,>Мы приготовили вкусную мясную\nвырастишку! Угощение-объедение!<C:0003,0001,>",
      "original_text": "<C:0001,0001,>Владыка Боузер!<C:0003,0001,><C:0000,0004,><C:0001,0000,>Мы приготовили вкусную мясную\nвырастишку! Угощение-объедение!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0001,>Владыка Боузер!<C:0003,0001,><C:0000,0004,><C:0001,0000,>Мы приготовили вкусную мясную\nвырастишку! Угощение-объедение!<C:0003,0001,>",
      "raw_full_hex": ""
