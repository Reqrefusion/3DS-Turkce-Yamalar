    "13": {
      "text": "<C:0000,0002,9600><C:0001,0004,><C:0000,0003,2C65FFFF><C:0001,0001,>ШАРОПРЫГ<C:0000,0003,000000FF><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,9600>!<C:0000,0002,6400><C:0000,0003,000000FF><C:0003,0000,3C00>",
