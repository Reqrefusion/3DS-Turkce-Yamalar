    },
    "11": {
      "text": "<C:0007,0001,><C:0003,0002,3C00><C:0001,0001,>Прыг-скок-стрибок, прыг-скок!\nПрыг-скок-стрибок, прыг-скок!<C:0003,0000,2800>",
