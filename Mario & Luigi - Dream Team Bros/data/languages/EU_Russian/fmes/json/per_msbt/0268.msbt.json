    "3": {
      "text": "Добралися!<C:0003,0001,>",
      "tokenized_text": "Добралися!<C:0003,0001,>",
      "original_text": "Добралися!<C:0003,0001,>",
      "original_tokenized_text": "Добралися!<C:0003,0001,>",
      "raw_full_hex": "14043E043104400430043B04380441044F0421000E000300010000000000"
    },
    "4": {
      "text": "Дывитесь на\nвысокий обрыв!<C:0003,0001,>",
      "tokenized_text": "Дывитесь на\nвысокий обрыв!<C:0003,0001,>",
      "original_text": "Дывитесь на\nвысокий обрыв!<C:0003,0001,>",
      "original_tokenized_text": "Дывитесь на\nвысокий обрыв!<C:0003,0001,>",
      "raw_full_hex": "14044B04320438044204350441044C0420003D0430040A0032044B0441043E043A043804390420003E04310440044B04320421000E000300010000000000"
    },
    "5": {
      "text": "Тут-то гора показуэ\nсвою реальну натуру!<C:0003,0001,>",
      "tokenized_text": "Тут-то гора показуэ\nсвою реальну натуру!<C:0003,0001,>",
      "original_text": "Тут-то гора показуэ\nсвою реальну натуру!<C:0003,0001,>",
      "original_tokenized_text": "Тут-то гора показуэ\nсвою реальну натуру!<C:0003,0001,>",
      "raw_full_hex": "2204430442042D0042043E04200033043E044004300420003F043E043A043004370443044D040A00410432043E044E0420004004350430043B044C043D04430420003D043004420443044004430421000E000300010000000000"
    },
    "6": {
      "text": "Потрибно и нам друг\nза друга горой стояти!<C:0003,0001,>",
      "tokenized_text": "Потрибно и нам друг\nза друга горой стояти!<C:0003,0001,>",
      "original_text": "Потрибно и нам друг\nза друга горой стояти!<C:0003,0001,>",
      "original_tokenized_text": "Потрибно и нам друг\nза друга горой стояти!<C:0003,0001,>",
      "raw_full_hex": "1F043E0442044004380431043D043E042000380420003D0430043C04200034044004430433040A0037043004200034044004430433043004200033043E0440043E0439042000410442043E044F044204380421000E000300010000000000"
    },
    "7": {
      "text": "Иначе не выжити!\nБратский прием!<C:0003,0001,><C:0000,0004,>Двадцать годин\nмы его розвивали!<C:0003,0001,>",
      "tokenized_text": "Иначе не выжити!\nБратский прием!<C:0003,0001,><C:0000,0004,>Двадцать годин\nмы его розвивали!<C:0003,0001,>",
      "original_text": "Иначе не выжити!\nБратский прием!<C:0003,0001,><C:0000,0004,>Двадцать годин\nмы его розвивали!<C:0003,0001,>",
      "original_tokenized_text": "Иначе не выжити!\nБратский прием!<C:0003,0001,><C:0000,0004,>Двадцать годин\nмы его розвивали!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "8": {
      "text": "Готов, старшой?!<C:0003,0001,>",
      "tokenized_text": "Готов, старшой?!<C:0003,0001,>",
      "original_text": "Готов, старшой?!<C:0003,0001,>",
      "original_tokenized_text": "Готов, старшой?!<C:0003,0001,>",
      "raw_full_hex": "13043E0442043E0432042C002000410442043004400448043E0439043F0021000E000300010000000000"
    },
    "9": {
      "text": "Починай!!!<C:0003,0001,>",
      "tokenized_text": "Починай!!!<C:0003,0001,>",
      "original_text": "Починай!!!<C:0003,0001,>",
      "original_tokenized_text": "Починай!!!<C:0003,0001,>",
      "raw_full_hex": "1F043E04470438043D04300439042100210021000E000300010000000000"
    },
    "10": {
      "text": "<C:0000,0002,9600><C:0001,0004,><C:0001,0001,>Шарец-стрибунец!<C:0000,0002,6400><C:0000,0002,9600><C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,9600><C:0001,0004,><C:0001,0001,>Шарец-стрибунец!<C:0000,0002,6400><C:0000,0002,9600><C:0003,0001,><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,9600><C:0001,0004,><C:0001,0001,>Шарец-стрибунец!<C:0000,0002,6400><C:0000,0002,9600><C:0003,0001,><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,9600><C:0001,0004,><C:0001,0001,>Шарец-стрибунец!<C:0000,0002,6400><C:0000,0002,9600><C:0003,0001,><C:0000,0002,6400>",
