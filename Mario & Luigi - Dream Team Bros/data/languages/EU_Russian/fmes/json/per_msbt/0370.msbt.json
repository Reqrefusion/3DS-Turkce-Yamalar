    },
    "29": {
      "text": "<C:0000,0002,6400><C:0001,0004,>Минуточку! Марио, стоять!<C:0003,0000,0A00>\nНам надо тут посовещаться!<C:0000,0002,6400><C:0003,0001,>",
      "tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Минуточку! Марио, стоять!<C:0003,0000,0A00>\nНам надо тут посовещаться!<C:0000,0002,6400><C:0003,0001,>",
      "original_text": "<C:0000,0002,6400><C:0001,0004,>Минуточку! Марио, стоять!<C:0003,0000,0A00>\nНам надо тут посовещаться!<C:0000,0002,6400><C:0003,0001,>",
      "original_tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Минуточку! Марио, стоять!<C:0003,0000,0A00>\nНам надо тут посовещаться!<C:0000,0002,6400><C:0003,0001,>",
      "raw_full_hex": ""
    },
    "30": {
      "text": "<C:0000,0002,6400><C:0001,0004,>Понял? Стой, где стоишь!<C:0000,0002,6400><C:0003,0001,>",
      "tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Понял? Стой, где стоишь!<C:0000,0002,6400><C:0003,0001,>",
      "original_text": "<C:0000,0002,6400><C:0001,0004,>Понял? Стой, где стоишь!<C:0000,0002,6400><C:0003,0001,>",
      "original_tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Понял? Стой, где стоишь!<C:0000,0002,6400><C:0003,0001,>",
