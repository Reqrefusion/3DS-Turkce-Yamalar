    },
    "28": {
      "text": "<C:0000,0002,6400><C:0001,0004,>Ну да, так вот...<C:0000,0002,6400><C:0003,0001,>",
      "tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Ну да, так вот...<C:0000,0002,6400><C:0003,0001,>",
      "original_text": "<C:0000,0002,6400><C:0001,0004,>Ну да, так вот...<C:0000,0002,6400><C:0003,0001,>",
