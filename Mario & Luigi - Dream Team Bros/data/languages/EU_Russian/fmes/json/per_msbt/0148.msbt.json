    "36": {
      "text": "<C:0001,0004,>Думаете, тут\nбезопасно?<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Думаете, тут\nбезопасно?<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Думаете, тут\nбезопасно?<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Думаете, тут\nбезопасно?<C:0003,0001,>",
