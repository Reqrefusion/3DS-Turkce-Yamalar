    },
    "1": {
      "text": "Ух! Теперь они\nнас не догонят!<C:0003,0001,>",
      "tokenized_text": "Ух! Теперь они\nнас не догонят!<C:0003,0001,>",
      "original_text": "Ух! Теперь они\nнас не догонят!<C:0003,0001,>",
      "original_tokenized_text": "Ух! Теперь они\nнас не догонят!<C:0003,0001,>",
      "raw_full_hex": "2304450421002000220435043F04350440044C0420003E043D0438040A003D043004410420003D043504200034043E0433043E043D044F04420421000E000300010000000000"
    },
    "2": {
      "text": "Не догонят!<C:0003,0001,>",
      "tokenized_text": "Не догонят!<C:0003,0001,>",
      "original_text": "Не догонят!<C:0003,0001,>",
