    },
    "15": {
      "text": "Эй, слышал новости?<C:0003,0000,3200>",
      "tokenized_text": "Эй, слышал новости?<C:0003,0000,3200>",
      "original_text": "Эй, слышал новости?<C:0003,0000,3200>",
