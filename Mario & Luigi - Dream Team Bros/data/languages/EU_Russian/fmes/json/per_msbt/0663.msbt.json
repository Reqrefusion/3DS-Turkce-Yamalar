      "raw_full_hex": "1D043504200034043E0433043E043D044F04420421000E000300010000000000"
    },
    "3": {
      "text": "Смотрите...\nМилые птички...<C:0003,0001,>",
      "tokenized_text": "Смотрите...\nМилые птички...<C:0003,0001,>",
      "original_text": "Смотрите...\nМилые птички...<C:0003,0001,>",
      "original_tokenized_text": "Смотрите...\nМилые птички...<C:0003,0001,>",
