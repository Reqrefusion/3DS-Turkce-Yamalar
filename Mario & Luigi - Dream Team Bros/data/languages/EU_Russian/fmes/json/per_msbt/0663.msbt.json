      "raw_full_hex": "0E000000020002004B000E000100010000000E000100040000002100210021000E000300000002001E000E0000000200020064000000"
    },
    "26": {
      "text": "<C:0007,0000,><C:0001,0001,><C:0001,0004,>Получено <C:0000,0003,00EAFFFF>медузодеяло с Дрыхоморья<C:0000,0003,FFFFFFFF>!<C:0003,0000,3C00><C:0003,0001,>",
      "tokenized_text": "<C:0007,0000,><C:0001,0001,><C:0001,0004,>Получено <C:0000,0003,00EAFFFF>медузодеяло с Дрыхоморья<C:0000,0003,FFFFFFFF>!<C:0003,0000,3C00><C:0003,0001,>",
      "original_text": "<C:0007,0000,><C:0001,0001,><C:0001,0004,>Получено <C:0000,0003,00EAFFFF>медузодеяло с Дрыхоморья<C:0000,0003,FFFFFFFF>!<C:0003,0000,3C00><C:0003,0001,>",
