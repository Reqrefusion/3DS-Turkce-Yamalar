    "14": {
      "text": "<C:0000,0002,6400><C:0000,0003,000000FF><C:0001,0004,>Говорят, правда, один в поле\nне воин... Но и так сойдет!<C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,>",
      "tokenized_text": "<C:0000,0002,6400><C:0000,0003,000000FF><C:0001,0004,>Говорят, правда, один в поле\nне воин... Но и так сойдет!<C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,>",
      "original_text": "<C:0000,0002,6400><C:0000,0003,000000FF><C:0001,0004,>Говорят, правда, один в поле\nне воин... Но и так сойдет!<C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,>",
      "original_tokenized_text": "<C:0000,0002,6400><C:0000,0003,000000FF><C:0001,0004,>Говорят, правда, один в поле\nне воин... Но и так сойдет!<C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,>",
      "raw_full_hex": ""
