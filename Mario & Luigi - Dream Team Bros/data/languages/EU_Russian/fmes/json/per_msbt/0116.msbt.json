    },
    "14": {
      "text": "<C:0007,0000,><C:0001,0001,><C:0001,0004,><C:0000,0002,9600>Называется<C:0003,0000,4600><C:0000,0002,9600><C:0000,0004,><C:0000,0002,9600><C:0007,0000,><C:0001,0001,><C:0001,0004,>«Бамбуло<C:0003,0000,0800> Грезуло<C:0000,0002,9600><C:0003,0000,0400><C:0000,0002,9600> 2»!<C:0000,0002,6400><C:0003,0001,>",
      "tokenized_text": "<C:0007,0000,><C:0001,0001,><C:0001,0004,><C:0000,0002,9600>Называется<C:0003,0000,4600><C:0000,0002,9600><C:0000,0004,><C:0000,0002,9600><C:0007,0000,><C:0001,0001,><C:0001,0004,>«Бамбуло<C:0003,0000,0800> Грезуло<C:0000,0002,9600><C:0003,0000,0400><C:0000,0002,9600> 2»!<C:0000,0002,6400><C:0003,0001,>",
