      "original_text": "",
      "original_tokenized_text": "",
      "raw_full_hex": "0000"
    },
    "32": {
      "text": "<C:0001,0004,>Поздравляю!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Поздравляю!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Поздравляю!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Поздравляю!<C:0003,0001,>",
      "raw_full_hex": "0E000100040000001F043E04370434044004300432043B044F044E0421000E000300010000000000"
    },
    "33": {
      "text": "",
      "tokenized_text": "",
      "original_text": "",
      "original_tokenized_text": "",
      "raw_full_hex": "0000"
    },
    "34": {
      "text": "",
      "tokenized_text": "",
      "original_text": "",
      "original_tokenized_text": "",
      "raw_full_hex": "0000"
    },
    "35": {
      "text": "<C:0001,0004,>Ну, до скорого!\nТренируйтеся!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Ну, до скорого!\nТренируйтеся!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Ну, до скорого!\nТренируйтеся!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Ну, до скорого!\nТренируйтеся!<C:0003,0001,>",
      "raw_full_hex": "0E000100040000001D0443042C00200034043E04200041043A043E0440043E0433043E0421000A002204400435043D0438044004430439044204350441044F0421000E000300010000000000"
    },
    "36": {
      "text": "",
      "tokenized_text": "",
      "original_text": "",
      "original_tokenized_text": "",
      "raw_full_hex": "0000"
    },
    "37": {
      "text": "",
      "tokenized_text": "",
      "original_text": "",
      "original_tokenized_text": "",
      "raw_full_hex": "0000"
    },
    "38": {
      "text": "<C:0001,0004,>Настал час поздравлений!\nВсех чотвирих победили!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Настал час поздравлений!\nВсех чотвирих победили!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Настал час поздравлений!\nВсех чотвирих победили!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Настал час поздравлений!\nВсех чотвирих победили!<C:0003,0001,>",
      "raw_full_hex": "0E000100040000001D0430044104420430043B04200047043004410420003F043E04370434044004300432043B0435043D043804390421000A001204410435044504200047043E0442043204380440043804450420003F043E0431043504340438043B04380421000E000300010000000000"
    },
    "39": {
      "text": "",
      "tokenized_text": "",
      "original_text": "",
      "original_tokenized_text": "",
      "raw_full_hex": "0000"
    },
    "40": {
      "text": "",
      "tokenized_text": "",
      "original_text": "",
      "original_tokenized_text": "",
      "raw_full_hex": "0000"
    },
    "41": {
      "text": "<C:0001,0004,>Зараз возвращайтеся...\nв турцентр мира грез!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Зараз возвращайтеся...\nв турцентр мира грез!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Зараз возвращайтеся...\nв турцентр мира грез!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Зараз возвращайтеся...\nв турцентр мира грез!<C:0003,0001,>",
      "raw_full_hex": "0E0001000400000017043004400430043704200032043E0437043204400430044904300439044204350441044F042E002E002E000A0032042000420443044004460435043D044204400420003C043804400430042000330440043504370421000E000300010000000000"
    },
    "42": {
      "text": "<C:0001,0004,><C:0000,0003,2C65FFFF>Бамбуло-старший<C:0000,0003,000000FF> \nожидает вас там<C:0000,0003,2C65FFFF><C:0000,0003,000000FF>.<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,><C:0000,0003,2C65FFFF>Бамбуло-старший<C:0000,0003,000000FF> \nожидает вас там<C:0000,0003,2C65FFFF><C:0000,0003,000000FF>.<C:0003,0001,>",
      "original_text": "<C:0001,0004,><C:0000,0003,2C65FFFF>Бамбуло-старший<C:0000,0003,000000FF> \nожидает вас там<C:0000,0003,2C65FFFF><C:0000,0003,000000FF>.<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,><C:0000,0003,2C65FFFF>Бамбуло-старший<C:0000,0003,000000FF> \nожидает вас там<C:0000,0003,2C65FFFF><C:0000,0003,000000FF>.<C:0003,0001,>",
      "raw_full_hex": "0E000100040000000E000000030004002C65FFFF110430043C04310443043B043E042D0041044204300440044804380439040E00000003000400000000FF20000A003E0436043804340430043504420420003204300441042000420430043C040E000000030004002C65FFFF0E00000003000400000000FF2E000E000300010000000000"
    },
    "43": {
      "text": "<C:0000,0002,4B00><C:0001,0004,>Я усе равно проиграю...\nЯ ж ужасно слабый...<C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,4B00><C:0001,0004,>Я усе равно проиграю...\nЯ ж ужасно слабый...<C:0003,0001,><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,4B00><C:0001,0004,>Я усе равно проиграю...\nЯ ж ужасно слабый...<C:0003,0001,><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,4B00><C:0001,0004,>Я усе равно проиграю...\nЯ ж ужасно слабый...<C:0003,0001,><C:0000,0002,6400>",
      "raw_full_hex": "0E000000020002004B000E000100040000002F04200043044104350420004004300432043D043E0420003F0440043E0438043304400430044E042E002E002E000A002F0420003604200043043604300441043D043E04200041043B04300431044B0439042E002E002E000E000300010000000E0000000200020064000000"
    },
    "44": {
      "text": "<C:0000,0002,4B00><C:0001,0004,>Домой...<C:0003,0000,1400> хочу...<C:0000,0002,4B00><C:0003,0000,1400><C:0000,0002,4B00>\nк маме...<C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,4B00><C:0001,0004,>Домой...<C:0003,0000,1400> хочу...<C:0000,0002,4B00><C:0003,0000,1400><C:0000,0002,4B00>\nк маме...<C:0003,0001,><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,4B00><C:0001,0004,>Домой...<C:0003,0000,1400> хочу...<C:0000,0002,4B00><C:0003,0000,1400><C:0000,0002,4B00>\nк маме...<C:0003,0001,><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,4B00><C:0001,0004,>Домой...<C:0003,0000,1400> хочу...<C:0000,0002,4B00><C:0003,0000,1400><C:0000,0002,4B00>\nк маме...<C:0003,0001,><C:0000,0002,6400>",
      "raw_full_hex": "0E000000020002004B000E0001000400000014043E043C043E0439042E002E002E000E000300000002001400200045043E04470443042E002E002E000E000000020002004B000E0003000000020014000E000000020002004B000A003A0420003C0430043C0435042E002E002E000E000300010000000E0000000200020064000000"
    },
    "45": {
      "text": "<C:0000,0002,4B00><C:0001,0004,>Чого? Даже я могу\nстать дуже сильным?<C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,4B00><C:0001,0004,>Чого? Даже я могу\nстать дуже сильным?<C:0003,0001,><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,4B00><C:0001,0004,>Чого? Даже я могу\nстать дуже сильным?<C:0003,0001,><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,4B00><C:0001,0004,>Чого? Даже я могу\nстать дуже сильным?<C:0003,0001,><C:0000,0002,6400>",
      "raw_full_hex": "0E000000020002004B000E0001000400000027043E0433043E043F002000140430043604350420004F0420003C043E04330443040A0041044204300442044C04200034044304360435042000410438043B044C043D044B043C043F000E000300010000000E0000000200020064000000"
    },
    "46": {
      "text": "<C:0000,0002,4B00><C:0001,0004,>И я, значить, могу усех\nпобедить, як другие?<C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,4B00><C:0001,0004,>И я, значить, могу усех\nпобедить, як другие?<C:0003,0001,><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,4B00><C:0001,0004,>И я, значить, могу усех\nпобедить, як другие?<C:0003,0001,><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,4B00><C:0001,0004,>И я, значить, могу усех\nпобедить, як другие?<C:0003,0001,><C:0000,0002,6400>",
      "raw_full_hex": "0E000000020002004B000E00010004000000180420004F042C00200037043D0430044704380442044C042C0020003C043E0433044304200043044104350445040A003F043E04310435043404380442044C042C0020004F043A0420003404400443043304380435043F000E000300010000000E0000000200020064000000"
    },
    "47": {
      "text": "<C:0000,0002,4B00><C:0001,0004,>Значить, ежели захочу,\nя смогу вас уложить?<C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,4B00><C:0001,0004,>Значить, ежели захочу,\nя смогу вас уложить?<C:0003,0001,><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,4B00><C:0001,0004,>Значить, ежели захочу,\nя смогу вас уложить?<C:0003,0001,><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,4B00><C:0001,0004,>Значить, ежели захочу,\nя смогу вас уложить?<C:0003,0001,><C:0000,0002,6400>",
      "raw_full_hex": "0E000000020002004B000E0001000400000017043D0430044704380442044C042C0020003504360435043B04380420003704300445043E04470443042C000A004F04200041043C043E04330443042000320430044104200043043B043E043604380442044C043F000E000300010000000E0000000200020064000000"
    },
    "48": {
      "text": "",
      "tokenized_text": "",
      "original_text": "",
      "original_tokenized_text": "",
      "raw_full_hex": "0000"
    },
    "49": {
      "text": "<C:0000,0002,4B00><C:0001,0004,>У меня шансов нема!\nУсе потеряно...<C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,4B00><C:0001,0004,>У меня шансов нема!\nУсе потеряно...<C:0003,0001,><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,4B00><C:0001,0004,>У меня шансов нема!\nУсе потеряно...<C:0003,0001,><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,4B00><C:0001,0004,>У меня шансов нема!\nУсе потеряно...<C:0003,0001,><C:0000,0002,6400>",
      "raw_full_hex": "0E000000020002004B000E00010004000000230420003C0435043D044F042000480430043D0441043E04320420003D0435043C04300421000A0023044104350420003F043E044204350440044F043D043E042E002E002E000E000300010000000E0000000200020064000000"
    },
    "50": {
      "text": "<C:0000,0002,4B00><C:0001,0004,>Я ж дуже увалень...<C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,4B00><C:0001,0004,>Я ж дуже увалень...<C:0003,0001,><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,4B00><C:0001,0004,>Я ж дуже увалень...<C:0003,0001,><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,4B00><C:0001,0004,>Я ж дуже увалень...<C:0003,0001,><C:0000,0002,6400>",
      "raw_full_hex": "0E000000020002004B000E000100040000002F04200036042000340443043604350420004304320430043B0435043D044C042E002E002E000E000300010000000E0000000200020064000000"
    },
    "51": {
      "text": "<C:0000,0002,4B00><C:0001,0004,>Уа-а-а...<C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,4B00><C:0001,0004,>Уа-а-а...<C:0003,0001,><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,4B00><C:0001,0004,>Уа-а-а...<C:0003,0001,><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,4B00><C:0001,0004,>Уа-а-а...<C:0003,0001,><C:0000,0002,6400>",
      "raw_full_hex": "0E000000020002004B000E00010004000000230430042D0030042D0030042E002E002E000E000300010000000E0000000200020064000000"
    },
    "52": {
      "text": "<C:0000,0002,6400><C:0001,0004,>Поверить в себя?!\n<C:0000,0002,4B00>А это вообще как?<C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Поверить в себя?!\n<C:0000,0002,4B00>А это вообще как?<C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,6400><C:0001,0004,>Поверить в себя?!\n<C:0000,0002,4B00>А это вообще как?<C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Поверить в себя?!\n<C:0000,0002,4B00>А это вообще как?<C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "raw_full_hex": "0E0000000200020064000E000100040000001F043E04320435044004380442044C042000320420004104350431044F043F0021000A000E000000020002004B00100420004D0442043E04200032043E043E0431044904350420003A0430043A043F000E000300010000000E0000000200020064000E0000000200020064000000"
    },
    "53": {
      "text": "",
      "tokenized_text": "",
      "original_text": "",
      "original_tokenized_text": "",
      "raw_full_hex": "0000"
    },
    "54": {
      "text": "<C:0000,0002,4B00><C:0001,0004,>Рыдалко — это я,\nи я очень грустный.<C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,4B00><C:0001,0004,>Рыдалко — это я,\nи я очень грустный.<C:0003,0001,><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,4B00><C:0001,0004,>Рыдалко — это я,\nи я очень грустный.<C:0003,0001,><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,4B00><C:0001,0004,>Рыдалко — это я,\nи я очень грустный.<C:0003,0001,><C:0000,0002,6400>",
      "raw_full_hex": "0E000000020002004B000E0001000400000020044B04340430043B043A043E042000142020004D0442043E0420004F042C000A00380420004F0420003E04470435043D044C042000330440044304410442043D044B0439042E000E000300010000000E0000000200020064000000"
    },
    "55": {
      "text": "<C:0000,0002,4B00><C:0001,0004,>Хочите со мной побороться?<C:0003,0000,0A00>\nДа я не особливо усильный-то...<C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,4B00><C:0001,0004,>Хочите со мной побороться?<C:0003,0000,0A00>\nДа я не особливо усильный-то...<C:0003,0001,><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,4B00><C:0001,0004,>Хочите со мной побороться?<C:0003,0000,0A00>\nДа я не особливо усильный-то...<C:0003,0001,><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,4B00><C:0001,0004,>Хочите со мной побороться?<C:0003,0000,0A00>\nДа я не особливо усильный-то...<C:0003,0001,><C:0000,0002,6400>",
      "raw_full_hex": ""
    },
