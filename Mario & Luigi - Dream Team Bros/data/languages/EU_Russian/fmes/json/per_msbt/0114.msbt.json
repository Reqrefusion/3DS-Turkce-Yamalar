    "22": {
      "text": "Старшой, скажи, что не брешу!<C:0003,0001,>",
      "tokenized_text": "Старшой, скажи, что не брешу!<C:0003,0001,>",
      "original_text": "Старшой, скажи, что не брешу!<C:0003,0001,>",
      "original_tokenized_text": "Старшой, скажи, что не брешу!<C:0003,0001,>",
      "raw_full_hex": "210442043004400448043E0439042C00200041043A043004360438042C002000470442043E0420003D04350420003104400435044804430421000E000300010000000000"
    },
    "23": {
      "text": "Не брешешь, малой!<C:0003,0001,>",
      "tokenized_text": "Не брешешь, малой!<C:0003,0001,>",
      "original_text": "Не брешешь, малой!<C:0003,0001,>",
