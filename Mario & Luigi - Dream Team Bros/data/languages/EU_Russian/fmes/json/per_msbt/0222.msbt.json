      "original_text": "<C:0001,0004,>Спасибо за спасение!<C:0003,0001,><C:0000,0004,><C:0001,0004,>Сомнения одолевали\nменя... но я верил!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Спасибо за спасение!<C:0003,0001,><C:0000,0004,><C:0001,0004,>Сомнения одолевали\nменя... но я верил!<C:0003,0001,>",
      "raw_full_hex": ""
    },
