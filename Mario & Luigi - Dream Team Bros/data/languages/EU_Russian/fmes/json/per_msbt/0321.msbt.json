  "0321.msbt": {
    "0": {
      "text": "<C:0007,0000,>Отправиться в мир грез?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Нет.         <C:0005,0001,>Да.<C:0003,0000,0A00>",
      "tokenized_text": "<C:0007,0000,>Отправиться в мир грез?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Нет.         <C:0005,0001,>Да.<C:0003,0000,0A00>",
      "original_text": "<C:0007,0000,>Отправиться в мир грез?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Нет.         <C:0005,0001,>Да.<C:0003,0000,0A00>",
      "original_tokenized_text": "<C:0007,0000,>Отправиться в мир грез?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Нет.         <C:0005,0001,>Да.<C:0003,0000,0A00>",
      "raw_full_hex": "0E000700000000001E0442043F04400430043204380442044C0441044F042000320420003C0438044004200033044004350437043F000E000300000002000A000A000E000100010000000E000500010000001D04350442042E002000200020002000200020002000200020000E00050001000000140430042E000E000300000002000A000000"
    },
    "1": {
      "text": "<C:0007,0000,>Ну, что новенького?<C:0003,0000,0A00>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Поговори с нами!\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Помоги попасть в мир грез!\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Ну, мы пойдем.<C:0003,0000,0A00>",
      "tokenized_text": "<C:0007,0000,>Ну, что новенького?<C:0003,0000,0A00>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Поговори с нами!\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Помоги попасть в мир грез!\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Ну, мы пойдем.<C:0003,0000,0A00>",
      "original_text": "<C:0007,0000,>Ну, что новенького?<C:0003,0000,0A00>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Поговори с нами!\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Помоги попасть в мир грез!\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Ну, мы пойдем.<C:0003,0000,0A00>",
      "original_tokenized_text": "<C:0007,0000,>Ну, что новенького?<C:0003,0000,0A00>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Поговори с нами!\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Помоги попасть в мир грез!\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Ну, мы пойдем.<C:0003,0000,0A00>",
      "raw_full_hex": ""
    },
    "2": {
      "text": "Где<C:0003,0000,0A00> я?<C:0003,0001,>",
      "tokenized_text": "Где<C:0003,0000,0A00> я?<C:0003,0001,>",
      "original_text": "Где<C:0003,0000,0A00> я?<C:0003,0001,>",
      "original_tokenized_text": "Где<C:0003,0000,0A00> я?<C:0003,0001,>",
      "raw_full_hex": "1304340435040E000300000002000A0020004F043F000E000300010000000000"
    },
    "3": {
      "text": "Ого! Черный-черный замок...<C:0003,0001,><C:0000,0004,>Внутри черный-черный зал...<C:0003,0001,>",
      "tokenized_text": "Ого! Черный-черный замок...<C:0003,0001,><C:0000,0004,>Внутри черный-черный зал...<C:0003,0001,>",
      "original_text": "Ого! Черный-черный замок...<C:0003,0001,><C:0000,0004,>Внутри черный-черный зал...<C:0003,0001,>",
      "original_tokenized_text": "Ого! Черный-черный замок...<C:0003,0001,><C:0000,0004,>Внутри черный-черный зал...<C:0003,0001,>",
      "raw_full_hex": "1E0433043E04210020002704350440043D044B0439042D004704350440043D044B0439042000370430043C043E043A042E002E002E000E000300010000000E0000000400000012043D04430442044004380420004704350440043D044B0439042D004704350440043D044B0439042000370430043B042E002E002E000E000300010000000000"
    },
    "4": {
      "text": "А за ним черный-черный коридор!<C:0003,0000,0A00><C:0003,0001,>",
      "tokenized_text": "А за ним черный-черный коридор!<C:0003,0000,0A00><C:0003,0001,>",
      "original_text": "А за ним черный-черный коридор!<C:0003,0000,0A00><C:0003,0001,>",
      "original_tokenized_text": "А за ним черный-черный коридор!<C:0003,0000,0A00><C:0003,0001,>",
      "raw_full_hex": "100420003704300420003D0438043C0420004704350440043D044B0439042D004704350440043D044B04390420003A043E044004380434043E04400421000E000300000002000A000E000300010000000000"
    },
    "5": {
      "text": "А за ним черная-черная комната!<C:0003,0001,><C:0000,0004,>А там Мракула!<C:0003,0001,><C:0000,0004,>А Мракула... ну, в общем,\nон тоже не белый и пушистый!<C:0003,0001,>",
      "tokenized_text": "А за ним черная-черная комната!<C:0003,0001,><C:0000,0004,>А там Мракула!<C:0003,0001,><C:0000,0004,>А Мракула... ну, в общем,\nон тоже не белый и пушистый!<C:0003,0001,>",
      "original_text": "А за ним черная-черная комната!<C:0003,0001,><C:0000,0004,>А там Мракула!<C:0003,0001,><C:0000,0004,>А Мракула... ну, в общем,\nон тоже не белый и пушистый!<C:0003,0001,>",
      "original_tokenized_text": "А за ним черная-черная комната!<C:0003,0001,><C:0000,0004,>А там Мракула!<C:0003,0001,><C:0000,0004,>А Мракула... ну, в общем,\nон тоже не белый и пушистый!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "6": {
      "text": "Все засыпайя\nвызволены из беды!<C:0003,0001,><C:0000,0004,>Марио! Луиджи!\nНизкий вам поклон!<C:0003,0001,><C:0000,0004,>Отправимся же скорей\nв <C:0000,0003,2C65FFFF>Заресад <C:0000,0003,000000FF>к <C:0000,0003,2C65FFFF>Мудрогрезу<C:0000,0003,000000FF>.<C:0003,0001,>",
      "tokenized_text": "Все засыпайя\nвызволены из беды!<C:0003,0001,><C:0000,0004,>Марио! Луиджи!\nНизкий вам поклон!<C:0003,0001,><C:0000,0004,>Отправимся же скорей\nв <C:0000,0003,2C65FFFF>Заресад <C:0000,0003,000000FF>к <C:0000,0003,2C65FFFF>Мудрогрезу<C:0000,0003,000000FF>.<C:0003,0001,>",
      "original_text": "Все засыпайя\nвызволены из беды!<C:0003,0001,><C:0000,0004,>Марио! Луиджи!\nНизкий вам поклон!<C:0003,0001,><C:0000,0004,>Отправимся же скорей\nв <C:0000,0003,2C65FFFF>Заресад <C:0000,0003,000000FF>к <C:0000,0003,2C65FFFF>Мудрогрезу<C:0000,0003,000000FF>.<C:0003,0001,>",
      "original_tokenized_text": "Все засыпайя\nвызволены из беды!<C:0003,0001,><C:0000,0004,>Марио! Луиджи!\nНизкий вам поклон!<C:0003,0001,><C:0000,0004,>Отправимся же скорей\nв <C:0000,0003,2C65FFFF>Заресад <C:0000,0003,000000FF>к <C:0000,0003,2C65FFFF>Мудрогрезу<C:0000,0003,000000FF>.<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "7": {
      "text": "Добро пожаловать в наш филиал в...\nгм... в загадочном и мрачном замке!<C:0003,0001,>",
      "tokenized_text": "Добро пожаловать в наш филиал в...\nгм... в загадочном и мрачном замке!<C:0003,0001,>",
      "original_text": "Добро пожаловать в наш филиал в...\nгм... в загадочном и мрачном замке!<C:0003,0001,>",
      "original_tokenized_text": "Добро пожаловать в наш филиал в...\nгм... в загадочном и мрачном замке!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "8": {
      "text": "Если уж вас сюда занесло,\nзначит, плохи ваши дела!<C:0003,0001,>",
      "tokenized_text": "Если уж вас сюда занесло,\nзначит, плохи ваши дела!<C:0003,0001,>",
      "original_text": "Если уж вас сюда занесло,\nзначит, плохи ваши дела!<C:0003,0001,>",
      "original_tokenized_text": "Если уж вас сюда занесло,\nзначит, плохи ваши дела!<C:0003,0001,>",
      "raw_full_hex": "150441043B0438042000430436042000320430044104200041044E04340430042000370430043D04350441043B043E042C000A0037043D0430044704380442042C0020003F043B043E0445043804200032043004480438042000340435043B04300421000E000300010000000000"
    },
    "9": {
      "text": "А раз так — можно содрать\nс вас побольше, хе-хе!!!<C:0003,0001,><C:0000,0004,>Платите, а не то будете\nплакать горючими слезами!<C:0003,0001,>",
      "tokenized_text": "А раз так — можно содрать\nс вас побольше, хе-хе!!!<C:0003,0001,><C:0000,0004,>Платите, а не то будете\nплакать горючими слезами!<C:0003,0001,>",
      "original_text": "А раз так — можно содрать\nс вас побольше, хе-хе!!!<C:0003,0001,><C:0000,0004,>Платите, а не то будете\nплакать горючими слезами!<C:0003,0001,>",
      "original_tokenized_text": "А раз так — можно содрать\nс вас побольше, хе-хе!!!<C:0003,0001,><C:0000,0004,>Платите, а не то будете\nплакать горючими слезами!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "10": {
      "text": "<C:0007,0000,>Чего изволите?<C:0003,0000,0A00>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Предметы.\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Вещи.<C:0000,0003,FFFFFFFF><C:0000,0003,000000FF>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Засыпучино.<C:0001,0002,>         <C:0005,0001,>Ну, мы пойдем.<C:0003,0000,0A00>",
      "tokenized_text": "<C:0007,0000,>Чего изволите?<C:0003,0000,0A00>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Предметы.\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Вещи.<C:0000,0003,FFFFFFFF><C:0000,0003,000000FF>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Засыпучино.<C:0001,0002,>         <C:0005,0001,>Ну, мы пойдем.<C:0003,0000,0A00>",
      "original_text": "<C:0007,0000,>Чего изволите?<C:0003,0000,0A00>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Предметы.\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Вещи.<C:0000,0003,FFFFFFFF><C:0000,0003,000000FF>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Засыпучино.<C:0001,0002,>         <C:0005,0001,>Ну, мы пойдем.<C:0003,0000,0A00>",
      "original_tokenized_text": "<C:0007,0000,>Чего изволите?<C:0003,0000,0A00>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Предметы.\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Вещи.<C:0000,0003,FFFFFFFF><C:0000,0003,000000FF>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Засыпучино.<C:0001,0002,>         <C:0005,0001,>Ну, мы пойдем.<C:0003,0000,0A00>",
      "raw_full_hex": ""
    },
    "11": {
      "text": "<C:0007,0000,>Может, что-то еще?<C:0003,0000,0A00>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Предметы.\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Вещи.<C:0000,0003,FFFFFFFF><C:0000,0003,000000FF>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Засыпучино.<C:0001,0002,>         <C:0005,0001,>Ну, мы пойдем.<C:0003,0000,0A00>",
      "tokenized_text": "<C:0007,0000,>Может, что-то еще?<C:0003,0000,0A00>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Предметы.\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Вещи.<C:0000,0003,FFFFFFFF><C:0000,0003,000000FF>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Засыпучино.<C:0001,0002,>         <C:0005,0001,>Ну, мы пойдем.<C:0003,0000,0A00>",
      "original_text": "<C:0007,0000,>Может, что-то еще?<C:0003,0000,0A00>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Предметы.\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Вещи.<C:0000,0003,FFFFFFFF><C:0000,0003,000000FF>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Засыпучино.<C:0001,0002,>         <C:0005,0001,>Ну, мы пойдем.<C:0003,0000,0A00>",
      "original_tokenized_text": "<C:0007,0000,>Может, что-то еще?<C:0003,0000,0A00>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Предметы.\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Вещи.<C:0000,0003,FFFFFFFF><C:0000,0003,000000FF>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Засыпучино.<C:0001,0002,>         <C:0005,0001,>Ну, мы пойдем.<C:0003,0000,0A00>",
      "raw_full_hex": ""
    },
    "12": {
      "text": "<C:0007,0000,>С вас <C:0000,0003,2C65FFFF>10 <C:0000,0003,000000FF>монеток.<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Дороговато.         <C:0005,0001,>По рукам.<C:0003,0000,0A00>",
      "tokenized_text": "<C:0007,0000,>С вас <C:0000,0003,2C65FFFF>10 <C:0000,0003,000000FF>монеток.<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Дороговато.         <C:0005,0001,>По рукам.<C:0003,0000,0A00>",
      "original_text": "<C:0007,0000,>С вас <C:0000,0003,2C65FFFF>10 <C:0000,0003,000000FF>монеток.<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Дороговато.         <C:0005,0001,>По рукам.<C:0003,0000,0A00>",
      "original_tokenized_text": "<C:0007,0000,>С вас <C:0000,0003,2C65FFFF>10 <C:0000,0003,000000FF>монеток.<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Дороговато.         <C:0005,0001,>По рукам.<C:0003,0000,0A00>",
      "raw_full_hex": ""
    },
