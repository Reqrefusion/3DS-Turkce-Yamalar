    },
    "7": {
      "text": "<C:0001,0004,><C:0000,0002,9600>Снов повелительница!<C:0000,0002,6400><C:0003,0000,1E00>",
      "tokenized_text": "<C:0001,0004,><C:0000,0002,9600>Снов повелительница!<C:0000,0002,6400><C:0003,0000,1E00>",
      "original_text": "<C:0001,0004,><C:0000,0002,9600>Снов повелительница!<C:0000,0002,6400><C:0003,0000,1E00>",
      "original_tokenized_text": "<C:0001,0004,><C:0000,0002,9600>Снов повелительница!<C:0000,0002,6400><C:0003,0000,1E00>",
      "raw_full_hex": "0E000100040000000E00000002000200960021043D043E04320420003F043E04320435043B043804420435043B044C043D0438044604300421000E0000000200020064000E000300000002001E000000"
    },
    "8": {
      "text": "<C:0001,0004,>Ого!<C:0003,0000,0A00> Это ж павлин\nрасфуфыренный!<C:0003,0001,><C:0000,0004,>Я думала, божество\nбудет поскромнее...<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Ого!<C:0003,0000,0A00> Это ж павлин\nрасфуфыренный!<C:0003,0001,><C:0000,0004,>Я думала, божество\nбудет поскромнее...<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Ого!<C:0003,0000,0A00> Это ж павлин\nрасфуфыренный!<C:0003,0001,><C:0000,0004,>Я думала, божество\nбудет поскромнее...<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Ого!<C:0003,0000,0A00> Это ж павлин\nрасфуфыренный!<C:0003,0001,><C:0000,0004,>Я думала, божество\nбудет поскромнее...<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "9": {
      "text": "<C:0001,0004,>О, кто-то поражен\nдо глубины души!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>О, кто-то поражен\nдо глубины души!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>О, кто-то поражен\nдо глубины души!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>О, кто-то поражен\nдо глубины души!<C:0003,0001,>",
      "raw_full_hex": "0E000100040000001E042C0020003A0442043E042D0042043E0420003F043E0440043004360435043D040A0034043E04200033043B044304310438043D044B042000340443044804380421000E000300010000000000"
    },
    "10": {
      "text": "<C:0001,0004,>Э?!<C:0003,0000,0F00> Ф-ф-ф!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Э?!<C:0003,0000,0F00> Ф-ф-ф!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Э?!<C:0003,0000,0F00> Ф-ф-ф!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Э?!<C:0003,0000,0F00> Ф-ф-ф!<C:0003,0001,>",
      "raw_full_hex": "0E000100040000002D043F0021000E000300000002000F00200024042D0044042D00440421000E000300010000000000"
    },
    "11": {
      "text": "<C:0001,0004,>Я чу-у-ю...<C:0003,0000,0A00>\nЧую запах!!!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Я чу-у-ю...<C:0003,0000,0A00>\nЧую запах!!!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Я чу-у-ю...<C:0003,0000,0A00>\nЧую запах!!!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Я чу-у-ю...<C:0003,0000,0A00>\nЧую запах!!!<C:0003,0001,>",
