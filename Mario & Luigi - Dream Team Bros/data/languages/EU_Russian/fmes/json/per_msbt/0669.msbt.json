    },
    "4": {
      "text": "<C:0001,0004,><C:0000,0002,9600>Внемлите!<C:0000,0002,6400><C:0003,0000,1E00>",
      "tokenized_text": "<C:0001,0004,><C:0000,0002,9600>Внемлите!<C:0000,0002,6400><C:0003,0000,1E00>",
      "original_text": "<C:0001,0004,><C:0000,0002,9600>Внемлите!<C:0000,0002,6400><C:0003,0000,1E00>",
      "original_tokenized_text": "<C:0001,0004,><C:0000,0002,9600>Внемлите!<C:0000,0002,6400><C:0003,0000,1E00>",
      "raw_full_hex": "0E000100040000000E00000002000200960012043D0435043C043B0438044204350421000E0000000200020064000E000300000002001E000000"
    },
    "5": {
      "text": "<C:0001,0004,>Приветствую, почитатели!\nПадите ниц передо мной!<C:0003,0001,><C:0000,0004,>Я великая Сон-птица —\nвладычица грез!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Приветствую, почитатели!\nПадите ниц передо мной!<C:0003,0001,><C:0000,0004,>Я великая Сон-птица —\nвладычица грез!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Приветствую, почитатели!\nПадите ниц передо мной!<C:0003,0001,><C:0000,0004,>Я великая Сон-птица —\nвладычица грез!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Приветствую, почитатели!\nПадите ниц передо мной!<C:0003,0001,><C:0000,0004,>Я великая Сон-птица —\nвладычица грез!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "6": {
      "text": "<C:0001,0004,>Спасительница,\nхранительница,\nпокровительница...<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Спасительница,\nхранительница,\nпокровительница...<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Спасительница,\nхранительница,\nпокровительница...<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Спасительница,\nхранительница,\nпокровительница...<C:0003,0001,>",
