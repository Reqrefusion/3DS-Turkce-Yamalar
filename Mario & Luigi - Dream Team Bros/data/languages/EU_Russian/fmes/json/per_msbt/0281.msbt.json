    "54": {
      "text": "<C:0000,0002,9600><C:0001,0004,>Поторопись!<C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,9600><C:0001,0004,>Поторопись!<C:0003,0001,><C:0000,0002,6400>",
