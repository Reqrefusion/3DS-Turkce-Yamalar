    "15": {
      "text": "<C:0001,0004,><C:0000,0003,2C65FFFF>Победите только\nконтратаками!<C:0000,0003,000000FF><C:0000,0003,2C65FFFF><C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0001,0004,><C:0000,0003,2C65FFFF>Победите только\nконтратаками!<C:0000,0003,000000FF><C:0000,0003,2C65FFFF><C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0001,0004,><C:0000,0003,2C65FFFF>Победите только\nконтратаками!<C:0000,0003,000000FF><C:0000,0003,2C65FFFF><C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0001,0004,><C:0000,0003,2C65FFFF>Победите только\nконтратаками!<C:0000,0003,000000FF><C:0000,0003,2C65FFFF><C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": "0E000100040000000E000000030004002C65FFFF1F043E04310435043404380442043504200042043E043B044C043A043E040A003A043E043D04420440043004420430043A0430043C04380421000E00000003000400000000FF0E000000030004002C65FFFF0E000300010000000E00000003000400000000FF0000"
    },
    "16": {
      "text": "<C:0001,0004,>Атаковати в бою —\nнельзя! Совсем!<C:0000,0003,2C65FFFF><C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0001,0004,>Атаковати в бою —\nнельзя! Совсем!<C:0000,0003,2C65FFFF><C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0001,0004,>Атаковати в бою —\nнельзя! Совсем!<C:0000,0003,2C65FFFF><C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0001,0004,>Атаковати в бою —\nнельзя! Совсем!<C:0000,0003,2C65FFFF><C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": "0E000100040000001004420430043A043E04320430044204380420003204200031043E044E04200014200A003D0435043B044C0437044F042100200021043E043204410435043C0421000E000000030004002C65FFFF0E000300010000000E00000003000400000000FF0000"
    },
    "17": {
      "text": "<C:0001,0004,>Тильки бейте противника,\nкогда он сам атакует!!!<C:0000,0003,2C65FFFF><C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0001,0004,>Тильки бейте противника,\nкогда он сам атакует!!!<C:0000,0003,2C65FFFF><C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0001,0004,>Тильки бейте противника,\nкогда он сам атакует!!!<C:0000,0003,2C65FFFF><C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0001,0004,>Тильки бейте противника,\nкогда он сам атакует!!!<C:0000,0003,2C65FFFF><C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": "0E00010004000000220438043B044C043A04380420003104350439044204350420003F0440043E044204380432043D0438043A0430042C000A003A043E0433043404300420003E043D042000410430043C0420003004420430043A044304350442042100210021000E000000030004002C65FFFF0E000300010000000E00000003000400000000FF0000"
    },
    "18": {
      "text": "<C:0001,0004,>Из предметов може\nиспользовать тильки лечилки!<C:0000,0003,2C65FFFF><C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0001,0004,>Из предметов може\nиспользовать тильки лечилки!<C:0000,0003,2C65FFFF><C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0001,0004,>Из предметов може\nиспользовать тильки лечилки!<C:0000,0003,2C65FFFF><C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0001,0004,>Из предметов може\nиспользовать тильки лечилки!<C:0000,0003,2C65FFFF><C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": "0E000100040000001804370420003F044004350434043C04350442043E04320420003C043E04360435040A00380441043F043E043B044C0437043E043204300442044C042000420438043B044C043A04380420003B043504470438043B043A04380421000E000000030004002C65FFFF0E000300010000000E00000003000400000000FF0000"
