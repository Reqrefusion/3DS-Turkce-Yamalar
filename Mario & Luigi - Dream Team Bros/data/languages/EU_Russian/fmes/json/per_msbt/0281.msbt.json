    },
    "55": {
      "text": "<C:0000,0002,6400><C:0001,0004,>Да вас реально\nждать устанешь!<C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Да вас реально\nждать устанешь!<C:0003,0001,><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,6400><C:0001,0004,>Да вас реально\nждать устанешь!<C:0003,0001,><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Да вас реально\nждать устанешь!<C:0003,0001,><C:0000,0002,6400>",
      "raw_full_hex": "0E0000000200020064000E0001000400000014043004200032043004410420004004350430043B044C043D043E040A0036043404300442044C04200043044104420430043D04350448044C0421000E000300010000000E0000000200020064000000"
    },
    "56": {
      "text": "<C:0001,0004,>Да я могу вас даже\nпузом отметелить!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Да я могу вас даже\nпузом отметелить!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Да я могу вас даже\nпузом отметелить!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Да я могу вас даже\nпузом отметелить!<C:0003,0001,>",
