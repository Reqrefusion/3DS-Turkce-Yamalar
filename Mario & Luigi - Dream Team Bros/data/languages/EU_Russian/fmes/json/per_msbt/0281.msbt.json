      "original_text": "",
      "original_tokenized_text": "",
      "raw_full_hex": "0000"
    },
    "37": {
      "text": "<C:0001,0004,>Настал час поздравлений!\nВсех чотвирих победили!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Настал час поздравлений!\nВсех чотвирих победили!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Настал час поздравлений!\nВсех чотвирих победили!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Настал час поздравлений!\nВсех чотвирих победили!<C:0003,0001,>",
      "raw_full_hex": "0E000100040000001D0430044104420430043B04200047043004410420003F043E04370434044004300432043B0435043D043804390421000A001204410435044504200047043E0442043204380440043804450420003F043E0431043504340438043B04380421000E000300010000000000"
    },
