    },
    "17": {
      "text": "<C:0001,0004,>Это еще...<C:0003,0000,0A00> что такое?!<C:0003,0000,0A00>\nЗамок по небу летал!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Это еще...<C:0003,0000,0A00> что такое?!<C:0003,0000,0A00>\nЗамок по небу летал!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Это еще...<C:0003,0000,0A00> что такое?!<C:0003,0000,0A00>\nЗамок по небу летал!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Это еще...<C:0003,0000,0A00> что такое?!<C:0003,0000,0A00>\nЗамок по небу летал!<C:0003,0001,>",
      "raw_full_hex": "0E000100040000002D0442043E0420003504490435042E002E002E000E000300000002000A002000470442043E042000420430043A043E0435043F0021000E000300000002000A000A00170430043C043E043A0420003F043E0420003D0435043104430420003B043504420430043B0421000E000300010000000000"
    },
    "18": {
      "text": "<C:0001,0004,>Этот замок...<C:0003,0000,0A00> Он уже\nдавненько не двигался...<C:0003,0001,><C:0000,0004,>Минуточку!<C:0003,0000,0A00>\nНу-ка стоп!<C:0003,0001,><C:0000,0004,>Вам сюда нельзя!\nВыйдите, прошу!<C:0003,0001,><C:0000,0004,>Это комната для\nотдыха персонала.<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Этот замок...<C:0003,0000,0A00> Он уже\nдавненько не двигался...<C:0003,0001,><C:0000,0004,>Минуточку!<C:0003,0000,0A00>\nНу-ка стоп!<C:0003,0001,><C:0000,0004,>Вам сюда нельзя!\nВыйдите, прошу!<C:0003,0001,><C:0000,0004,>Это комната для\nотдыха персонала.<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Этот замок...<C:0003,0000,0A00> Он уже\nдавненько не двигался...<C:0003,0001,><C:0000,0004,>Минуточку!<C:0003,0000,0A00>\nНу-ка стоп!<C:0003,0001,><C:0000,0004,>Вам сюда нельзя!\nВыйдите, прошу!<C:0003,0001,><C:0000,0004,>Это комната для\nотдыха персонала.<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Этот замок...<C:0003,0000,0A00> Он уже\nдавненько не двигался...<C:0003,0001,><C:0000,0004,>Минуточку!<C:0003,0000,0A00>\nНу-ка стоп!<C:0003,0001,><C:0000,0004,>Вам сюда нельзя!\nВыйдите, прошу!<C:0003,0001,><C:0000,0004,>Это комната для\nотдыха персонала.<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "19": {
      "text": "<C:0001,0004,>Эй-эй-эй!<C:0003,0001,><C:0000,0004,>Держите!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Эй-эй-эй!<C:0003,0001,><C:0000,0004,>Держите!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Эй-эй-эй!<C:0003,0001,><C:0000,0004,>Держите!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Эй-эй-эй!<C:0003,0001,><C:0000,0004,>Держите!<C:0003,0001,>",
      "raw_full_hex": "0E000100040000002D0439042D004D0439042D004D04390421000E000300010000000E00000004000000140435044004360438044204350421000E000300010000000000"
    },
    "20": {
      "text": "<C:0001,0004,>Спасибо! Вы\nочень помо...<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Спасибо! Вы\nочень помо...<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Спасибо! Вы\nочень помо...<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Спасибо! Вы\nочень помо...<C:0003,0001,>",
      "raw_full_hex": "0E0001000400000021043F0430044104380431043E042100200012044B040A003E04470435043D044C0420003F043E043C043E042E002E002E000E000300010000000000"
    },
    "21": {
      "text": "<C:0001,0004,><C:0000,0002,9600>УХ ТЫ!<C:0000,0002,6400><C:0003,0000,1E00>",
      "tokenized_text": "<C:0001,0004,><C:0000,0002,9600>УХ ТЫ!<C:0000,0002,6400><C:0003,0000,1E00>",
      "original_text": "<C:0001,0004,><C:0000,0002,9600>УХ ТЫ!<C:0000,0002,6400><C:0003,0000,1E00>",
      "original_tokenized_text": "<C:0001,0004,><C:0000,0002,9600>УХ ТЫ!<C:0000,0002,6400><C:0003,0000,1E00>",
      "raw_full_hex": "0E000100040000000E00000002000200960023042504200022042B0421000E0000000200020064000E000300000002001E000000"
    },
    "22": {
      "text": "<C:0001,0004,>Ой.<C:0003,0000,0A00> ОЙ!<C:0003,0000,0A00> ОЙ!!!<C:0003,0000,0A00>\nГости!<C:0003,0001,><C:0000,0004,>Ах!<C:0003,0000,0A00> Э-э... Да.<C:0003,0001,><C:0000,0004,>Вы видели?<C:0003,0000,0A00>\nНу да, конечно, видели.<C:0003,0001,><C:0000,0004,>Только, пожалуйста,\nникому ни слова!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Ой.<C:0003,0000,0A00> ОЙ!<C:0003,0000,0A00> ОЙ!!!<C:0003,0000,0A00>\nГости!<C:0003,0001,><C:0000,0004,>Ах!<C:0003,0000,0A00> Э-э... Да.<C:0003,0001,><C:0000,0004,>Вы видели?<C:0003,0000,0A00>\nНу да, конечно, видели.<C:0003,0001,><C:0000,0004,>Только, пожалуйста,\nникому ни слова!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Ой.<C:0003,0000,0A00> ОЙ!<C:0003,0000,0A00> ОЙ!!!<C:0003,0000,0A00>\nГости!<C:0003,0001,><C:0000,0004,>Ах!<C:0003,0000,0A00> Э-э... Да.<C:0003,0001,><C:0000,0004,>Вы видели?<C:0003,0000,0A00>\nНу да, конечно, видели.<C:0003,0001,><C:0000,0004,>Только, пожалуйста,\nникому ни слова!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Ой.<C:0003,0000,0A00> ОЙ!<C:0003,0000,0A00> ОЙ!!!<C:0003,0000,0A00>\nГости!<C:0003,0001,><C:0000,0004,>Ах!<C:0003,0000,0A00> Э-э... Да.<C:0003,0001,><C:0000,0004,>Вы видели?<C:0003,0000,0A00>\nНу да, конечно, видели.<C:0003,0001,><C:0000,0004,>Только, пожалуйста,\nникому ни слова!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "23": {
      "text": "<C:0001,0004,>Кар-р-р!<C:0003,0001,><C:0000,0004,>Я кумир местных жителей,\nвеликая Сон-птица!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Кар-р-р!<C:0003,0001,><C:0000,0004,>Я кумир местных жителей,\nвеликая Сон-птица!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Кар-р-р!<C:0003,0001,><C:0000,0004,>Я кумир местных жителей,\nвеликая Сон-птица!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Кар-р-р!<C:0003,0001,><C:0000,0004,>Я кумир местных жителей,\nвеликая Сон-птица!<C:0003,0001,>",
      "raw_full_hex": "0E000100040000001A04300440042D0040042D00400421000E000300010000000E000000040000002F0420003A0443043C043804400420003C043504410442043D044B044504200036043804420435043B04350439042C000A00320435043B0438043A0430044F04200021043E043D042D003F04420438044604300421000E000300010000000000"
    },
    "24": {
      "text": "<C:0001,0004,><C:0000,0002,9600>Только ш-ш-ш!<C:0000,0002,6400><C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,><C:0000,0002,9600>Только ш-ш-ш!<C:0000,0002,6400><C:0003,0001,>",
      "original_text": "<C:0001,0004,><C:0000,0002,9600>Только ш-ш-ш!<C:0000,0002,6400><C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,><C:0000,0002,9600>Только ш-ш-ш!<C:0000,0002,6400><C:0003,0001,>",
      "raw_full_hex": "0E000100040000000E00000002000200960022043E043B044C043A043E04200048042D0048042D00480421000E0000000200020064000E000300010000000000"
    },
    "25": {
      "text": "<C:0001,0004,>Эй, вы новенькие?<C:0003,0001,><C:0000,0004,>Я здесь недавно работаю!<C:0003,0001,><C:0000,0004,>Приятно познакомиться!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Эй, вы новенькие?<C:0003,0001,><C:0000,0004,>Я здесь недавно работаю!<C:0003,0001,><C:0000,0004,>Приятно познакомиться!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Эй, вы новенькие?<C:0003,0001,><C:0000,0004,>Я здесь недавно работаю!<C:0003,0001,><C:0000,0004,>Приятно познакомиться!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Эй, вы новенькие?<C:0003,0001,><C:0000,0004,>Я здесь недавно работаю!<C:0003,0001,><C:0000,0004,>Приятно познакомиться!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "26": {
      "text": "<C:0001,0004,>Так вот, эти усатые месье\nсовершенно сходить с ума!<C:0003,0001,><C:0000,0004,>Вы знать, что они делать?\nОни бить блоки! Бить ля блок!<C:0003,0001,><C:0000,0004,>Что может быть ужаснее?!\nЛя бессердечные глупцы!<C:0003,0001,><C:0000,0004,>Месье Дюблок должен быть\nвежлив, но моя душа рыдать!<C:0003,0001,><C:0000,0004,>Моя воля, я бы сказать этой\nпарочке: «Адью, блокобойцы»!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Так вот, эти усатые месье\nсовершенно сходить с ума!<C:0003,0001,><C:0000,0004,>Вы знать, что они делать?\nОни бить блоки! Бить ля блок!<C:0003,0001,><C:0000,0004,>Что может быть ужаснее?!\nЛя бессердечные глупцы!<C:0003,0001,><C:0000,0004,>Месье Дюблок должен быть\nвежлив, но моя душа рыдать!<C:0003,0001,><C:0000,0004,>Моя воля, я бы сказать этой\nпарочке: «Адью, блокобойцы»!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Так вот, эти усатые месье\nсовершенно сходить с ума!<C:0003,0001,><C:0000,0004,>Вы знать, что они делать?\nОни бить блоки! Бить ля блок!<C:0003,0001,><C:0000,0004,>Что может быть ужаснее?!\nЛя бессердечные глупцы!<C:0003,0001,><C:0000,0004,>Месье Дюблок должен быть\nвежлив, но моя душа рыдать!<C:0003,0001,><C:0000,0004,>Моя воля, я бы сказать этой\nпарочке: «Адью, блокобойцы»!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Так вот, эти усатые месье\nсовершенно сходить с ума!<C:0003,0001,><C:0000,0004,>Вы знать, что они делать?\nОни бить блоки! Бить ля блок!<C:0003,0001,><C:0000,0004,>Что может быть ужаснее?!\nЛя бессердечные глупцы!<C:0003,0001,><C:0000,0004,>Месье Дюблок должен быть\nвежлив, но моя душа рыдать!<C:0003,0001,><C:0000,0004,>Моя воля, я бы сказать этой\nпарочке: «Адью, блокобойцы»!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "27": {
      "text": "<C:0001,0004,>Хо?<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Хо?<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Хо?<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Хо?<C:0003,0001,>",
      "raw_full_hex": "0E0001000400000025043E043F000E000300010000000000"
    },
    "28": {
      "text": "<C:0001,0004,><C:0000,0002,9600>О-ля-ля!<C:0000,0002,6400><C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,><C:0000,0002,9600>О-ля-ля!<C:0000,0002,6400><C:0003,0001,>",
      "original_text": "<C:0001,0004,><C:0000,0002,9600>О-ля-ля!<C:0000,0002,6400><C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,><C:0000,0002,9600>О-ля-ля!<C:0000,0002,6400><C:0003,0001,>",
      "raw_full_hex": "0E000100040000000E0000000200020096001E042D003B044F042D003B044F0421000E0000000200020064000E000300010000000000"
    },
    "29": {
      "text": "<C:0001,0004,>О...<C:0003,0000,0A00> Месье...<C:0003,0001,><C:0000,0004,>Ваши... усы... сегодня\nпросто они блистать!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>О...<C:0003,0000,0A00> Месье...<C:0003,0001,><C:0000,0004,>Ваши... усы... сегодня\nпросто они блистать!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>О...<C:0003,0000,0A00> Месье...<C:0003,0001,><C:0000,0004,>Ваши... усы... сегодня\nпросто они блистать!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>О...<C:0003,0000,0A00> Месье...<C:0003,0001,><C:0000,0004,>Ваши... усы... сегодня\nпросто они блистать!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "30": {
      "text": "<C:0001,0004,>И...<C:0003,0000,0A00> Все мы...\nОх-хо...<C:0003,0001,><C:0000,0004,>Все мы рассчитывать\nна вас, месье!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>И...<C:0003,0000,0A00> Все мы...\nОх-хо...<C:0003,0001,><C:0000,0004,>Все мы рассчитывать\nна вас, месье!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>И...<C:0003,0000,0A00> Все мы...\nОх-хо...<C:0003,0001,><C:0000,0004,>Все мы рассчитывать\nна вас, месье!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>И...<C:0003,0000,0A00> Все мы...\nОх-хо...<C:0003,0001,><C:0000,0004,>Все мы рассчитывать\nна вас, месье!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "31": {
      "text": "<C:0001,0004,>О...<C:0003,0000,0A00> Оревуар...<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>О...<C:0003,0000,0A00> Оревуар...<C:0003,0001,>",
      "original_text": "<C:0001,0004,>О...<C:0003,0000,0A00> Оревуар...<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>О...<C:0003,0000,0A00> Оревуар...<C:0003,0001,>",
      "raw_full_hex": "0E000100040000001E042E002E002E000E000300000002000A0020001E044004350432044304300440042E002E002E000E000300010000000000"
    },
    "32": {
      "text": "<C:0001,0004,>У месье Дюблока такое лицо,<C:0000,0002,6400>\nкак будто он лимон съел...<C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "<C:0001,0004,>У месье Дюблока такое лицо,<C:0000,0002,6400>\nкак будто он лимон съел...<C:0003,0001,><C:0000,0002,6400>",
      "original_text": "<C:0001,0004,>У месье Дюблока такое лицо,<C:0000,0002,6400>\nкак будто он лимон съел...<C:0003,0001,><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0001,0004,>У месье Дюблока такое лицо,<C:0000,0002,6400>\nкак будто он лимон съел...<C:0003,0001,><C:0000,0002,6400>",
      "raw_full_hex": "0E00010004000000230420003C04350441044C043504200014044E0431043B043E043A0430042000420430043A043E04350420003B04380446043E042C000E0000000200020064000A003A0430043A04200031044304340442043E0420003E043D0420003B0438043C043E043D04200041044A0435043B042E002E002E000E000300010000000E0000000200020064000000"
    },
    "33": {
      "text": "<C:0001,0004,>Да нет...<C:0003,0000,0A00> Не лимон,\nа огромный лимонище...<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Да нет...<C:0003,0000,0A00> Не лимон,\nа огромный лимонище...<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Да нет...<C:0003,0000,0A00> Не лимон,\nа огромный лимонище...<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Да нет...<C:0003,0000,0A00> Не лимон,\nа огромный лимонище...<C:0003,0001,>",
      "raw_full_hex": "0E000100040000001404300420003D04350442042E002E002E000E000300000002000A0020001D04350420003B0438043C043E043D042C000A00300420003E04330440043E043C043D044B04390420003B0438043C043E043D043804490435042E002E002E000E000300010000000000"
    },
    "34": {
