    },
    "8": {
      "text": "<C:0001,0004,>Ого-го! Месье Дюблок\nреально крутой!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Ого-го! Месье Дюблок\nреально крутой!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Ого-го! Месье Дюблок\nреально крутой!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Ого-го! Месье Дюблок\nреально крутой!<C:0003,0001,>",
      "raw_full_hex": "0E000100040000001E0433043E042D0033043E04210020001C04350441044C043504200014044E0431043B043E043A040A004004350430043B044C043D043E0420003A044004430442043E04390421000E000300010000000000"
    },
    "9": {
      "text": "<C:0001,0004,>Круче него на острове\nникого не найти!<C:0003,0001,>",
