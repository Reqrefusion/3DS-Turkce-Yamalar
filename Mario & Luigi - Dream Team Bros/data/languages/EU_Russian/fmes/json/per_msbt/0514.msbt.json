    },
    "12": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Ого!<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Ого!<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Ого!<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Ого!<C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": "0E00000003000400000000FF0E000100040000001E0433043E0421000E000300010000000E00000003000400000000FF0000"
    },
    "13": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Друзья, скорее!\nБежим прочь!<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Друзья, скорее!\nБежим прочь!<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Друзья, скорее!\nБежим прочь!<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Друзья, скорее!\nБежим прочь!<C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": "0E00000003000400000000FF0E0001000400000014044004430437044C044F042C00200041043A043E0440043504350421000A0011043504360438043C0420003F0440043E0447044C0421000E000300010000000E00000003000400000000FF0000"
    },
