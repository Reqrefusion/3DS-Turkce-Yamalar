    "17": {
      "text": "<C:0000,0003,000000FF><C:0000,0002,C800><C:0001,0004,>Кто же дерзнул\nпробудить меня?<C:0000,0003,000000FF><C:0000,0002,C800><C:0000,0003,000000FF><C:0000,0002,C800><C:0003,0000,5000><C:0000,0002,C800><C:0000,0003,000000FF><C:0000,0002,C800><C:0000,0003,000000FF><C:0000,0002,6400><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0000,0002,C800><C:0001,0004,>Кто же дерзнул\nпробудить меня?<C:0000,0003,000000FF><C:0000,0002,C800><C:0000,0003,000000FF><C:0000,0002,C800><C:0003,0000,5000><C:0000,0002,C800><C:0000,0003,000000FF><C:0000,0002,C800><C:0000,0003,000000FF><C:0000,0002,6400><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0000,0002,C800><C:0001,0004,>Кто же дерзнул\nпробудить меня?<C:0000,0003,000000FF><C:0000,0002,C800><C:0000,0003,000000FF><C:0000,0002,C800><C:0003,0000,5000><C:0000,0002,C800><C:0000,0003,000000FF><C:0000,0002,C800><C:0000,0003,000000FF><C:0000,0002,6400><C:0000,0003,000000FF>",
