    "5": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Все ли в порядке?!<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Все ли в порядке?!<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Все ли в порядке?!<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Все ли в порядке?!<C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": "0E00000003000400000000FF0E0001000400000012044104350420003B0438042000320420003F043E0440044F0434043A0435043F0021000E000300010000000E00000003000400000000FF0000"
