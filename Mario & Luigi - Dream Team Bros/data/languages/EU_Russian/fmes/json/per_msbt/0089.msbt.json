      "text": "<C:0001,0004,>Уф...<C:0003,0000,0A00> Уф...<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Уф...<C:0003,0000,0A00> Уф...<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Уф...<C:0003,0000,0A00> Уф...<C:0003,0001,>",
