      "original_tokenized_text": "<C:0000,0002,9600><C:0000,0003,000000FF><C:0001,0001,><C:0000,0003,000000FF><C:0000,0002,6400>Да, шеф<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400>!<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400>",
      "raw_full_hex": ""
    },
    "15": {
      "text": "<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0001,0001,>О! Здорово,\nребятки<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400>!<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0001,0001,>О! Здорово,\nребятки<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400>!<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0001,0001,>О! Здорово,\nребятки<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400>!<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0001,0001,>О! Здорово,\nребятки<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400>!<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400>",
      "raw_full_hex": ""
    },
    "16": {
      "text": "Что тут у меня?\nДа вот закавыка!<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400>",
      "tokenized_text": "Что тут у меня?\nДа вот закавыка!<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400>",
      "original_text": "Что тут у меня?\nДа вот закавыка!<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400>",
      "original_tokenized_text": "Что тут у меня?\nДа вот закавыка!<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400>",
      "raw_full_hex": "270442043E0420004204430442042000430420003C0435043D044F043F000A0014043004200032043E0442042000370430043A04300432044B043A04300421000E0000000200020064000E00000003000400000000FF0E0000000200020064000E000300010000000E0000000200020064000E00000003000400000000FF0E0000000200020064000000"
    },
    "17": {
      "text": "<C:0000,0002,9600><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0001,0001,><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,9600>Тупой... тупик!<C:0000,0003,000000FF><C:0003,0000,0A00><C:0000,0003,000000FF><C:0000,0002,6400><C:0000,0002,9600><C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,9600><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0001,0001,><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,9600>Тупой... тупик!<C:0000,0003,000000FF><C:0003,0000,0A00><C:0000,0003,000000FF><C:0000,0002,6400><C:0000,0002,9600><C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,9600><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0001,0001,><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,9600>Тупой... тупик!<C:0000,0003,000000FF><C:0003,0000,0A00><C:0000,0003,000000FF><C:0000,0002,6400><C:0000,0002,9600><C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,9600><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0001,0001,><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,9600>Тупой... тупик!<C:0000,0003,000000FF><C:0003,0000,0A00><C:0000,0003,000000FF><C:0000,0002,6400><C:0000,0002,9600><C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF><C:0000,0002,6400>",
      "raw_full_hex": ""
    },
    "18": {
      "text": "Туда не пройти\nиз-за этой стены!<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Чую, за стеной\nчто-то ценное!<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400>",
      "tokenized_text": "Туда не пройти\nиз-за этой стены!<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Чую, за стеной\nчто-то ценное!<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400>",
      "original_text": "Туда не пройти\nиз-за этой стены!<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Чую, за стеной\nчто-то ценное!<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400>",
      "original_tokenized_text": "Туда не пройти\nиз-за этой стены!<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Чую, за стеной\nчто-то ценное!<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400>",
      "raw_full_hex": ""
    },
    "19": {
      "text": "Эх, если б как-нить\nперепрыгнуть стену...<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400>",
      "tokenized_text": "Эх, если б как-нить\nперепрыгнуть стену...<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400>",
      "original_text": "Эх, если б как-нить\nперепрыгнуть стену...<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400>",
      "original_tokenized_text": "Эх, если б как-нить\nперепрыгнуть стену...<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400>",
      "raw_full_hex": ""
    },
    "20": {
      "text": "Да уж... Перепрыгнешь ее —\nкогда краб на горе свистнет!<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Ладно, нытьем делу\nне поможешь! Пойду я!<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400>",
      "tokenized_text": "Да уж... Перепрыгнешь ее —\nкогда краб на горе свистнет!<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Ладно, нытьем делу\nне поможешь! Пойду я!<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400>",
      "original_text": "Да уж... Перепрыгнешь ее —\nкогда краб на горе свистнет!<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Ладно, нытьем делу\nне поможешь! Пойду я!<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400>",
      "original_tokenized_text": "Да уж... Перепрыгнешь ее —\nкогда краб на горе свистнет!<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Ладно, нытьем делу\nне поможешь! Пойду я!<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400>",
      "raw_full_hex": ""
    },
    "21": {
      "text": "Ах!<C:0003,0000,0F00> Что происходит?<C:0000,0002,6400>\nЯ вернулся! <C:0003,0000,0F00>Я живой!<C:0003,0001,><C:0000,0004,>А я-то уж думал, буду тут\nвечно украшать пустыню...<C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "Ах!<C:0003,0000,0F00> Что происходит?<C:0000,0002,6400>\nЯ вернулся! <C:0003,0000,0F00>Я живой!<C:0003,0001,><C:0000,0004,>А я-то уж думал, буду тут\nвечно украшать пустыню...<C:0003,0001,><C:0000,0002,6400>",
      "original_text": "Ах!<C:0003,0000,0F00> Что происходит?<C:0000,0002,6400>\nЯ вернулся! <C:0003,0000,0F00>Я живой!<C:0003,0001,><C:0000,0004,>А я-то уж думал, буду тут\nвечно украшать пустыню...<C:0003,0001,><C:0000,0002,6400>",
      "original_tokenized_text": "Ах!<C:0003,0000,0F00> Что происходит?<C:0000,0002,6400>\nЯ вернулся! <C:0003,0000,0F00>Я живой!<C:0003,0001,><C:0000,0004,>А я-то уж думал, буду тут\nвечно украшать пустыню...<C:0003,0001,><C:0000,0002,6400>",
      "raw_full_hex": ""
    },
    "22": {
      "text": "Не самые приятные\nмысли, понимаете?<C:0003,0001,><C:0000,0004,>А потому: огромное\nспасибо, что спасли!<C:0003,0001,>",
      "tokenized_text": "Не самые приятные\nмысли, понимаете?<C:0003,0001,><C:0000,0004,>А потому: огромное\nспасибо, что спасли!<C:0003,0001,>",
      "original_text": "Не самые приятные\nмысли, понимаете?<C:0003,0001,><C:0000,0004,>А потому: огромное\nспасибо, что спасли!<C:0003,0001,>",
      "original_tokenized_text": "Не самые приятные\nмысли, понимаете?<C:0003,0001,><C:0000,0004,>А потому: огромное\nспасибо, что спасли!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "23": {
      "text": "<C:0007,0000,>Привет!<C:0003,0000,1400>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Поговори с нами!\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Помоги попасть в мир грез!\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Ну, мы пойдем.",
      "tokenized_text": "<C:0007,0000,>Привет!<C:0003,0000,1400>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Поговори с нами!\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Помоги попасть в мир грез!\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Ну, мы пойдем.",
      "original_text": "<C:0007,0000,>Привет!<C:0003,0000,1400>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Поговори с нами!\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Помоги попасть в мир грез!\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Ну, мы пойдем.",
      "original_tokenized_text": "<C:0007,0000,>Привет!<C:0003,0000,1400>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Поговори с нами!\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Помоги попасть в мир грез!\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Ну, мы пойдем.",
      "raw_full_hex": ""
    },
    "24": {
      "text": "Некогда в пустыне обитал\nсвирепый зверь винторог...<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>А теперь он куда-то пропал.\nЗабурился навсегда, что ли?<C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "Некогда в пустыне обитал\nсвирепый зверь винторог...<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>А теперь он куда-то пропал.\nЗабурился навсегда, что ли?<C:0003,0001,><C:0000,0002,6400>",
      "original_text": "Некогда в пустыне обитал\nсвирепый зверь винторог...<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>А теперь он куда-то пропал.\nЗабурился навсегда, что ли?<C:0003,0001,><C:0000,0002,6400>",
      "original_tokenized_text": "Некогда в пустыне обитал\nсвирепый зверь винторог...<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>А теперь он куда-то пропал.\nЗабурился навсегда, что ли?<C:0003,0001,><C:0000,0002,6400>",
      "raw_full_hex": ""
    },
    "25": {
      "text": "<C:0007,0000,>Отправиться в мир грез?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Нет.         <C:0005,0001,>Да.<C:0003,0000,0A00>",
      "tokenized_text": "<C:0007,0000,>Отправиться в мир грез?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Нет.         <C:0005,0001,>Да.<C:0003,0000,0A00>",
      "original_text": "<C:0007,0000,>Отправиться в мир грез?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Нет.         <C:0005,0001,>Да.<C:0003,0000,0A00>",
      "original_tokenized_text": "<C:0007,0000,>Отправиться в мир грез?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Нет.         <C:0005,0001,>Да.<C:0003,0000,0A00>",
      "raw_full_hex": "0E000700000000001E0442043F04400430043204380442044C0441044F042000320420003C0438044004200033044004350437043F000E000300000002000A000A000E000100010000000E000500010000001D04350442042E002000200020002000200020002000200020000E00050001000000140430042E000E000300000002000A000000"
    },
    "26": {
      "text": "Все засыпайя\nвызволены из беды!<C:0003,0001,><C:0000,0004,>Марио! Луиджи!\nНизкий вам поклон!<C:0003,0001,><C:0000,0004,>Отправимся же скорей\nв <C:0000,0003,2C65FFFF>Заресад <C:0000,0003,000000FF>к <C:0000,0003,2C65FFFF>Мудрогрезу<C:0000,0003,000000FF>.<C:0003,0001,>",
      "tokenized_text": "Все засыпайя\nвызволены из беды!<C:0003,0001,><C:0000,0004,>Марио! Луиджи!\nНизкий вам поклон!<C:0003,0001,><C:0000,0004,>Отправимся же скорей\nв <C:0000,0003,2C65FFFF>Заресад <C:0000,0003,000000FF>к <C:0000,0003,2C65FFFF>Мудрогрезу<C:0000,0003,000000FF>.<C:0003,0001,>",
      "original_text": "Все засыпайя\nвызволены из беды!<C:0003,0001,><C:0000,0004,>Марио! Луиджи!\nНизкий вам поклон!<C:0003,0001,><C:0000,0004,>Отправимся же скорей\nв <C:0000,0003,2C65FFFF>Заресад <C:0000,0003,000000FF>к <C:0000,0003,2C65FFFF>Мудрогрезу<C:0000,0003,000000FF>.<C:0003,0001,>",
      "original_tokenized_text": "Все засыпайя\nвызволены из беды!<C:0003,0001,><C:0000,0004,>Марио! Луиджи!\nНизкий вам поклон!<C:0003,0001,><C:0000,0004,>Отправимся же скорей\nв <C:0000,0003,2C65FFFF>Заресад <C:0000,0003,000000FF>к <C:0000,0003,2C65FFFF>Мудрогрезу<C:0000,0003,000000FF>.<C:0003,0001,>",
      "raw_full_hex": ""
    }
  }
