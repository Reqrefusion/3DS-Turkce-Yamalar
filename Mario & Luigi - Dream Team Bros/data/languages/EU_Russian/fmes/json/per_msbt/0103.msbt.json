    },
    "47": {
      "text": "<C:0000,0002,4B00>Ого-о-о!..<C:0000,0002,6400><C:0003,0000,1E00>",
      "tokenized_text": "<C:0000,0002,4B00>Ого-о-о!..<C:0000,0002,6400><C:0003,0000,1E00>",
      "original_text": "<C:0000,0002,4B00>Ого-о-о!..<C:0000,0002,6400><C:0003,0000,1E00>",
      "original_tokenized_text": "<C:0000,0002,4B00>Ого-о-о!..<C:0000,0002,6400><C:0003,0000,1E00>",
      "raw_full_hex": "0E000000020002004B001E0433043E042D003E042D003E0421002E002E000E0000000200020064000E000300000002001E000000"
    },
    "48": {
      "text": "Глядь! Це руки крушат\nкамень, як палицы!<C:0003,0001,>",
      "tokenized_text": "Глядь! Це руки крушат\nкамень, як палицы!<C:0003,0001,>",
      "original_text": "Глядь! Це руки крушат\nкамень, як палицы!<C:0003,0001,>",
      "original_tokenized_text": "Глядь! Це руки крушат\nкамень, як палицы!<C:0003,0001,>",
