    },
    "45": {
      "text": "<C:0001,0001,><C:0001,0004,><C:0007,0000,><C:0000,0002,9600>Як былинны богатыри!<C:0000,0002,6400><C:0003,0000,3C00>",
      "tokenized_text": "<C:0001,0001,><C:0001,0004,><C:0007,0000,><C:0000,0002,9600>Як былинны богатыри!<C:0000,0002,6400><C:0003,0000,3C00>",
      "original_text": "<C:0001,0001,><C:0001,0004,><C:0007,0000,><C:0000,0002,9600>Як былинны богатыри!<C:0000,0002,6400><C:0003,0000,3C00>",
      "original_tokenized_text": "<C:0001,0001,><C:0001,0004,><C:0007,0000,><C:0000,0002,9600>Як былинны богатыри!<C:0000,0002,6400><C:0003,0000,3C00>",
      "raw_full_hex": "0E000100010000000E000100040000000E000700000000000E0000000200020096002F043A04200031044B043B0438043D043D044B04200031043E043304300442044B044004380421000E0000000200020064000E000300000002003C000000"
    },
    "46": {
      "text": "Ох... А давайте\nуйдем отсюда?<C:0003,0001,>",
      "tokenized_text": "Ох... А давайте\nуйдем отсюда?<C:0003,0001,>",
