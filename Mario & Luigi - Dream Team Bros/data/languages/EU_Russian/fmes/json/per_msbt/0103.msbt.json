    },
    "50": {
      "text": "Даже огроменные каменья\nсмогете зараз двигать!<C:0003,0001,>",
      "tokenized_text": "Даже огроменные каменья\nсмогете зараз двигать!<C:0003,0001,>",
      "original_text": "Даже огроменные каменья\nсмогете зараз двигать!<C:0003,0001,>",
      "original_tokenized_text": "Даже огроменные каменья\nсмогете зараз двигать!<C:0003,0001,>",
      "raw_full_hex": "140430043604350420003E04330440043E043C0435043D043D044B04350420003A0430043C0435043D044C044F040A0041043C043E04330435044204350420003704300440043004370420003404320438043304300442044C0421000E000300010000000000"
    },
    "51": {
      "text": "<C:0001,0001,><C:0001,0004,><C:0007,0000,><C:0000,0002,9600>Як браты Бамбуло!<C:0000,0002,6400>",
      "tokenized_text": "<C:0001,0001,><C:0001,0004,><C:0007,0000,><C:0000,0002,9600>Як браты Бамбуло!<C:0000,0002,6400>",
      "original_text": "<C:0001,0001,><C:0001,0004,><C:0007,0000,><C:0000,0002,9600>Як браты Бамбуло!<C:0000,0002,6400>",
      "original_tokenized_text": "<C:0001,0001,><C:0001,0004,><C:0007,0000,><C:0000,0002,9600>Як браты Бамбуло!<C:0000,0002,6400>",
