    },
    "49": {
      "text": "И вы, як подниметесь,\nбудете гарны мужичищи!<C:0003,0001,>",
      "tokenized_text": "И вы, як подниметесь,\nбудете гарны мужичищи!<C:0003,0001,>",
      "original_text": "И вы, як подниметесь,\nбудете гарны мужичищи!<C:0003,0001,>",
      "original_tokenized_text": "И вы, як подниметесь,\nбудете гарны мужичищи!<C:0003,0001,>",
