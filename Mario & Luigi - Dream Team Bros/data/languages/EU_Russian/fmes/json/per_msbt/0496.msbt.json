      "original_tokenized_text": "<C:0001,0004,>Фантазия Луиджинна<C:0000,0003,000000FF>!<C:0000,0003,000000FF><C:0003,0001,>",
      "raw_full_hex": "0E00010004000000240430043D0442043004370438044F0420001B04430438043404360438043D043D0430040E00000003000400000000FF21000E00000003000400000000FF0E000300010000000000"
    },
    "5": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Что будет, коль\nиспользуем ее?<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Что будет, коль\nиспользуем ее?<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Что будет, коль\nиспользуем ее?<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Что будет, коль\nиспользуем ее?<C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": "0E00000003000400000000FF0E00010004000000270442043E042000310443043404350442042C0020003A043E043B044C040A00380441043F043E043B044C043704430435043C042000350435043F000E000300010000000E00000003000400000000FF0000"
    },
