    "13": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Воспользуемся дивной этой\nсилой, чтоб путь себе открыть!<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Воспользуемся дивной этой\nсилой, чтоб путь себе открыть!<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Воспользуемся дивной этой\nсилой, чтоб путь себе открыть!<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Воспользуемся дивной этой\nсилой, чтоб путь себе открыть!<C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": ""
    },
