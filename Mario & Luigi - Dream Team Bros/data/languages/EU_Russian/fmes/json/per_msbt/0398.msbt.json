  "0398.msbt": {
    "0": {
      "text": "<C:0001,0004,>Храп!<C:0003,0000,0A00> Усоносы!<C:0003,0001,><C:0000,0004,>Усоносы знать,\nчто есть кроты?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Нет.         <C:0005,0001,>Да.<C:0003,0000,0A00>",
      "tokenized_text": "<C:0001,0004,>Храп!<C:0003,0000,0A00> Усоносы!<C:0003,0001,><C:0000,0004,>Усоносы знать,\nчто есть кроты?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Нет.         <C:0005,0001,>Да.<C:0003,0000,0A00>",
      "original_text": "<C:0001,0004,>Храп!<C:0003,0000,0A00> Усоносы!<C:0003,0001,><C:0000,0004,>Усоносы знать,\nчто есть кроты?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Нет.         <C:0005,0001,>Да.<C:0003,0000,0A00>",
      "original_tokenized_text": "<C:0001,0004,>Храп!<C:0003,0000,0A00> Усоносы!<C:0003,0001,><C:0000,0004,>Усоносы знать,\nчто есть кроты?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Нет.         <C:0005,0001,>Да.<C:0003,0000,0A00>",
      "raw_full_hex": ""
    },
    "1": {
      "text": "<C:0001,0004,>Храпонавт как-то\nслышать про крот!<C:0003,0001,><C:0000,0004,>Но храпонавт никогда\nне кушать это... крот!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Храпонавт как-то\nслышать про крот!<C:0003,0001,><C:0000,0004,>Но храпонавт никогда\nне кушать это... крот!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Храпонавт как-то\nслышать про крот!<C:0003,0001,><C:0000,0004,>Но храпонавт никогда\nне кушать это... крот!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Храпонавт как-то\nслышать про крот!<C:0003,0001,><C:0000,0004,>Но храпонавт никогда\nне кушать это... крот!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "2": {
      "text": "<C:0001,0004,>Крот вылезать\nиз-под грязи?!<C:0003,0001,><C:0000,0004,>Фу!<C:0003,0000,0A00> Отвратительно!\nХрапонавт не знать!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Крот вылезать\nиз-под грязи?!<C:0003,0001,><C:0000,0004,>Фу!<C:0003,0000,0A00> Отвратительно!\nХрапонавт не знать!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Крот вылезать\nиз-под грязи?!<C:0003,0001,><C:0000,0004,>Фу!<C:0003,0000,0A00> Отвратительно!\nХрапонавт не знать!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Крот вылезать\nиз-под грязи?!<C:0003,0001,><C:0000,0004,>Фу!<C:0003,0000,0A00> Отвратительно!\nХрапонавт не знать!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "3": {
      "text": "<C:0001,0004,>Находить храпонавт!<C:0003,0001,><C:0000,0004,>Храпонавт вопрос...<C:0003,0001,><C:0000,0004,>Вы<C:0003,0000,0A00> видеть море?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Нет.         <C:0005,0001,>Да.<C:0003,0000,0A00>",
      "tokenized_text": "<C:0001,0004,>Находить храпонавт!<C:0003,0001,><C:0000,0004,>Храпонавт вопрос...<C:0003,0001,><C:0000,0004,>Вы<C:0003,0000,0A00> видеть море?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Нет.         <C:0005,0001,>Да.<C:0003,0000,0A00>",
      "original_text": "<C:0001,0004,>Находить храпонавт!<C:0003,0001,><C:0000,0004,>Храпонавт вопрос...<C:0003,0001,><C:0000,0004,>Вы<C:0003,0000,0A00> видеть море?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Нет.         <C:0005,0001,>Да.<C:0003,0000,0A00>",
      "original_tokenized_text": "<C:0001,0004,>Находить храпонавт!<C:0003,0001,><C:0000,0004,>Храпонавт вопрос...<C:0003,0001,><C:0000,0004,>Вы<C:0003,0000,0A00> видеть море?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Нет.         <C:0005,0001,>Да.<C:0003,0000,0A00>",
      "raw_full_hex": ""
    },
    "4": {
      "text": "<C:0001,0004,>Храп...<C:0003,0000,0A00> Вы не видеть\nсиний-синий море...<C:0003,0001,><C:0000,0004,>Храпонавт мечтать\nвидеть большой море!<C:0003,0001,><C:0000,0004,>Где храпонавт\nпокупать море?<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Храп...<C:0003,0000,0A00> Вы не видеть\nсиний-синий море...<C:0003,0001,><C:0000,0004,>Храпонавт мечтать\nвидеть большой море!<C:0003,0001,><C:0000,0004,>Где храпонавт\nпокупать море?<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Храп...<C:0003,0000,0A00> Вы не видеть\nсиний-синий море...<C:0003,0001,><C:0000,0004,>Храпонавт мечтать\nвидеть большой море!<C:0003,0001,><C:0000,0004,>Где храпонавт\nпокупать море?<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Храп...<C:0003,0000,0A00> Вы не видеть\nсиний-синий море...<C:0003,0001,><C:0000,0004,>Храпонавт мечтать\nвидеть большой море!<C:0003,0001,><C:0000,0004,>Где храпонавт\nпокупать море?<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "5": {
      "text": "<C:0001,0004,>Храпонавт...<C:0003,0000,0A00>\nзавидовать!<C:0003,0001,><C:0000,0004,>Море большой?\nОчень большой?<C:0003,0001,><C:0000,0004,>Море большой,\nчем храпонавт?!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Храпонавт...<C:0003,0000,0A00>\nзавидовать!<C:0003,0001,><C:0000,0004,>Море большой?\nОчень большой?<C:0003,0001,><C:0000,0004,>Море большой,\nчем храпонавт?!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Храпонавт...<C:0003,0000,0A00>\nзавидовать!<C:0003,0001,><C:0000,0004,>Море большой?\nОчень большой?<C:0003,0001,><C:0000,0004,>Море большой,\nчем храпонавт?!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Храпонавт...<C:0003,0000,0A00>\nзавидовать!<C:0003,0001,><C:0000,0004,>Море большой?\nОчень большой?<C:0003,0001,><C:0000,0004,>Море большой,\nчем храпонавт?!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "6": {
      "text": "<C:0001,0004,>Храп вопрос!<C:0003,0000,0A00>\nУсоносы!<C:0003,0001,><C:0000,0004,>Храпонавт иметь\nбольшой вопрос!<C:0003,0001,><C:0000,0004,>Усоносы слышать\nраньше песня?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Нет.         <C:0005,0001,>Да.<C:0003,0000,0A00>",
      "tokenized_text": "<C:0001,0004,>Храп вопрос!<C:0003,0000,0A00>\nУсоносы!<C:0003,0001,><C:0000,0004,>Храпонавт иметь\nбольшой вопрос!<C:0003,0001,><C:0000,0004,>Усоносы слышать\nраньше песня?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Нет.         <C:0005,0001,>Да.<C:0003,0000,0A00>",
      "original_text": "<C:0001,0004,>Храп вопрос!<C:0003,0000,0A00>\nУсоносы!<C:0003,0001,><C:0000,0004,>Храпонавт иметь\nбольшой вопрос!<C:0003,0001,><C:0000,0004,>Усоносы слышать\nраньше песня?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Нет.         <C:0005,0001,>Да.<C:0003,0000,0A00>",
      "original_tokenized_text": "<C:0001,0004,>Храп вопрос!<C:0003,0000,0A00>\nУсоносы!<C:0003,0001,><C:0000,0004,>Храпонавт иметь\nбольшой вопрос!<C:0003,0001,><C:0000,0004,>Усоносы слышать\nраньше песня?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Нет.         <C:0005,0001,>Да.<C:0003,0000,0A00>",
      "raw_full_hex": ""
    },
    "7": {
      "text": "<C:0001,0004,>Вы не слышать «песня»?<C:0003,0001,><C:0000,0004,>Вы мало гулять. Храп!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Вы не слышать «песня»?<C:0003,0001,><C:0000,0004,>Вы мало гулять. Храп!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Вы не слышать «песня»?<C:0003,0001,><C:0000,0004,>Вы мало гулять. Храп!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Вы не слышать «песня»?<C:0003,0001,><C:0000,0004,>Вы мало гулять. Храп!<C:0003,0001,>",
      "raw_full_hex": "0E0001000400000012044B0420003D043504200041043B044B044804300442044C042000AB003F04350441043D044F04BB003F000E000300010000000E0000000400000012044B0420003C0430043B043E042000330443043B044F0442044C042E0020002504400430043F0421000E000300010000000000"
    },
    "8": {
      "text": "<C:0001,0004,>Храп?<C:0003,0000,0A00> Хороший\nзвук из рот?!<C:0003,0001,><C:0000,0004,>Храпонавт\nлюбить!<C:0003,0000,0A00>\nРассказывать\nхрапонавт еще!<C:0003,0001,><C:0000,0004,>Песня<C:0003,0000,0A00> вкусно\nили нет?<C:0003,0001,>",
