    "8": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,><C:0007,0000,>Чего желать месье?<C:0003,0000,0A00> \n<C:0008,0001,0A00><C:0005,0001,>Предметы.\n<C:0000,0003,000000FF><C:0008,0001,0A00><C:0005,0001,>Вещи.\n  <C:0000,0003,000000FF><C:0005,0001,>Засыпучино.<C:0001,0002,>        <C:0005,0001,>Мы пойдем.<C:0003,0000,0A00><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,><C:0007,0000,>Чего желать месье?<C:0003,0000,0A00> \n<C:0008,0001,0A00><C:0005,0001,>Предметы.\n<C:0000,0003,000000FF><C:0008,0001,0A00><C:0005,0001,>Вещи.\n  <C:0000,0003,000000FF><C:0005,0001,>Засыпучино.<C:0001,0002,>        <C:0005,0001,>Мы пойдем.<C:0003,0000,0A00><C:0000,0003,000000FF>",
