    "21": {
      "text": "<C:0000,0002,9600><C:0000,0003,000000FF><C:0001,0004,><C:0000,0003,000000FF>YÜZÜK İÇİN BANA RING AT!<C:0003,0000,0A00><C:0003,0001,><C:0000,0002,6400>",
