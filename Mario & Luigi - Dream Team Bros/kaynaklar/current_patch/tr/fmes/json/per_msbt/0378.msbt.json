    "6": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Salon dediğin şey oda sayılır mı?<C:0000,0003,000000FF><C:0003,0000,0A00><U:000A>Yukyukyukyukyukyuk!<C:0003,0001,><C:0000,0004,>Kimin umrunda, değil mi?<C:0003,0000,0A00><U:000A>Her hâlükârda komik,<C:0003,0000,0A00><U:000A>öyle değil mi?<C:0003,0001,>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Salon dediğin şey oda sayılır mı?<C:0000,0003,000000FF><C:0003,0000,0A00><U:000A>Yukyukyukyukyukyuk!<C:0003,0001,><C:0000,0004,>Kimin umrunda, değil mi?<C:0003,0000,0A00><U:000A>Her hâlükârda komik,<C:0003,0000,0A00><U:000A>öyle değil mi?<C:0003,0001,>",
