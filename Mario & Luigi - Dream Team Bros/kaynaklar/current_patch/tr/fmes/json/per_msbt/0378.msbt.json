      "original_text": "<C:0000,0002,6400><C:0000,0003,000000FF><C:0001,0004,>Tamam, durun, bir tane daha geliyor!<C:0000,0002,6400><C:0000,0003,000000FF><C:0003,0000,0A00><U:000A>Bu sizi bitirecek, yemin ederim<C:0000,0003,000000FF><C:0000,0002,6400>!<C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,>",
      "original_tokenized_text": "<C:0000,0002,6400><C:0000,0003,000000FF><C:0001,0004,>Tamam, durun, bir tane daha geliyor!<C:0000,0002,6400><C:0000,0003,000000FF><C:0003,0000,0A00><U:000A>Bu sizi bitirecek, yemin ederim<C:0000,0003,000000FF><C:0000,0002,6400>!<C:0000,0003,000000FF><C:0000,0002,6400><C:0003,0001,>",
      "raw_full_hex": ""
    },
    "16": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Ha? <C:0000,0003,000000FF><C:0003,0000,0A00><C:0000,0003,000000FF><C:0000,0003,2C65FFFF>Rüya Yumurtası<C:0000,0003,000000FF> hakkında<U:000A>beni dinlemekten çok onu mu istiyorsunuz?<C:0000,0003,000000FF><C:0003,0001,>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Ha? <C:0000,0003,000000FF><C:0003,0000,0A00><C:0000,0003,000000FF><C:0000,0003,2C65FFFF>Rüya Yumurtası<C:0000,0003,000000FF> hakkında<U:000A>beni dinlemekten çok onu mu istiyorsunuz?<C:0000,0003,000000FF><C:0003,0001,>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Ha? <C:0000,0003,000000FF><C:0003,0000,0A00><C:0000,0003,000000FF><C:0000,0003,2C65FFFF>Rüya Yumurtası<C:0000,0003,000000FF> hakkında<U:000A>beni dinlemekten çok onu mu istiyorsunuz?<C:0000,0003,000000FF><C:0003,0001,>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Ha? <C:0000,0003,000000FF><C:0003,0000,0A00><C:0000,0003,000000FF><C:0000,0003,2C65FFFF>Rüya Yumurtası<C:0000,0003,000000FF> hakkında<U:000A>beni dinlemekten çok onu mu istiyorsunuz?<C:0000,0003,000000FF><C:0003,0001,>",
      "raw_full_hex": ""
    },
    "17": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Tamam... Anladım...<C:0000,0003,000000FF><C:0000,0003,000000FF><U:000A>Buz gibisiniz dostum.<C:0003,0001,><C:0000,0004,>Ama neyse!<U:000A>Alın, sizin olsun!<C:0000,0003,000000FF><C:0003,0001,>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Tamam... Anladım...<C:0000,0003,000000FF><C:0000,0003,000000FF><U:000A>Buz gibisiniz dostum.<C:0003,0001,><C:0000,0004,>Ama neyse!<U:000A>Alın, sizin olsun!<C:0000,0003,000000FF><C:0003,0001,>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Tamam... Anladım...<C:0000,0003,000000FF><C:0000,0003,000000FF><U:000A>Buz gibisiniz dostum.<C:0003,0001,><C:0000,0004,>Ama neyse!<U:000A>Alın, sizin olsun!<C:0000,0003,000000FF><C:0003,0001,>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Tamam... Anladım...<C:0000,0003,000000FF><C:0000,0003,000000FF><U:000A>Buz gibisiniz dostum.<C:0003,0001,><C:0000,0004,>Ama neyse!<U:000A>Alın, sizin olsun!<C:0000,0003,000000FF><C:0003,0001,>",
      "raw_full_hex": ""
    },
    "18": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Yani o <C:0000,0003,2C65FFFF>Rüya Yumurtası<C:0000,0003,000000FF>'nı<U:000A>Peach'i saklamak için<U:000A>kullanacaksınız, öyle mi?<C:0000,0003,000000FF><C:0003,0001,><C:0000,0004,>Tabii tabii. Ama taşırken dikkat<U:000A>edin.<U:000A>Yolda kırılmasını istemezsiniz.<C:0003,0001,>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Yani o <C:0000,0003,2C65FFFF>Rüya Yumurtası<C:0000,0003,000000FF>'nı<U:000A>Peach'i saklamak için<U:000A>kullanacaksınız, öyle mi?<C:0000,0003,000000FF><C:0003,0001,><C:0000,0004,>Tabii tabii. Ama taşırken dikkat<U:000A>edin.<U:000A>Yolda kırılmasını istemezsiniz.<C:0003,0001,>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Yani o <C:0000,0003,2C65FFFF>Rüya Yumurtası<C:0000,0003,000000FF>'nı<U:000A>Peach'i saklamak için<U:000A>kullanacaksınız, öyle mi?<C:0000,0003,000000FF><C:0003,0001,><C:0000,0004,>Tabii tabii. Ama taşırken dikkat<U:000A>edin.<U:000A>Yolda kırılmasını istemezsiniz.<C:0003,0001,>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Yani o <C:0000,0003,2C65FFFF>Rüya Yumurtası<C:0000,0003,000000FF>'nı<U:000A>Peach'i saklamak için<U:000A>kullanacaksınız, öyle mi?<C:0000,0003,000000FF><C:0003,0001,><C:0000,0004,>Tabii tabii. Ama taşırken dikkat<U:000A>edin.<U:000A>Yolda kırılmasını istemezsiniz.<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "19": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Tabii sorun çıkmayacağına eminim...<U:000A>Sonuçta bir kraliyet hanımefendisi için<U:000A>koşturuyorsunuz!<C:0000,0003,000000FF><C:0003,0001,>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Tabii sorun çıkmayacağına eminim...<U:000A>Sonuçta bir kraliyet hanımefendisi için<U:000A>koşturuyorsunuz!<C:0000,0003,000000FF><C:0003,0001,>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Tabii sorun çıkmayacağına eminim...<U:000A>Sonuçta bir kraliyet hanımefendisi için<U:000A>koşturuyorsunuz!<C:0000,0003,000000FF><C:0003,0001,>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Tabii sorun çıkmayacağına eminim...<U:000A>Sonuçta bir kraliyet hanımefendisi için<U:000A>koşturuyorsunuz!<C:0000,0003,000000FF><C:0003,0001,>",
      "raw_full_hex": ""
    },
    "20": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,><C:0000,0003,000000FF>Hanımlar, işte böyle, değil mi?<C:0003,0000,0A00> Hepsi<U:000A>kraliyet gibi muameleyi hak eder,<U:000A>biliyorsunuz.<C:0003,0001,><C:0000,0004,>Eşim mesela. Ona evlenme teklif<U:000A>ederken<U:000A>telefon verip şöyle bir mesaj<U:000A>atmıştım...<C:0003,0001,>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,><C:0000,0003,000000FF>Hanımlar, işte böyle, değil mi?<C:0003,0000,0A00> Hepsi<U:000A>kraliyet gibi muameleyi hak eder,<U:000A>biliyorsunuz.<C:0003,0001,><C:0000,0004,>Eşim mesela. Ona evlenme teklif<U:000A>ederken<U:000A>telefon verip şöyle bir mesaj<U:000A>atmıştım...<C:0003,0001,>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,><C:0000,0003,000000FF>Hanımlar, işte böyle, değil mi?<C:0003,0000,0A00> Hepsi<U:000A>kraliyet gibi muameleyi hak eder,<U:000A>biliyorsunuz.<C:0003,0001,><C:0000,0004,>Eşim mesela. Ona evlenme teklif<U:000A>ederken<U:000A>telefon verip şöyle bir mesaj<U:000A>atmıştım...<C:0003,0001,>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,><C:0000,0003,000000FF>Hanımlar, işte böyle, değil mi?<C:0003,0000,0A00> Hepsi<U:000A>kraliyet gibi muameleyi hak eder,<U:000A>biliyorsunuz.<C:0003,0001,><C:0000,0004,>Eşim mesela. Ona evlenme teklif<U:000A>ederken<U:000A>telefon verip şöyle bir mesaj<U:000A>atmıştım...<C:0003,0001,>",
      "raw_full_hex": ""
