    "32": {
      "text": "<C:0001,0004,>Antasma war einst nur eine\neinfache Fledermaus wie viele\nauf dieser Insel,<C:0003,0001,><C:0000,0004,>doch eines Tages verschlang\ner den Albtraum eines Kisso...\nKeiner weiß, wie er das tat!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Antasma war einst nur eine\neinfache Fledermaus wie viele\nauf dieser Insel,<C:0003,0001,><C:0000,0004,>doch eines Tages verschlang\ner den Albtraum eines Kisso...\nKeiner weiß, wie er das tat!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Antasma war einst nur eine\neinfache Fledermaus wie viele\nauf dieser Insel,<C:0003,0001,><C:0000,0004,>doch eines Tages verschlang\ner den Albtraum eines Kisso...\nKeiner weiß, wie er das tat!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Antasma war einst nur eine\neinfache Fledermaus wie viele\nauf dieser Insel,<C:0003,0001,><C:0000,0004,>doch eines Tages verschlang\ner den Albtraum eines Kisso...\nKeiner weiß, wie er das tat!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "33": {
      "text": "<C:0000,0002,6400><C:0001,0004,>Er fing an, mehr und mehr\nfinstere Träume zu verzehren.<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0004,>So entwickelte er sich zu dem\nWesen, das er heute ist.<C:0003,0001,><C:0000,0002,6400>",
