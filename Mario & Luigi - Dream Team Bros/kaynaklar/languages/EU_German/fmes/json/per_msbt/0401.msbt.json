      "original_text": "<C:0000,0002,6400><C:0001,0004,>Er fing an, mehr und mehr\nfinstere Träume zu verzehren.<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0004,>So entwickelte er sich zu dem\nWesen, das er heute ist.<C:0003,0001,><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Er fing an, mehr und mehr\nfinstere Träume zu verzehren.<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0004,>So entwickelte er sich zu dem\nWesen, das er heute ist.<C:0003,0001,><C:0000,0002,6400>",
      "raw_full_hex": ""
    },
