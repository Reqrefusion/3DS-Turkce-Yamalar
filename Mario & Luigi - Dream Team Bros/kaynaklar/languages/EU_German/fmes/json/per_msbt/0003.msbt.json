    "1": {
      "text": "WAAAH! Ich habe Sprünge\nam ganzen Körper<C:0000,0002,6400>!<C:0003,0001,><C:0000,0004,>Ein Stein zu sein war\nganz schön hart.<C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "WAAAH! Ich habe Sprünge\nam ganzen Körper<C:0000,0002,6400>!<C:0003,0001,><C:0000,0004,>Ein Stein zu sein war\nganz schön hart.<C:0003,0001,><C:0000,0002,6400>",
      "original_text": "WAAAH! Ich habe Sprünge\nam ganzen Körper<C:0000,0002,6400>!<C:0003,0001,><C:0000,0004,>Ein Stein zu sein war\nganz schön hart.<C:0003,0001,><C:0000,0002,6400>",
      "original_tokenized_text": "WAAAH! Ich habe Sprünge\nam ganzen Körper<C:0000,0002,6400>!<C:0003,0001,><C:0000,0004,>Ein Stein zu sein war\nganz schön hart.<C:0003,0001,><C:0000,0002,6400>",
      "raw_full_hex": ""
    },
    "2": {
      "text": "Danke für die Hilfe,\nihr bärtigen Burschen!<C:0003,0001,>",
      "tokenized_text": "Danke für die Hilfe,\nihr bärtigen Burschen!<C:0003,0001,>",
      "original_text": "Danke für die Hilfe,\nihr bärtigen Burschen!<C:0003,0001,>",
      "original_tokenized_text": "Danke für die Hilfe,\nihr bärtigen Burschen!<C:0003,0001,>",
      "raw_full_hex": "440061006E006B00650020006600FC00720020006400690065002000480069006C00660065002C000A0069006800720020006200E400720074006900670065006E00200042007500720073006300680065006E0021000E000300010000000000"
    },
    "3": {
      "text": "<C:0007,0000,>Was kann ich für euch tun?<C:0003,0000,1400>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Lass uns quatschen.\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Bring uns in die Traumwelt.\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>War nicht so wichtig.",
      "tokenized_text": "<C:0007,0000,>Was kann ich für euch tun?<C:0003,0000,1400>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Lass uns quatschen.\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Bring uns in die Traumwelt.\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>War nicht so wichtig.",
      "original_text": "<C:0007,0000,>Was kann ich für euch tun?<C:0003,0000,1400>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Lass uns quatschen.\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Bring uns in die Traumwelt.\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>War nicht so wichtig.",
      "original_tokenized_text": "<C:0007,0000,>Was kann ich für euch tun?<C:0003,0000,1400>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Lass uns quatschen.\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Bring uns in die Traumwelt.\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>War nicht so wichtig.",
      "raw_full_hex": ""
    },
    "4": {
      "text": "<C:0001,0004,><C:0001,0001,><C:0000,0002,9600>Antasma!<C:0003,0001,><C:0000,0002,6400><C:0000,0004,><C:0000,0002,6400><C:0001,0000,><C:0001,0003,>Wegen ihm bin ich\nzu Stein geworden!<C:0003,0001,><C:0000,0004,>Und habe jetzt Risse\nam ganzen Körper!<C:0003,0001,><C:0000,0004,>Du kannst dir sicher denken, dass\nich tierisch sauer auf ihn bin!<C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "<C:0001,0004,><C:0001,0001,><C:0000,0002,9600>Antasma!<C:0003,0001,><C:0000,0002,6400><C:0000,0004,><C:0000,0002,6400><C:0001,0000,><C:0001,0003,>Wegen ihm bin ich\nzu Stein geworden!<C:0003,0001,><C:0000,0004,>Und habe jetzt Risse\nam ganzen Körper!<C:0003,0001,><C:0000,0004,>Du kannst dir sicher denken, dass\nich tierisch sauer auf ihn bin!<C:0003,0001,><C:0000,0002,6400>",
      "original_text": "<C:0001,0004,><C:0001,0001,><C:0000,0002,9600>Antasma!<C:0003,0001,><C:0000,0002,6400><C:0000,0004,><C:0000,0002,6400><C:0001,0000,><C:0001,0003,>Wegen ihm bin ich\nzu Stein geworden!<C:0003,0001,><C:0000,0004,>Und habe jetzt Risse\nam ganzen Körper!<C:0003,0001,><C:0000,0004,>Du kannst dir sicher denken, dass\nich tierisch sauer auf ihn bin!<C:0003,0001,><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0001,0004,><C:0001,0001,><C:0000,0002,9600>Antasma!<C:0003,0001,><C:0000,0002,6400><C:0000,0004,><C:0000,0002,6400><C:0001,0000,><C:0001,0003,>Wegen ihm bin ich\nzu Stein geworden!<C:0003,0001,><C:0000,0004,>Und habe jetzt Risse\nam ganzen Körper!<C:0003,0001,><C:0000,0004,>Du kannst dir sicher denken, dass\nich tierisch sauer auf ihn bin!<C:0003,0001,><C:0000,0002,6400>",
      "raw_full_hex": ""
    },
    "5": {
      "text": "Hast du das gesehen?\nDiese gruselige Festung?<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Ich wette, dass dahinter\ndieser Antasma steckt!<C:0003,0001,><C:0000,0002,6400><C:0000,0004,>Er verkörpert alles, was\nfalsch ist auf der Welt!<C:0000,0002,6400><C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "Hast du das gesehen?\nDiese gruselige Festung?<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Ich wette, dass dahinter\ndieser Antasma steckt!<C:0003,0001,><C:0000,0002,6400><C:0000,0004,>Er verkörpert alles, was\nfalsch ist auf der Welt!<C:0000,0002,6400><C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400>",
      "original_text": "Hast du das gesehen?\nDiese gruselige Festung?<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Ich wette, dass dahinter\ndieser Antasma steckt!<C:0003,0001,><C:0000,0002,6400><C:0000,0004,>Er verkörpert alles, was\nfalsch ist auf der Welt!<C:0000,0002,6400><C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400>",
      "original_tokenized_text": "Hast du das gesehen?\nDiese gruselige Festung?<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Ich wette, dass dahinter\ndieser Antasma steckt!<C:0003,0001,><C:0000,0002,6400><C:0000,0004,>Er verkörpert alles, was\nfalsch ist auf der Welt!<C:0000,0002,6400><C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400>",
      "raw_full_hex": ""
    },
    "6": {
      "text": "<C:0007,0000,>Die Traumwelt besuchen?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Nein.<C:0000,0003,000000FF>         <C:0000,0003,FFFFFFFF><C:0005,0001,>Ja.<C:0003,0000,0A00>",
      "tokenized_text": "<C:0007,0000,>Die Traumwelt besuchen?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Nein.<C:0000,0003,000000FF>         <C:0000,0003,FFFFFFFF><C:0005,0001,>Ja.<C:0003,0000,0A00>",
