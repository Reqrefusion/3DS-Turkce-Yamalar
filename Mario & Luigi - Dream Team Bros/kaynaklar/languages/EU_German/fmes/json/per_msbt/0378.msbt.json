      "original_text": "",
      "original_tokenized_text": "",
      "raw_full_hex": "0000"
    },
    "27": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,><C:0007,0000,><C:0001,0001,><C:0000,0003,FFFFFFFF>Du erhältst ein <C:0000,0003,00EAFFFF>Traum-Ei<C:0000,0003,FFFFFFFF>! <C:0000,0003,000000FF><C:0003,0000,1E00><C:0003,0001,><C:0000,0003,FFFFFFFF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,><C:0007,0000,><C:0001,0001,><C:0000,0003,FFFFFFFF>Du erhältst ein <C:0000,0003,00EAFFFF>Traum-Ei<C:0000,0003,FFFFFFFF>! <C:0000,0003,000000FF><C:0003,0000,1E00><C:0003,0001,><C:0000,0003,FFFFFFFF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,><C:0007,0000,><C:0001,0001,><C:0000,0003,FFFFFFFF>Du erhältst ein <C:0000,0003,00EAFFFF>Traum-Ei<C:0000,0003,FFFFFFFF>! <C:0000,0003,000000FF><C:0003,0000,1E00><C:0003,0001,><C:0000,0003,FFFFFFFF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,><C:0007,0000,><C:0001,0001,><C:0000,0003,FFFFFFFF>Du erhältst ein <C:0000,0003,00EAFFFF>Traum-Ei<C:0000,0003,FFFFFFFF>! <C:0000,0003,000000FF><C:0003,0000,1E00><C:0003,0001,><C:0000,0003,FFFFFFFF>",
      "raw_full_hex": ""
    },
    "28": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Damit haben wir alle\ndrei <C:0000,0003,2C65FFFF>Traum-Eier<C:0000,0003,000000FF>!<C:0003,0001,><C:0000,0004,>Schnell zurück in die Traumwelt,\nwo Peach auf uns wartet!<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Damit haben wir alle\ndrei <C:0000,0003,2C65FFFF>Traum-Eier<C:0000,0003,000000FF>!<C:0003,0001,><C:0000,0004,>Schnell zurück in die Traumwelt,\nwo Peach auf uns wartet!<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Damit haben wir alle\ndrei <C:0000,0003,2C65FFFF>Traum-Eier<C:0000,0003,000000FF>!<C:0003,0001,><C:0000,0004,>Schnell zurück in die Traumwelt,\nwo Peach auf uns wartet!<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Damit haben wir alle\ndrei <C:0000,0003,2C65FFFF>Traum-Eier<C:0000,0003,000000FF>!<C:0003,0001,><C:0000,0004,>Schnell zurück in die Traumwelt,\nwo Peach auf uns wartet!<C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": ""
    },
    "29": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Also gut!<C:0003,0000,0A00> Auf zur nächsten Traumzone.\nSuchen wir nach dem nächsten Seerling.<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Also gut!<C:0003,0000,0A00> Auf zur nächsten Traumzone.\nSuchen wir nach dem nächsten Seerling.<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Also gut!<C:0003,0000,0A00> Auf zur nächsten Traumzone.\nSuchen wir nach dem nächsten Seerling.<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Also gut!<C:0003,0000,0A00> Auf zur nächsten Traumzone.\nSuchen wir nach dem nächsten Seerling.<C:0003,0001,><C:0000,0003,000000FF>",
