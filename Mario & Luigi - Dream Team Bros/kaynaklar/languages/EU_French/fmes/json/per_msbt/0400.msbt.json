    "10": {
      "text": "<C:0001,0004,>Le pouvoir onirique de ces bois est\nsans commune mesure avec celui qui\nnourrit les autres parties du monde.<C:0003,0001,><C:0000,0004,>C'est pour cela que nous y avons érigé\nle temple... Pour accroître le pouvoir\nde nos rêves.<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Le pouvoir onirique de ces bois est\nsans commune mesure avec celui qui\nnourrit les autres parties du monde.<C:0003,0001,><C:0000,0004,>C'est pour cela que nous y avons érigé\nle temple... Pour accroître le pouvoir\nde nos rêves.<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Le pouvoir onirique de ces bois est\nsans commune mesure avec celui qui\nnourrit les autres parties du monde.<C:0003,0001,><C:0000,0004,>C'est pour cela que nous y avons érigé\nle temple... Pour accroître le pouvoir\nde nos rêves.<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Le pouvoir onirique de ces bois est\nsans commune mesure avec celui qui\nnourrit les autres parties du monde.<C:0003,0001,><C:0000,0004,>C'est pour cela que nous y avons érigé\nle temple... Pour accroître le pouvoir\nde nos rêves.<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "11": {
      "text": "<C:0001,0004,>Le pouvoir onirique afflue en\npermanence dans le temple.<C:0003,0001,><C:0000,0004,>Et l'ultilit a le pouvoir de décupler\nvotre force de sommeil...<C:0003,0001,><C:0000,0004,>Vous ne devriez avoir aucun\nmal à trouver Protodor !<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Le pouvoir onirique afflue en\npermanence dans le temple.<C:0003,0001,><C:0000,0004,>Et l'ultilit a le pouvoir de décupler\nvotre force de sommeil...<C:0003,0001,><C:0000,0004,>Vous ne devriez avoir aucun\nmal à trouver Protodor !<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Le pouvoir onirique afflue en\npermanence dans le temple.<C:0003,0001,><C:0000,0004,>Et l'ultilit a le pouvoir de décupler\nvotre force de sommeil...<C:0003,0001,><C:0000,0004,>Vous ne devriez avoir aucun\nmal à trouver Protodor !<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Le pouvoir onirique afflue en\npermanence dans le temple.<C:0003,0001,><C:0000,0004,>Et l'ultilit a le pouvoir de décupler\nvotre force de sommeil...<C:0003,0001,><C:0000,0004,>Vous ne devriez avoir aucun\nmal à trouver Protodor !<C:0003,0001,>",
      "raw_full_hex": ""
    },
