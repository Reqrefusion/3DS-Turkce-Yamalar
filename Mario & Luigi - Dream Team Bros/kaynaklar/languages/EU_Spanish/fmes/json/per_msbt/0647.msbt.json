      "raw_full_hex": "A1004C006100200074006F0072006D0065006E00740061002000680061002000650073007000610072006300690064006F00200072006F006300610073000A0070006F007200200074006F00640061007300200070006100720074006500730021000E000300010000000000"
    },
    "2": {
      "text": "A ver, tú, ayúdame a\nlimpiar este desastre.<C:0003,0001,>",
      "tokenized_text": "A ver, tú, ayúdame a\nlimpiar este desastre.<C:0003,0001,>",
      "original_text": "A ver, tú, ayúdame a\nlimpiar este desastre.<C:0003,0001,>",
