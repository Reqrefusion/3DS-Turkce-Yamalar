    },
    "3": {
      "text": "<C:0000,0002,9600>¡DATE VIDA!<C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,9600>¡DATE VIDA!<C:0003,0001,><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,9600>¡DATE VIDA!<C:0003,0001,><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,9600>¡DATE VIDA!<C:0003,0001,><C:0000,0002,6400>",
      "raw_full_hex": "0E000000020002009600A10044004100540045002000560049004400410021000E000300010000000E0000000200020064000000"
    },
    "4": {
      "text": "Tenemos que quitar todas las rocas\nantes de que anochezca.<C:0003,0001,>",
      "tokenized_text": "Tenemos que quitar todas las rocas\nantes de que anochezca.<C:0003,0001,>",
      "original_text": "Tenemos que quitar todas las rocas\nantes de que anochezca.<C:0003,0001,>",
      "original_tokenized_text": "Tenemos que quitar todas las rocas\nantes de que anochezca.<C:0003,0001,>",
      "raw_full_hex": "540065006E0065006D006F00730020007100750065002000710075006900740061007200200074006F0064006100730020006C0061007300200072006F006300610073000A0061006E007400650073002000640065002000710075006500200061006E006F006300680065007A00630061002E000E000300010000000000"
    },
    "5": {
      "text": "¿En serio?<C:0003,0001,>",
      "tokenized_text": "¿En serio?<C:0003,0001,>",
      "original_text": "¿En serio?<C:0003,0001,>",
      "original_tokenized_text": "¿En serio?<C:0003,0001,>",
      "raw_full_hex": "BF0045006E00200073006500720069006F003F000E000300010000000000"
    },
    "6": {
      "text": "<C:0000,0002,9600><C:0001,0004,>¿ES QUE NO HA\nQUEDADO CLARO?<C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,9600><C:0001,0004,>¿ES QUE NO HA\nQUEDADO CLARO?<C:0003,0001,><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,9600><C:0001,0004,>¿ES QUE NO HA\nQUEDADO CLARO?<C:0003,0001,><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,9600><C:0001,0004,>¿ES QUE NO HA\nQUEDADO CLARO?<C:0003,0001,><C:0000,0002,6400>",
      "raw_full_hex": "0E0000000200020096000E00010004000000BF0045005300200051005500450020004E004F002000480041000A005100550045004400410044004F00200043004C00410052004F003F000E000300010000000E0000000200020064000000"
    },
    "7": {
      "text": "O es que...<C:0003,0001,>",
      "tokenized_text": "O es que...<C:0003,0001,>",
      "original_text": "O es que...<C:0003,0001,>",
      "original_tokenized_text": "O es que...<C:0003,0001,>",
      "raw_full_hex": "4F0020006500730020007100750065002E002E002E000E000300010000000000"
    },
    "8": {
      "text": "¿no te gusta seguir\nlas órdenes...<C:0003,0001,>",
      "tokenized_text": "¿no te gusta seguir\nlas órdenes...<C:0003,0001,>",
      "original_text": "¿no te gusta seguir\nlas órdenes...<C:0003,0001,>",
      "original_tokenized_text": "¿no te gusta seguir\nlas órdenes...<C:0003,0001,>",
      "raw_full_hex": "BF006E006F0020007400650020006700750073007400610020007300650067007500690072000A006C00610073002000F3007200640065006E00650073002E002E002E000E000300010000000000"
    },
    "9": {
      "text": "DE TU CAPATAZ?<C:0003,0001,>",
      "tokenized_text": "DE TU CAPATAZ?<C:0003,0001,>",
      "original_text": "DE TU CAPATAZ?<C:0003,0001,>",
      "original_tokenized_text": "DE TU CAPATAZ?<C:0003,0001,>",
      "raw_full_hex": "4400450020005400550020004300410050004100540041005A003F000E000300010000000000"
    },
    "10": {
      "text": "¡En absoluto, señor!\nMe pongo a ello ahora mismo.<C:0003,0001,>",
      "tokenized_text": "¡En absoluto, señor!\nMe pongo a ello ahora mismo.<C:0003,0001,>",
      "original_text": "¡En absoluto, señor!\nMe pongo a ello ahora mismo.<C:0003,0001,>",
      "original_tokenized_text": "¡En absoluto, señor!\nMe pongo a ello ahora mismo.<C:0003,0001,>",
      "raw_full_hex": "A10045006E0020006100620073006F006C00750074006F002C00200073006500F1006F00720021000A004D006500200070006F006E0067006F0020006100200065006C006C006F002000610068006F007200610020006D00690073006D006F002E000E000300010000000000"
    },
    "11": {
      "text": "¡Bah! ¿Y vosotros quiénes sois?<C:0003,0001,>",
      "tokenized_text": "¡Bah! ¿Y vosotros quiénes sois?<C:0003,0001,>",
      "original_text": "¡Bah! ¿Y vosotros quiénes sois?<C:0003,0001,>",
      "original_tokenized_text": "¡Bah! ¿Y vosotros quiénes sois?<C:0003,0001,>",
      "raw_full_hex": "A10042006100680021002000BF005900200076006F0073006F00740072006F0073002000710075006900E9006E0065007300200073006F00690073003F000E000300010000000000"
    },
    "12": {
      "text": "No tengo tiempo para\ncharlar, amigo.<C:0003,0001,><C:0000,0004,>Tengo muchas rocas\nde las que ocuparme.<C:0003,0001,>",
      "tokenized_text": "No tengo tiempo para\ncharlar, amigo.<C:0003,0001,><C:0000,0004,>Tengo muchas rocas\nde las que ocuparme.<C:0003,0001,>",
      "original_text": "No tengo tiempo para\ncharlar, amigo.<C:0003,0001,><C:0000,0004,>Tengo muchas rocas\nde las que ocuparme.<C:0003,0001,>",
      "original_tokenized_text": "No tengo tiempo para\ncharlar, amigo.<C:0003,0001,><C:0000,0004,>Tengo muchas rocas\nde las que ocuparme.<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "13": {
      "text": "¿Qué dices?<C:0003,0001,>",
      "tokenized_text": "¿Qué dices?<C:0003,0001,>",
      "original_text": "¿Qué dices?<C:0003,0001,>",
      "original_tokenized_text": "¿Qué dices?<C:0003,0001,>",
      "raw_full_hex": "BF0051007500E9002000640069006300650073003F000E000300010000000000"
    },
    "14": {
      "text": "<C:0001,0001,><C:0001,0004,>¡Oye!<C:0003,0000,1E00>",
      "tokenized_text": "<C:0001,0001,><C:0001,0004,>¡Oye!<C:0003,0000,1E00>",
      "original_text": "<C:0001,0001,><C:0001,0004,>¡Oye!<C:0003,0000,1E00>",
      "original_tokenized_text": "<C:0001,0001,><C:0001,0004,>¡Oye!<C:0003,0000,1E00>",
      "raw_full_hex": "0E000100010000000E00010004000000A1004F007900650021000E000300000002001E000000"
    },
    "15": {
      "text": "<C:0001,0001,><C:0001,0004,><C:0000,0002,9600>¡QUÉ SUSTO!<C:0003,0000,1E00><C:0000,0002,6400>",
      "tokenized_text": "<C:0001,0001,><C:0001,0004,><C:0000,0002,9600>¡QUÉ SUSTO!<C:0003,0000,1E00><C:0000,0002,6400>",
      "original_text": "<C:0001,0001,><C:0001,0004,><C:0000,0002,9600>¡QUÉ SUSTO!<C:0003,0000,1E00><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0001,0001,><C:0001,0004,><C:0000,0002,9600>¡QUÉ SUSTO!<C:0003,0000,1E00><C:0000,0002,6400>",
      "raw_full_hex": "0E000100010000000E000100040000000E000000020002009600A10051005500C900200053005500530054004F0021000E000300000002001E000E0000000200020064000000"
    },
    "16": {
      "text": "¿No habrás visto por casualidad\nuna almohada por aquí?<C:0003,0001,>",
      "tokenized_text": "¿No habrás visto por casualidad\nuna almohada por aquí?<C:0003,0001,>",
      "original_text": "¿No habrás visto por casualidad\nuna almohada por aquí?<C:0003,0001,>",
      "original_tokenized_text": "¿No habrás visto por casualidad\nuna almohada por aquí?<C:0003,0001,>",
      "raw_full_hex": "BF004E006F0020006800610062007200E1007300200076006900730074006F00200070006F0072002000630061007300750061006C0069006400610064000A0075006E006100200061006C006D006F006800610064006100200070006F0072002000610071007500ED003F000E000300010000000000"
    },
    "17": {
      "text": "Es muy vieja y puede\nque esté mohosa y dura\ncomo una piedra.<C:0003,0001,><C:0000,0004,>Tiene que estar en algún\nlugar del parque.<C:0003,0001,>",
      "tokenized_text": "Es muy vieja y puede\nque esté mohosa y dura\ncomo una piedra.<C:0003,0001,><C:0000,0004,>Tiene que estar en algún\nlugar del parque.<C:0003,0001,>",
      "original_text": "Es muy vieja y puede\nque esté mohosa y dura\ncomo una piedra.<C:0003,0001,><C:0000,0004,>Tiene que estar en algún\nlugar del parque.<C:0003,0001,>",
      "original_tokenized_text": "Es muy vieja y puede\nque esté mohosa y dura\ncomo una piedra.<C:0003,0001,><C:0000,0004,>Tiene que estar en algún\nlugar del parque.<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "18": {
      "text": "Ah...<C:0003,0000,1400> ¿Te refieres a esta cosa?<C:0003,0001,>",
      "tokenized_text": "Ah...<C:0003,0000,1400> ¿Te refieres a esta cosa?<C:0003,0001,>",
      "original_text": "Ah...<C:0003,0000,1400> ¿Te refieres a esta cosa?<C:0003,0001,>",
      "original_tokenized_text": "Ah...<C:0003,0000,1400> ¿Te refieres a esta cosa?<C:0003,0001,>",
      "raw_full_hex": "410068002E002E002E000E0003000000020014002000BF00540065002000720065006600690065007200650073002000610020006500730074006100200063006F00730061003F000E000300010000000000"
    },
    "19": {
      "text": "Hay muchas más\nen el parque.<C:0003,0001,><C:0000,0004,>Pero esta de aquí\nme tiene enamorado.<C:0003,0001,>",
      "tokenized_text": "Hay muchas más\nen el parque.<C:0003,0001,><C:0000,0004,>Pero esta de aquí\nme tiene enamorado.<C:0003,0001,>",
      "original_text": "Hay muchas más\nen el parque.<C:0003,0001,><C:0000,0004,>Pero esta de aquí\nme tiene enamorado.<C:0003,0001,>",
      "original_tokenized_text": "Hay muchas más\nen el parque.<C:0003,0001,><C:0000,0004,>Pero esta de aquí\nme tiene enamorado.<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "20": {
      "text": "Para mí, que tiene \"valor histórico\",\ncomo dicen los sabihondos.<C:0003,0001,>",
      "tokenized_text": "Para mí, que tiene \"valor histórico\",\ncomo dicen los sabihondos.<C:0003,0001,>",
      "original_text": "Para mí, que tiene \"valor histórico\",\ncomo dicen los sabihondos.<C:0003,0001,>",
      "original_tokenized_text": "Para mí, que tiene \"valor histórico\",\ncomo dicen los sabihondos.<C:0003,0001,>",
      "raw_full_hex": "500061007200610020006D00ED002C00200071007500650020007400690065006E00650020002200760061006C006F00720020006800690073007400F3007200690063006F0022002C000A0063006F006D006F00200064006900630065006E0020006C006F0073002000730061006200690068006F006E0064006F0073002E000E000300010000000000"
    },
    "21": {
      "text": "¡Es justo la almohada\nque buscamos!<C:0003,0001,>",
      "tokenized_text": "¡Es justo la almohada\nque buscamos!<C:0003,0001,>",
      "original_text": "¡Es justo la almohada\nque buscamos!<C:0003,0001,>",
      "original_tokenized_text": "¡Es justo la almohada\nque buscamos!<C:0003,0001,>",
