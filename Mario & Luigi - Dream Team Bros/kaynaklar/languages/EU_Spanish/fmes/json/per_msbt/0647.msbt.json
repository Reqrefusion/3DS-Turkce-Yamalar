{
  "0647.msbt": {
    "0": {
      "text": "¡Maldita sea!\nMenudo desastre.<C:0003,0001,>",
      "tokenized_text": "¡Maldita sea!\nMenudo desastre.<C:0003,0001,>",
      "original_text": "¡Maldita sea!\nMenudo desastre.<C:0003,0001,>",
      "original_tokenized_text": "¡Maldita sea!\nMenudo desastre.<C:0003,0001,>",
