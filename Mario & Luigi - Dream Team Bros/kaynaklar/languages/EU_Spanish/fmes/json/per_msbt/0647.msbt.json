    },
    "22": {
      "text": "Dejemos las cosas\nclaras...<C:0003,0001,>",
      "tokenized_text": "Dejemos las cosas\nclaras...<C:0003,0001,>",
      "original_text": "Dejemos las cosas\nclaras...<C:0003,0001,>",
      "original_tokenized_text": "Dejemos las cosas\nclaras...<C:0003,0001,>",
      "raw_full_hex": "440065006A0065006D006F00730020006C0061007300200063006F007300610073000A0063006C0061007200610073002E002E002E000E000300010000000000"
    },
    "23": {
      "text": "¿Habéis venido a mi parque\npara llevaros mi almohada\nespecial?<C:0003,0001,><C:0000,0004,>¡Hay que tener mucha cara!\n¡Sí señor, mucha!<C:0003,0001,>",
      "tokenized_text": "¿Habéis venido a mi parque\npara llevaros mi almohada\nespecial?<C:0003,0001,><C:0000,0004,>¡Hay que tener mucha cara!\n¡Sí señor, mucha!<C:0003,0001,>",
      "original_text": "¿Habéis venido a mi parque\npara llevaros mi almohada\nespecial?<C:0003,0001,><C:0000,0004,>¡Hay que tener mucha cara!\n¡Sí señor, mucha!<C:0003,0001,>",
      "original_tokenized_text": "¿Habéis venido a mi parque\npara llevaros mi almohada\nespecial?<C:0003,0001,><C:0000,0004,>¡Hay que tener mucha cara!\n¡Sí señor, mucha!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "24": {
      "text": "Pues si queréis la almohada,\nme la tendréis que quitar.<C:0003,0001,>",
      "tokenized_text": "Pues si queréis la almohada,\nme la tendréis que quitar.<C:0003,0001,>",
      "original_text": "Pues si queréis la almohada,\nme la tendréis que quitar.<C:0003,0001,>",
      "original_tokenized_text": "Pues si queréis la almohada,\nme la tendréis que quitar.<C:0003,0001,>",
      "raw_full_hex": "500075006500730020007300690020007100750065007200E9006900730020006C006100200061006C006D006F0068006100640061002C000A006D00650020006C0061002000740065006E0064007200E90069007300200071007500650020007100750069007400610072002E000E000300010000000000"
    },
    "25": {
      "text": "<C:0000,0002,9600><C:0001,0004,>¡NO! ¡ESPERA!<C:0000,0002,6400><C:0000,0002,9600><C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,9600><C:0001,0004,>¡NO! ¡ESPERA!<C:0000,0002,6400><C:0000,0002,9600><C:0003,0001,><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,9600><C:0001,0004,>¡NO! ¡ESPERA!<C:0000,0002,6400><C:0000,0002,9600><C:0003,0001,><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,9600><C:0001,0004,>¡NO! ¡ESPERA!<C:0000,0002,6400><C:0000,0002,9600><C:0003,0001,><C:0000,0002,6400>",
      "raw_full_hex": "0E0000000200020096000E00010004000000A1004E004F0021002000A10045005300500045005200410021000E0000000200020064000E0000000200020096000E000300010000000E0000000200020064000000"
    },
    "26": {
      "text": "¡Mario! ¡Luigi!\n¡Tras él!<C:0003,0001,>",
      "tokenized_text": "¡Mario! ¡Luigi!\n¡Tras él!<C:0003,0001,>",
      "original_text": "¡Mario! ¡Luigi!\n¡Tras él!<C:0003,0001,>",
