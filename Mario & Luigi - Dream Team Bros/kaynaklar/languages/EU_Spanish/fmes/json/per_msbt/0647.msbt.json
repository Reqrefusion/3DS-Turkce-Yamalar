    },
    "27": {
      "text": "<C:0000,0002,9600><C:0001,0004,>¡Ayyy!<C:0003,0000,2800><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,9600><C:0001,0004,>¡Ayyy!<C:0003,0000,2800><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,9600><C:0001,0004,>¡Ayyy!<C:0003,0000,2800><C:0000,0002,6400>",
