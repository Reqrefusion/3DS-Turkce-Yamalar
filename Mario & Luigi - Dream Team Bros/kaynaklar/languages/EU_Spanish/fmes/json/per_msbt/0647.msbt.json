    },
    "1": {
      "text": "¡La tormenta ha esparcido rocas\npor todas partes!<C:0003,0001,>",
      "tokenized_text": "¡La tormenta ha esparcido rocas\npor todas partes!<C:0003,0001,>",
      "original_text": "¡La tormenta ha esparcido rocas\npor todas partes!<C:0003,0001,>",
