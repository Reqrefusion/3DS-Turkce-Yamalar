      "tokenized_text": "<C:0007,0000,>¿En qué puedo ayudarte?<C:0003,0000,0A00>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Objetos.\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Equipo.<C:0000,0003,FFFFFFFF><C:0000,0003,000000FF>\n<C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Batidalmohada.<C:0001,0002,>        <C:0005,0001,>Salir.<C:0003,0000,0A00>",
