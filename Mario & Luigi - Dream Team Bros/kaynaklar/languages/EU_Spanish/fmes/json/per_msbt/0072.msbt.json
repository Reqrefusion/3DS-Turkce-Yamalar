    "2": {
      "text": "El aire salado del mar\nque se respira en esta cueva...<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0004,>Lo echaba tanto de menos...\nPensaba que mi nariz jamás\nvolvería a deleitarse con él.<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "El aire salado del mar\nque se respira en esta cueva...<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0004,>Lo echaba tanto de menos...\nPensaba que mi nariz jamás\nvolvería a deleitarse con él.<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400>",
      "original_text": "El aire salado del mar\nque se respira en esta cueva...<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0004,>Lo echaba tanto de menos...\nPensaba que mi nariz jamás\nvolvería a deleitarse con él.<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400>",
      "original_tokenized_text": "El aire salado del mar\nque se respira en esta cueva...<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0004,>Lo echaba tanto de menos...\nPensaba que mi nariz jamás\nvolvería a deleitarse con él.<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400>",
      "raw_full_hex": ""
    },
