    },
    "46": {
      "text": "<C:0000,0002,4B00><C:0001,0004,>¿Y enfrentarse a los mismos desafíos\nque el resto de mis compañeros?<C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,4B00><C:0001,0004,>¿Y enfrentarse a los mismos desafíos\nque el resto de mis compañeros?<C:0003,0001,><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,4B00><C:0001,0004,>¿Y enfrentarse a los mismos desafíos\nque el resto de mis compañeros?<C:0003,0001,><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,4B00><C:0001,0004,>¿Y enfrentarse a los mismos desafíos\nque el resto de mis compañeros?<C:0003,0001,><C:0000,0002,6400>",
      "raw_full_hex": ""
    },
    "47": {
      "text": "<C:0000,0002,4B00><C:0001,0004,>Si le pongo empeño y determinación...\n¿seré capaz de venceros?<C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,4B00><C:0001,0004,>Si le pongo empeño y determinación...\n¿seré capaz de venceros?<C:0003,0001,><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,4B00><C:0001,0004,>Si le pongo empeño y determinación...\n¿seré capaz de venceros?<C:0003,0001,><C:0000,0002,6400>",
