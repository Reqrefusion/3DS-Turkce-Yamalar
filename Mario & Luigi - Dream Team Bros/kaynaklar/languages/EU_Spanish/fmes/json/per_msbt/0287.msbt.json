    "52": {
      "text": "<C:0000,0002,6400><C:0001,0004,>¡Debo creer en mí mismo!\n<C:0000,0002,4B00>Sí, claro, es fácil decirlo...<C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
