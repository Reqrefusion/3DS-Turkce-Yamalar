    "17": {
      "text": "<C:0001,0004,>Pues bien, todo el daño que inflijáis\ndebe proceder de golpes \"¡<C:0000,0003,2C65FFFF>EXCELENTE<C:0000,0003,000000FF><C:0000,0003,000000FF>!\"<C:0000,0003,000000FF><C:0000,0003,2C65FFFF><C:0000,0003,000000FF>.<C:0000,0003,2C65FFFF><C:0003,0001,><C:0000,0003,000000FF>",
