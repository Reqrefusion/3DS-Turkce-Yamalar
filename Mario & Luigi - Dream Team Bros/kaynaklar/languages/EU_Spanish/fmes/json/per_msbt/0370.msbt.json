    "14": {
      "text": "<C:0000,0002,6400><C:0001,0004,>Fingí que era Peach para\ntraer monstruos al mundo\nde los sueños...<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Fingí que era Peach para\ntraer monstruos al mundo\nde los sueños...<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
