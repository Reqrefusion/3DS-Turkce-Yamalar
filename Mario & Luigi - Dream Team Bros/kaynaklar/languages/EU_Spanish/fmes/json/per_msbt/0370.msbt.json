    "39": {
      "text": "<C:0000,0002,6400><C:0001,0004,>¡Genial!<C:0003,0000,0A00> ¡Vamos a machacar a\nesos tipos! ¡No puedo esperar\na darle órdenes a Bowser y tenerlo\ntodo el día de aquí para allá!<C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,6400><C:0001,0004,>¡Genial!<C:0003,0000,0A00> ¡Vamos a machacar a\nesos tipos! ¡No puedo esperar\na darle órdenes a Bowser y tenerlo\ntodo el día de aquí para allá!<C:0003,0001,><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,6400><C:0001,0004,>¡Genial!<C:0003,0000,0A00> ¡Vamos a machacar a\nesos tipos! ¡No puedo esperar\na darle órdenes a Bowser y tenerlo\ntodo el día de aquí para allá!<C:0003,0001,><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,6400><C:0001,0004,>¡Genial!<C:0003,0000,0A00> ¡Vamos a machacar a\nesos tipos! ¡No puedo esperar\na darle órdenes a Bowser y tenerlo\ntodo el día de aquí para allá!<C:0003,0001,><C:0000,0002,6400>",
      "raw_full_hex": ""
    },
    "40": {
      "text": "<C:0000,0002,6400><C:0000,0002,6400><C:0001,0004,>¡Mario!<C:0003,0000,0A00> ¡Ya estamos listos!\nGracias por esperarnos.<C:0003,0001,><C:0000,0002,6400><C:0000,0004,>Oye...<C:0000,0002,6400><C:0003,0000,0A00> ¿Está GARABATEANDO?\n¡Pero qué falta de respeto!<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,6400><C:0000,0002,6400><C:0001,0004,>¡Mario!<C:0003,0000,0A00> ¡Ya estamos listos!\nGracias por esperarnos.<C:0003,0001,><C:0000,0002,6400><C:0000,0004,>Oye...<C:0000,0002,6400><C:0003,0000,0A00> ¿Está GARABATEANDO?\n¡Pero qué falta de respeto!<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,6400><C:0000,0002,6400><C:0001,0004,>¡Mario!<C:0003,0000,0A00> ¡Ya estamos listos!\nGracias por esperarnos.<C:0003,0001,><C:0000,0002,6400><C:0000,0004,>Oye...<C:0000,0002,6400><C:0003,0000,0A00> ¿Está GARABATEANDO?\n¡Pero qué falta de respeto!<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,6400><C:0000,0002,6400><C:0001,0004,>¡Mario!<C:0003,0000,0A00> ¡Ya estamos listos!\nGracias por esperarnos.<C:0003,0001,><C:0000,0002,6400><C:0000,0004,>Oye...<C:0000,0002,6400><C:0003,0000,0A00> ¿Está GARABATEANDO?\n¡Pero qué falta de respeto!<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400>",
      "raw_full_hex": ""
    },
