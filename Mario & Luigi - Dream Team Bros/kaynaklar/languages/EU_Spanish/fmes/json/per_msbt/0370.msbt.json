    "15": {
      "text": "<C:0000,0002,6400><C:0001,0004,>¡Y llevaros hasta el lugar más profundo\ny recóndito! ¡Jua, jua, jua!<C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,6400><C:0001,0004,>¡Y llevaros hasta el lugar más profundo\ny recóndito! ¡Jua, jua, jua!<C:0003,0001,><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,6400><C:0001,0004,>¡Y llevaros hasta el lugar más profundo\ny recóndito! ¡Jua, jua, jua!<C:0003,0001,><C:0000,0002,6400>",
