    },
    "4": {
      "text": "Выглядит рискованно...<C:0003,0001,>",
      "tokenized_text": "Выглядит рискованно...<C:0003,0001,>",
      "original_text": "Выглядит рискованно...<C:0003,0001,>",
      "original_tokenized_text": "Выглядит рискованно...<C:0003,0001,>",
