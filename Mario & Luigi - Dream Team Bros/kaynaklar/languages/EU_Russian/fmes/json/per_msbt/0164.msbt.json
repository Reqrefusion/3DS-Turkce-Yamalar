    },
    "26": {
      "text": "<C:0001,0004,>Дать подсказочка?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Нет.         <C:0005,0001,>Да.<C:0000,0003,000000FF><C:0003,0000,0A00><C:0000,0003,000000FF>",
