      "raw_full_hex": "250435042D00450435042D00450435042100200024044B0420003C0435043D044F042000370435044004200043043404380432043804400435043D042C000A00470442043E042000440430043C0420004304340430043B043E0441044C04200034043E0431044004300442044C0441044F04200041044E04340430042E002E002E000E000300010000000000"
