    },
    "5": {
      "text": "<C:0007,0000,><C:0001,0001,><C:0001,0004,>Эй, Мракула!<C:0003,0000,1E00>",
      "tokenized_text": "<C:0007,0000,><C:0001,0001,><C:0001,0004,>Эй, Мракула!<C:0003,0000,1E00>",
      "original_text": "<C:0007,0000,><C:0001,0001,><C:0001,0004,>Эй, Мракула!<C:0003,0000,1E00>",
      "original_tokenized_text": "<C:0007,0000,><C:0001,0001,><C:0001,0004,>Эй, Мракула!<C:0003,0000,1E00>",
      "raw_full_hex": "0E000700000000000E000100010000000E000100040000002D0439042C0020001C04400430043A0443043B04300421000E000300000002001E000000"
    },
    "6": {
      "text": "Я не твой фройнд!<C:0003,0001,>",
      "tokenized_text": "Я не твой фройнд!<C:0003,0001,>",
      "original_text": "Я не твой фройнд!<C:0003,0001,>",
