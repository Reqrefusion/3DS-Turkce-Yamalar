      "raw_full_hex": "2F0420003D0435042000420432043E0439042000440440043E0439043D04340421000E000300010000000000"
    },
    "7": {
      "text": "Вас?! Что это\nзначить?!<C:0003,0001,>",
      "tokenized_text": "Вас?! Что это\nзначить?!<C:0003,0001,>",
      "original_text": "Вас?! Что это\nзначить?!<C:0003,0001,>",
      "original_tokenized_text": "Вас?! Что это\nзначить?!<C:0003,0001,>",
