    "22": {
      "text": "<C:0007,0000,><C:0001,0001,><C:0001,0004,><C:0000,0002,9600>А ВОТ И ХАЛТУРКА! УРА!<C:0000,0002,6400><C:0003,0000,2800>",
      "tokenized_text": "<C:0007,0000,><C:0001,0001,><C:0001,0004,><C:0000,0002,9600>А ВОТ И ХАЛТУРКА! УРА!<C:0000,0002,6400><C:0003,0000,2800>",
      "original_text": "<C:0007,0000,><C:0001,0001,><C:0001,0004,><C:0000,0002,9600>А ВОТ И ХАЛТУРКА! УРА!<C:0000,0002,6400><C:0003,0000,2800>",
      "original_tokenized_text": "<C:0007,0000,><C:0001,0001,><C:0001,0004,><C:0000,0002,9600>А ВОТ И ХАЛТУРКА! УРА!<C:0000,0002,6400><C:0003,0000,2800>",
