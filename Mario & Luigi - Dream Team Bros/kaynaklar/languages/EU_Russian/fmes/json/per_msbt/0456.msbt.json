    },
    "25": {
      "text": "Да уж! Деньги не пахнут...<C:0003,0001,>",
      "tokenized_text": "Да уж! Деньги не пахнут...<C:0003,0001,>",
      "original_text": "Да уж! Деньги не пахнут...<C:0003,0001,>",
