    },
    "26": {
      "text": "<C:0001,0001,><C:0001,0004,>Я внемлю вам.<C:0003,0001,>",
      "tokenized_text": "<C:0001,0001,><C:0001,0004,>Я внемлю вам.<C:0003,0001,>",
      "original_text": "<C:0001,0001,><C:0001,0004,>Я внемлю вам.<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0001,><C:0001,0004,>Я внемлю вам.<C:0003,0001,>",
