    },
    "2": {
      "text": "<C:0007,0000,><C:0001,0001,><C:0001,0004,>Чудно!<C:0003,0000,1400>",
      "tokenized_text": "<C:0007,0000,><C:0001,0001,><C:0001,0004,>Чудно!<C:0003,0000,1400>",
      "original_text": "<C:0007,0000,><C:0001,0001,><C:0001,0004,>Чудно!<C:0003,0000,1400>",
      "original_tokenized_text": "<C:0007,0000,><C:0001,0001,><C:0001,0004,>Чудно!<C:0003,0000,1400>",
      "raw_full_hex": "0E000700000000000E000100010000000E000100040000002704430434043D043E0421000E0003000000020014000000"
    },
    "3": {
      "text": "Марио! Луиджи!\nНе будем медлить!<C:0003,0001,>",
      "tokenized_text": "Марио! Луиджи!\nНе будем медлить!<C:0003,0001,>",
      "original_text": "Марио! Луиджи!\nНе будем медлить!<C:0003,0001,>",
