    "6": {
      "text": "<C:0001,0004,>За мной должок!<C:0003,0001,><C:0000,0004,>Знаете, что на хлеб\nне намажешь?<C:0000,0002,6400><C:0003,0000,1400> Спасибо!<C:0000,0002,6400><C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>За мной должок!<C:0003,0001,><C:0000,0004,>Знаете, что на хлеб\nне намажешь?<C:0000,0002,6400><C:0003,0000,1400> Спасибо!<C:0000,0002,6400><C:0003,0001,>",
      "original_text": "<C:0001,0004,>За мной должок!<C:0003,0001,><C:0000,0004,>Знаете, что на хлеб\nне намажешь?<C:0000,0002,6400><C:0003,0000,1400> Спасибо!<C:0000,0002,6400><C:0003,0001,>",
