    },
    "26": {
      "text": "<C:0001,0004,>Есть и другие...<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Есть и другие...<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Есть и другие...<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Есть и другие...<C:0003,0001,>",
