    },
    "18": {
      "text": "Ты погляди!<C:0003,0000,0A00> Разбили\nвсе валуны до единого!<C:0003,0001,>",
      "tokenized_text": "Ты погляди!<C:0003,0000,0A00> Разбили\nвсе валуны до единого!<C:0003,0001,>",
