    "2": {
      "text": "<C:0007,0000,><C:0001,0001,>Получен <C:0000,0003,00EAFFFF><C:0004,0000,000002000000><C:0000,0003,FFFFFFFF>-й элемент боевого\nприема из района Засыпей!<C:0003,0000,1E00><C:0003,0001,><C:0000,0004,><C:0007,0000,>В этой части острова\nсобраны все элементы!<C:0003,0000,0F00><C:0003,0001,><C:0000,0004,><C:0007,0000,>Вы освоили новый <C:0000,0003,00EAFFFF>дуплет<C:0000,0003,FFFFFFFF>!<C:0003,0000,0F00><C:0003,0001,>",
      "tokenized_text": "<C:0007,0000,><C:0001,0001,>Получен <C:0000,0003,00EAFFFF><C:0004,0000,000002000000><C:0000,0003,FFFFFFFF>-й элемент боевого\nприема из района Засыпей!<C:0003,0000,1E00><C:0003,0001,><C:0000,0004,><C:0007,0000,>В этой части острова\nсобраны все элементы!<C:0003,0000,0F00><C:0003,0001,><C:0000,0004,><C:0007,0000,>Вы освоили новый <C:0000,0003,00EAFFFF>дуплет<C:0000,0003,FFFFFFFF>!<C:0003,0000,0F00><C:0003,0001,>",
      "original_text": "<C:0007,0000,><C:0001,0001,>Получен <C:0000,0003,00EAFFFF><C:0004,0000,000002000000><C:0000,0003,FFFFFFFF>-й элемент боевого\nприема из района Засыпей!<C:0003,0000,1E00><C:0003,0001,><C:0000,0004,><C:0007,0000,>В этой части острова\nсобраны все элементы!<C:0003,0000,0F00><C:0003,0001,><C:0000,0004,><C:0007,0000,>Вы освоили новый <C:0000,0003,00EAFFFF>дуплет<C:0000,0003,FFFFFFFF>!<C:0003,0000,0F00><C:0003,0001,>",
      "original_tokenized_text": "<C:0007,0000,><C:0001,0001,>Получен <C:0000,0003,00EAFFFF><C:0004,0000,000002000000><C:0000,0003,FFFFFFFF>-й элемент боевого\nприема из района Засыпей!<C:0003,0000,1E00><C:0003,0001,><C:0000,0004,><C:0007,0000,>В этой части острова\nсобраны все элементы!<C:0003,0000,0F00><C:0003,0001,><C:0000,0004,><C:0007,0000,>Вы освоили новый <C:0000,0003,00EAFFFF>дуплет<C:0000,0003,FFFFFFFF>!<C:0003,0000,0F00><C:0003,0001,>",
      "raw_full_hex": ""
    },
    "3": {
      "text": "<C:0007,0000,>Отправиться в мир грез?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Нет.         <C:0005,0001,>Да.<C:0003,0000,0A00>",
      "tokenized_text": "<C:0007,0000,>Отправиться в мир грез?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Нет.         <C:0005,0001,>Да.<C:0003,0000,0A00>",
      "original_text": "<C:0007,0000,>Отправиться в мир грез?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Нет.         <C:0005,0001,>Да.<C:0003,0000,0A00>",
      "original_tokenized_text": "<C:0007,0000,>Отправиться в мир грез?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Нет.         <C:0005,0001,>Да.<C:0003,0000,0A00>",
      "raw_full_hex": "0E000700000000001E0442043F04400430043204380442044C0441044F042000320420003C0438044004200033044004350437043F000E000300000002000A000A000E000100010000000E000500010000001D04350442042E002000200020002000200020002000200020000E00050001000000140430042E000E000300000002000A000000"
