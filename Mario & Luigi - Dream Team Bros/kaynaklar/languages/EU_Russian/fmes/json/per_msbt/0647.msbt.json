{
  "0647.msbt": {
    "0": {
      "text": "Так-перетак! Не было бед —\nи вот те камуфлет!<C:0003,0001,>",
      "tokenized_text": "Так-перетак! Не было бед —\nи вот те камуфлет!<C:0003,0001,>",
      "original_text": "Так-перетак! Не было бед —\nи вот те камуфлет!<C:0003,0001,>",
      "original_tokenized_text": "Так-перетак! Не было бед —\nи вот те камуфлет!<C:0003,0001,>",
      "raw_full_hex": "220430043A042D003F04350440043504420430043A04210020001D043504200031044B043B043E042000310435043404200014200A003804200032043E04420420004204350420003A0430043C04430444043B043504420421000E000300010000000000"
    },
    "1": {
      "text": "Буря, так ее, повалила\nздоровенные валуны\nна наши дорожки!<C:0003,0001,>",
      "tokenized_text": "Буря, так ее, повалила\nздоровенные валуны\nна наши дорожки!<C:0003,0001,>",
      "original_text": "Буря, так ее, повалила\nздоровенные валуны\nна наши дорожки!<C:0003,0001,>",
      "original_tokenized_text": "Буря, так ее, повалила\nздоровенные валуны\nна наши дорожки!<C:0003,0001,>",
      "raw_full_hex": "1104430440044F042C002000420430043A042000350435042C0020003F043E04320430043B0438043B0430040A00370434043E0440043E04320435043D043D044B0435042000320430043B0443043D044B040A003D04300420003D04300448043804200034043E0440043E0436043A04380421000E000300010000000000"
    },
    "2": {
      "text": "Ну-ка, слушай\nмою команду!<C:0003,0001,>",
      "tokenized_text": "Ну-ка, слушай\nмою команду!<C:0003,0001,>",
      "original_text": "Ну-ка, слушай\nмою команду!<C:0003,0001,>",
      "original_tokenized_text": "Ну-ка, слушай\nмою команду!<C:0003,0001,>",
      "raw_full_hex": "1D0443042D003A0430042C00200041043B0443044804300439040A003C043E044E0420003A043E043C0430043D043404430421000E000300010000000000"
    },
    "3": {
      "text": "<C:0000,0002,9600>Ать-два!<C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,9600>Ать-два!<C:0003,0001,><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,9600>Ать-два!<C:0003,0001,><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,9600>Ать-два!<C:0003,0001,><C:0000,0002,6400>",
      "raw_full_hex": "0E000000020002009600100442044C042D0034043204300421000E000300010000000E0000000200020064000000"
    },
    "4": {
      "text": "Чтоб от забора и до обеда...\nя хотел сказать, до вечера\nвалуны убрали! Сми-и-ирна!<C:0003,0001,>",
      "tokenized_text": "Чтоб от забора и до обеда...\nя хотел сказать, до вечера\nвалуны убрали! Сми-и-ирна!<C:0003,0001,>",
      "original_text": "Чтоб от забора и до обеда...\nя хотел сказать, до вечера\nвалуны убрали! Сми-и-ирна!<C:0003,0001,>",
      "original_tokenized_text": "Чтоб от забора и до обеда...\nя хотел сказать, до вечера\nвалуны убрали! Сми-и-ирна!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "5": {
      "text": "До... вечера?!<C:0003,0001,>",
      "tokenized_text": "До... вечера?!<C:0003,0001,>",
      "original_text": "До... вечера?!<C:0003,0001,>",
      "original_tokenized_text": "До... вечера?!<C:0003,0001,>",
      "raw_full_hex": "14043E042E002E002E0020003204350447043504400430043F0021000E000300010000000000"
    },
    "6": {
      "text": "<C:0000,0002,9600><C:0001,0004,>Разговорчики в строю?!<C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,9600><C:0001,0004,>Разговорчики в строю?!<C:0003,0001,><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,9600><C:0001,0004,>Разговорчики в строю?!<C:0003,0001,><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,9600><C:0001,0004,>Разговорчики в строю?!<C:0003,0001,><C:0000,0002,6400>",
      "raw_full_hex": "0E0000000200020096000E0001000400000020043004370433043E0432043E044004470438043A0438042000320420004104420440043E044E043F0021000E000300010000000E0000000200020064000000"
    },
    "7": {
      "text": "Здесь вам не тут!<C:0003,0001,>",
      "tokenized_text": "Здесь вам не тут!<C:0003,0001,>",
      "original_text": "Здесь вам не тут!<C:0003,0001,>",
      "original_tokenized_text": "Здесь вам не тут!<C:0003,0001,>",
      "raw_full_hex": "17043404350441044C042000320430043C0420003D043504200042044304420421000E000300010000000000"
    },
    "8": {
      "text": "Здесь приказы не обсуждаются,\nа неукоснительно выполняются!<C:0003,0001,>",
      "tokenized_text": "Здесь приказы не обсуждаются,\nа неукоснительно выполняются!<C:0003,0001,>",
      "original_text": "Здесь приказы не обсуждаются,\nа неукоснительно выполняются!<C:0003,0001,>",
      "original_tokenized_text": "Здесь приказы не обсуждаются,\nа неукоснительно выполняются!<C:0003,0001,>",
      "raw_full_hex": "17043404350441044C0420003F04400438043A04300437044B0420003D04350420003E043104410443043604340430044E04420441044F042C000A00300420003D04350443043A043E0441043D043804420435043B044C043D043E04200032044B043F043E043B043D044F044E04420441044F0421000E000300010000000000"
    },
    "9": {
      "text": "Начальство\nвсегда право!<C:0003,0001,>",
      "tokenized_text": "Начальство\nвсегда право!<C:0003,0001,>",
      "original_text": "Начальство\nвсегда право!<C:0003,0001,>",
      "original_tokenized_text": "Начальство\nвсегда право!<C:0003,0001,>",
      "raw_full_hex": "1D043004470430043B044C044104420432043E040A0032044104350433043404300420003F044004300432043E0421000E000300010000000000"
    },
    "10": {
      "text": "Т-так точно!\nБудет исполнено!<C:0003,0001,>",
      "tokenized_text": "Т-так точно!\nБудет исполнено!<C:0003,0001,>",
      "original_text": "Т-так точно!\nБудет исполнено!<C:0003,0001,>",
      "original_tokenized_text": "Т-так точно!\nБудет исполнено!<C:0003,0001,>",
      "raw_full_hex": "22042D00420430043A04200042043E0447043D043E0421000A00110443043404350442042000380441043F043E043B043D0435043D043E0421000E000300010000000000"
    },
    "11": {
      "text": "Эй, вы! Откуда\nвзялись, усатые?<C:0003,0001,>",
      "tokenized_text": "Эй, вы! Откуда\nвзялись, усатые?<C:0003,0001,>",
      "original_text": "Эй, вы! Откуда\nвзялись, усатые?<C:0003,0001,>",
      "original_tokenized_text": "Эй, вы! Откуда\nвзялись, усатые?<C:0003,0001,>",
      "raw_full_hex": "2D0439042C00200032044B04210020001E0442043A044304340430040A00320437044F043B04380441044C042C00200043044104300442044B0435043F000E000300010000000000"
    },
    "12": {
      "text": "Нет времени болтать\nс разными салагами!<C:0003,0001,><C:0000,0004,>Валуны надо громить!\nПобеда будет наша!<C:0003,0001,>",
      "tokenized_text": "Нет времени болтать\nс разными салагами!<C:0003,0001,><C:0000,0004,>Валуны надо громить!\nПобеда будет наша!<C:0003,0001,>",
      "original_text": "Нет времени болтать\nс разными салагами!<C:0003,0001,><C:0000,0004,>Валуны надо громить!\nПобеда будет наша!<C:0003,0001,>",
      "original_tokenized_text": "Нет времени болтать\nс разными салагами!<C:0003,0001,><C:0000,0004,>Валуны надо громить!\nПобеда будет наша!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "13": {
      "text": "Чего-чего?<C:0003,0001,>",
      "tokenized_text": "Чего-чего?<C:0003,0001,>",
      "original_text": "Чего-чего?<C:0003,0001,>",
      "original_tokenized_text": "Чего-чего?<C:0003,0001,>",
      "raw_full_hex": "2704350433043E042D004704350433043E043F000E000300010000000000"
    },
    "14": {
      "text": "<C:0001,0001,><C:0001,0004,>Эй!<C:0003,0000,1E00>",
      "tokenized_text": "<C:0001,0001,><C:0001,0004,>Эй!<C:0003,0000,1E00>",
      "original_text": "<C:0001,0001,><C:0001,0004,>Эй!<C:0003,0000,1E00>",
      "original_tokenized_text": "<C:0001,0001,><C:0001,0004,>Эй!<C:0003,0000,1E00>",
      "raw_full_hex": "0E000100010000000E000100040000002D04390421000E000300000002001E000000"
    },
    "15": {
      "text": "<C:0001,0001,><C:0001,0004,><C:0000,0002,9600>Ежкин хвост!<C:0003,0000,1E00><C:0000,0002,6400>",
      "tokenized_text": "<C:0001,0001,><C:0001,0004,><C:0000,0002,9600>Ежкин хвост!<C:0003,0000,1E00><C:0000,0002,6400>",
      "original_text": "<C:0001,0001,><C:0001,0004,><C:0000,0002,9600>Ежкин хвост!<C:0003,0000,1E00><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0001,0001,><C:0001,0004,><C:0000,0002,9600>Ежкин хвост!<C:0003,0000,1E00><C:0000,0002,6400>",
      "raw_full_hex": "0E000100010000000E000100040000000E000000020002009600150436043A0438043D042000450432043E044104420421000E000300000002001E000E0000000200020064000000"
    },
    "16": {
      "text": "Ты тут необычную подушку\nне видел, случайно, ать-два?<C:0003,0001,>",
      "tokenized_text": "Ты тут необычную подушку\nне видел, случайно, ать-два?<C:0003,0001,>",
      "original_text": "Ты тут необычную подушку\nне видел, случайно, ать-два?<C:0003,0001,>",
      "original_tokenized_text": "Ты тут необычную подушку\nне видел, случайно, ать-два?<C:0003,0001,>",
      "raw_full_hex": "22044B04200042044304420420003D0435043E0431044B0447043D0443044E0420003F043E043404430448043A0443040A003D043504200032043804340435043B042C00200041043B0443044704300439043D043E042C002000300442044C042D003404320430043F000E000300010000000000"
    },
    "17": {
      "text": "Старая такая подушенция.\nПыльная, наверное, да грязная.<C:0003,0001,><C:0000,0004,>Может, она где-то тут\nоказалась, в парке?<C:0003,0001,>",
      "tokenized_text": "Старая такая подушенция.\nПыльная, наверное, да грязная.<C:0003,0001,><C:0000,0004,>Может, она где-то тут\nоказалась, в парке?<C:0003,0001,>",
      "original_text": "Старая такая подушенция.\nПыльная, наверное, да грязная.<C:0003,0001,><C:0000,0004,>Может, она где-то тут\nоказалась, в парке?<C:0003,0001,>",
      "original_tokenized_text": "Старая такая подушенция.\nПыльная, наверное, да грязная.<C:0003,0001,><C:0000,0004,>Может, она где-то тут\nоказалась, в парке?<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "18": {
      "text": "А-а-а...<C:0003,0000,1400> Эта, штоль?<C:0003,0001,>",
      "tokenized_text": "А-а-а...<C:0003,0000,1400> Эта, штоль?<C:0003,0001,>",
      "original_text": "А-а-а...<C:0003,0000,1400> Эта, штоль?<C:0003,0001,>",
      "original_tokenized_text": "А-а-а...<C:0003,0000,1400> Эта, штоль?<C:0003,0001,>",
      "raw_full_hex": "10042D0030042D0030042E002E002E000E00030000000200140020002D04420430042C002000480442043E043B044C043F000E000300010000000000"
    },
    "19": {
      "text": "Да их тут по парку\nраскидано — бери не хочу.<C:0003,0001,><C:0000,0004,>Но эта подушка — моя\nлюбимая, усекла?<C:0003,0001,>",
      "tokenized_text": "Да их тут по парку\nраскидано — бери не хочу.<C:0003,0001,><C:0000,0004,>Но эта подушка — моя\nлюбимая, усекла?<C:0003,0001,>",
      "original_text": "Да их тут по парку\nраскидано — бери не хочу.<C:0003,0001,><C:0000,0004,>Но эта подушка — моя\nлюбимая, усекла?<C:0003,0001,>",
      "original_tokenized_text": "Да их тут по парку\nраскидано — бери не хочу.<C:0003,0001,><C:0000,0004,>Но эта подушка — моя\nлюбимая, усекла?<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "20": {
      "text": "Такая загадочная вся,\nдревняя. Мой талисман!<C:0003,0001,>",
      "tokenized_text": "Такая загадочная вся,\nдревняя. Мой талисман!<C:0003,0001,>",
      "original_text": "Такая загадочная вся,\nдревняя. Мой талисман!<C:0003,0001,>",
      "original_tokenized_text": "Такая загадочная вся,\nдревняя. Мой талисман!<C:0003,0001,>",
      "raw_full_hex": "220430043A0430044F042000370430043304300434043E0447043D0430044F042000320441044F042C000A0034044004350432043D044F044F042E0020001C043E0439042000420430043B04380441043C0430043D0421000E000300010000000000"
    },
    "21": {
      "text": "Мы именно\nее и ищем!<C:0003,0001,>",
      "tokenized_text": "Мы именно\nее и ищем!<C:0003,0001,>",
      "original_text": "Мы именно\nее и ищем!<C:0003,0001,>",
      "original_tokenized_text": "Мы именно\nее и ищем!<C:0003,0001,>",
      "raw_full_hex": "1C044B04200038043C0435043D043D043E040A00350435042000380420003804490435043C0421000E000300010000000000"
    },
    "22": {
      "text": "Что-то я не уловил...<C:0003,0001,>",
      "tokenized_text": "Что-то я не уловил...<C:0003,0001,>",
      "original_text": "Что-то я не уловил...<C:0003,0001,>",
      "original_tokenized_text": "Что-то я не уловил...<C:0003,0001,>",
      "raw_full_hex": "270442043E042D0042043E0420004F0420003D043504200043043B043E04320438043B042E002E002E000E000300010000000000"
    },
    "23": {
      "text": "Нарисовались тут в моем саду,\nчтобы отобрать мой талисман?<C:0003,0001,><C:0000,0004,>Да вы, салажата, даете!<C:0003,0001,>",
      "tokenized_text": "Нарисовались тут в моем саду,\nчтобы отобрать мой талисман?<C:0003,0001,><C:0000,0004,>Да вы, салажата, даете!<C:0003,0001,>",
      "original_text": "Нарисовались тут в моем саду,\nчтобы отобрать мой талисман?<C:0003,0001,><C:0000,0004,>Да вы, салажата, даете!<C:0003,0001,>",
      "original_tokenized_text": "Нарисовались тут в моем саду,\nчтобы отобрать мой талисман?<C:0003,0001,><C:0000,0004,>Да вы, салажата, даете!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "24": {
      "text": "Хотите подушку?! А отобрать\nу старика не слабо, наглецы?<C:0003,0001,>",
      "tokenized_text": "Хотите подушку?! А отобрать\nу старика не слабо, наглецы?<C:0003,0001,>",
      "original_text": "Хотите подушку?! А отобрать\nу старика не слабо, наглецы?<C:0003,0001,>",
      "original_tokenized_text": "Хотите подушку?! А отобрать\nу старика не слабо, наглецы?<C:0003,0001,>",
      "raw_full_hex": "25043E04420438044204350420003F043E043404430448043A0443043F0021002000100420003E0442043E0431044004300442044C040A0043042000410442043004400438043A04300420003D043504200041043B04300431043E042C0020003D04300433043B04350446044B043F000E000300010000000000"
    },
    "25": {
      "text": "<C:0000,0002,9600><C:0001,0004,>Нет! Постой!<C:0000,0002,6400><C:0000,0002,9600><C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,9600><C:0001,0004,>Нет! Постой!<C:0000,0002,6400><C:0000,0002,9600><C:0003,0001,><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,9600><C:0001,0004,>Нет! Постой!<C:0000,0002,6400><C:0000,0002,9600><C:0003,0001,><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,9600><C:0001,0004,>Нет! Постой!<C:0000,0002,6400><C:0000,0002,9600><C:0003,0001,><C:0000,0002,6400>",
      "raw_full_hex": "0E0000000200020096000E000100040000001D0435044204210020001F043E04410442043E04390421000E0000000200020064000E0000000200020096000E000300010000000E0000000200020064000000"
    },
    "26": {
      "text": "Марио! Луиджи!\nБыстро за ним!<C:0003,0001,>",
      "tokenized_text": "Марио! Луиджи!\nБыстро за ним!<C:0003,0001,>",
      "original_text": "Марио! Луиджи!\nБыстро за ним!<C:0003,0001,>",
      "original_tokenized_text": "Марио! Луиджи!\nБыстро за ним!<C:0003,0001,>",
      "raw_full_hex": "1C043004400438043E04210020001B044304380434043604380421000A0011044B044104420440043E0420003704300420003D0438043C0421000E000300010000000000"
    },
    "27": {
      "text": "<C:0000,0002,9600><C:0001,0004,>Ох ты ж!<C:0003,0000,2800><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,9600><C:0001,0004,>Ох ты ж!<C:0003,0000,2800><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,9600><C:0001,0004,>Ох ты ж!<C:0003,0000,2800><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,9600><C:0001,0004,>Ох ты ж!<C:0003,0000,2800><C:0000,0002,6400>",
      "raw_full_hex": "0E0000000200020096000E000100040000001E044504200042044B042000360421000E0003000000020028000E0000000200020064000000"
    },
    "28": {
      "text": "Лопасти оторвало,\nэнергии больше нет!<C:0003,0001,>",
      "tokenized_text": "Лопасти оторвало,\nэнергии больше нет!<C:0003,0001,>",
      "original_text": "Лопасти оторвало,\nэнергии больше нет!<C:0003,0001,>",
      "original_tokenized_text": "Лопасти оторвало,\nэнергии больше нет!<C:0003,0001,>",
      "raw_full_hex": "1B043E043F04300441044204380420003E0442043E044004320430043B043E042C000A004D043D0435044004330438043804200031043E043B044C044804350420003D043504420421000E000300010000000000"
    },
    "29": {
      "text": "И фонтан затих!<C:0003,0001,>",
      "tokenized_text": "И фонтан затих!<C:0003,0001,>",
      "original_text": "И фонтан затих!<C:0003,0001,>",
      "original_tokenized_text": "И фонтан затих!<C:0003,0001,>",
      "raw_full_hex": "1804200044043E043D04420430043D0420003704300442043804450421000E000300010000000000"
    },
