      "original_tokenized_text": "",
      "raw_full_hex": "0000"
    },
    "31": {
      "text": "Эти цветы были гордостью\nЗаресада! Как же быть?!<C:0003,0000,F401>",
      "tokenized_text": "Эти цветы были гордостью\nЗаресада! Как же быть?!<C:0003,0000,F401>",
