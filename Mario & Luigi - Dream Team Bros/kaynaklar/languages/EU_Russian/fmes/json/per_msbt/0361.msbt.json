    "8": {
      "text": "<C:0001,0004,>Впереди неизведанные\nглубины мира грез!<C:0003,0001,><C:0000,0004,>Поверьте, уж там-то принцессу\nПич никто в жизни не найдет!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Впереди неизведанные\nглубины мира грез!<C:0003,0001,><C:0000,0004,>Поверьте, уж там-то принцессу\nПич никто в жизни не найдет!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Впереди неизведанные\nглубины мира грез!<C:0003,0001,><C:0000,0004,>Поверьте, уж там-то принцессу\nПич никто в жизни не найдет!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Впереди неизведанные\nглубины мира грез!<C:0003,0001,><C:0000,0004,>Поверьте, уж там-то принцессу\nПич никто в жизни не найдет!<C:0003,0001,>",
      "raw_full_hex": ""
    },
