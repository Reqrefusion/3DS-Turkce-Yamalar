    },
    "8": {
      "text": "<C:0001,0004,>Я снова жив!<C:0003,0000,0A00>\nЯ могу двигаться!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Я снова жив!<C:0003,0000,0A00>\nЯ могу двигаться!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Я снова жив!<C:0003,0000,0A00>\nЯ могу двигаться!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Я снова жив!<C:0003,0000,0A00>\nЯ могу двигаться!<C:0003,0001,>",
