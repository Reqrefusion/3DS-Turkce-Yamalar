    "9": {
      "text": "<C:0001,0004,>Спасибо, смельчаки!<C:0003,0001,><C:0000,0004,>Нелегко веками быть\nкамнем, уж поверьте.<C:0003,0001,><C:0000,0004,>Я вам очень обязан!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Спасибо, смельчаки!<C:0003,0001,><C:0000,0004,>Нелегко веками быть\nкамнем, уж поверьте.<C:0003,0001,><C:0000,0004,>Я вам очень обязан!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Спасибо, смельчаки!<C:0003,0001,><C:0000,0004,>Нелегко веками быть\nкамнем, уж поверьте.<C:0003,0001,><C:0000,0004,>Я вам очень обязан!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Спасибо, смельчаки!<C:0003,0001,><C:0000,0004,>Нелегко веками быть\nкамнем, уж поверьте.<C:0003,0001,><C:0000,0004,>Я вам очень обязан!<C:0003,0001,>",
