    "12": {
      "text": "<C:0007,0000,>Чего вам?<C:0003,0000,0A00>\n <C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Что новенького?\n <C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Помоги попасть в мир грез!\n <C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Ну, мы пойдем.<C:0003,0000,0A00>",
      "tokenized_text": "<C:0007,0000,>Чего вам?<C:0003,0000,0A00>\n <C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Что новенького?\n <C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Помоги попасть в мир грез!\n <C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Ну, мы пойдем.<C:0003,0000,0A00>",
      "original_text": "<C:0007,0000,>Чего вам?<C:0003,0000,0A00>\n <C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Что новенького?\n <C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Помоги попасть в мир грез!\n <C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Ну, мы пойдем.<C:0003,0000,0A00>",
      "original_tokenized_text": "<C:0007,0000,>Чего вам?<C:0003,0000,0A00>\n <C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Что новенького?\n <C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Помоги попасть в мир грез!\n <C:0005,0001,><C:0000,0003,FFFFFFFF><C:0008,0001,0A00><C:0000,0003,000000FF>Ну, мы пойдем.<C:0003,0000,0A00>",
      "raw_full_hex": ""
