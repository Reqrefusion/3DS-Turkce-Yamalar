    "14": {
      "text": "Парни, хавчик есть?<C:0003,0001,>",
      "tokenized_text": "Парни, хавчик есть?<C:0003,0001,>",
      "original_text": "Парни, хавчик есть?<C:0003,0001,>",
      "original_tokenized_text": "Парни, хавчик есть?<C:0003,0001,>",
