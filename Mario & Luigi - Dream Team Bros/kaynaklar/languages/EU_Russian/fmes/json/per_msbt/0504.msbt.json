    },
    "5": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Вот так вихрь,\nоднако же!<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Вот так вихрь,\nоднако же!<C:0003,0001,><C:0000,0003,000000FF>",
