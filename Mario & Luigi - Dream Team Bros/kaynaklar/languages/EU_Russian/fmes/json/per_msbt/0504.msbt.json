      "raw_full_hex": "0E00000003000400000000FF0E0001000400000013043C042E002E002E000E000300010000000E00000003000400000000FF0000"
    },
    "7": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>А вдруг вы сами можете\nсоздать такой вихрь?<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>А вдруг вы сами можете\nсоздать такой вихрь?<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>А вдруг вы сами можете\nсоздать такой вихрь?<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>А вдруг вы сами можете\nсоздать такой вихрь?<C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": "0E00000003000400000000FF0E000100040000001004200032043404400443043304200032044B042000410430043C04380420003C043E0436043504420435040A0041043E0437043404300442044C042000420430043A043E043904200032043804450440044C043F000E000300010000000E00000003000400000000FF0000"
    },
    "8": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Вижу еще один сугроб\nтам впереди...<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Вижу еще один сугроб\nтам впереди...<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Вижу еще один сугроб\nтам впереди...<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Вижу еще один сугроб\nтам впереди...<C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": "0E00000003000400000000FF0E000100040000001204380436044304200035044904350420003E04340438043D04200041044304330440043E0431040A00420430043C04200032043F04350440043504340438042E002E002E000E000300010000000E00000003000400000000FF0000"
    },
    "9": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Попробуем сдуть\nего вихрем.<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Попробуем сдуть\nего вихрем.<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Попробуем сдуть\nего вихрем.<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Попробуем сдуть\nего вихрем.<C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": "0E00000003000400000000FF0E000100040000001F043E043F0440043E043104430435043C04200041043404430442044C040A00350433043E042000320438044504400435043C042E000E000300010000000E00000003000400000000FF0000"
