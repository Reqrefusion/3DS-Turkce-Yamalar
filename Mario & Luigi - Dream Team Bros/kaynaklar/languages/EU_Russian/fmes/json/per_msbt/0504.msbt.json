    "11": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>О, что за диво-вихрь!\nЕдины ветер и душа!<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>О, что за диво-вихрь!\nЕдины ветер и душа!<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>О, что за диво-вихрь!\nЕдины ветер и душа!<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>О, что за диво-вихрь!\nЕдины ветер и душа!<C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": "0E00000003000400000000FF0E000100040000001E042C002000470442043E0420003704300420003404380432043E042D0032043804450440044C0421000A001504340438043D044B04200032043504420435044004200038042000340443044804300421000E000300010000000E00000003000400000000FF0000"
    },
    "12": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Все ли в порядке?!<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Все ли в порядке?!<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Все ли в порядке?!<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Все ли в порядке?!<C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": "0E00000003000400000000FF0E0001000400000012044104350420003B0438042000320420003F043E0440044F0434043A0435043F0021000E000300010000000E00000003000400000000FF0000"
    },
    "13": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>О, чудо из чудес!\nПокорители ветров!<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>О, чудо из чудес!\nПокорители ветров!<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>О, чудо из чудес!\nПокорители ветров!<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>О, чудо из чудес!\nПокорители ветров!<C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": "0E00000003000400000000FF0E000100040000001E042C0020004704430434043E0420003804370420004704430434043504410421000A001F043E043A043E0440043804420435043B043804200032043504420440043E04320421000E000300010000000E00000003000400000000FF0000"
    },
