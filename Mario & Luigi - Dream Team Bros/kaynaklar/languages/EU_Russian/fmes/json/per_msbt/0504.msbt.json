      "text": "<C:0000,0002,9600><C:0000,0003,000000FF><C:0001,0004,><C:0000,0002,9600>А-а-а!<C:0000,0002,9600><C:0000,0003,000000FF><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,9600><C:0000,0003,000000FF><C:0001,0004,><C:0000,0002,9600>А-а-а!<C:0000,0002,9600><C:0000,0003,000000FF><C:0000,0002,6400>",
