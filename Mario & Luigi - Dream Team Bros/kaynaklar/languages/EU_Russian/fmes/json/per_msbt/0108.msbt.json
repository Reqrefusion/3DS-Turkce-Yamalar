    },
    "13": {
      "text": "Ну, добре!\nСпробуйте-ка!<C:0003,0001,>",
      "tokenized_text": "Ну, добре!\nСпробуйте-ка!<C:0003,0001,>",
      "original_text": "Ну, добре!\nСпробуйте-ка!<C:0003,0001,>",
      "original_tokenized_text": "Ну, добре!\nСпробуйте-ка!<C:0003,0001,>",
