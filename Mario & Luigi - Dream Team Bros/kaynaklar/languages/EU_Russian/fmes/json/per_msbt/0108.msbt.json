    "8": {
      "text": "<C:0007,0000,><C:0001,0001,><C:0001,0004,><C:0000,0002,9600>ЮЛЫ-БАМБУЛО!<C:0000,0002,6400><C:0003,0000,3C00>",
      "tokenized_text": "<C:0007,0000,><C:0001,0001,><C:0001,0004,><C:0000,0002,9600>ЮЛЫ-БАМБУЛО!<C:0000,0002,6400><C:0003,0000,3C00>",
      "original_text": "<C:0007,0000,><C:0001,0001,><C:0001,0004,><C:0000,0002,9600>ЮЛЫ-БАМБУЛО!<C:0000,0002,6400><C:0003,0000,3C00>",
