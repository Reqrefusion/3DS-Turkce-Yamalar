    },
    "14": {
      "text": "<C:0000,0003,2C65FFFF>Дважды <C:0000,0003,000000FF>нажмите кнопку <C:0000,0003,2C65FFFF>R<C:0000,0003,000000FF>,\nшоб значок правильный был!",
      "tokenized_text": "<C:0000,0003,2C65FFFF>Дважды <C:0000,0003,000000FF>нажмите кнопку <C:0000,0003,2C65FFFF>R<C:0000,0003,000000FF>,\nшоб значок правильный был!",
      "original_text": "<C:0000,0003,2C65FFFF>Дважды <C:0000,0003,000000FF>нажмите кнопку <C:0000,0003,2C65FFFF>R<C:0000,0003,000000FF>,\nшоб значок правильный был!",
      "original_tokenized_text": "<C:0000,0003,2C65FFFF>Дважды <C:0000,0003,000000FF>нажмите кнопку <C:0000,0003,2C65FFFF>R<C:0000,0003,000000FF>,\nшоб значок правильный был!",
      "raw_full_hex": ""
