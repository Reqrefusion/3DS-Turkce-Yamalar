  "0343.msbt": {
    "0": {
      "text": "<C:0007,0000,>Отправиться в мир грез?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Нет.         <C:0005,0001,>Да.<C:0003,0000,0A00>",
      "tokenized_text": "<C:0007,0000,>Отправиться в мир грез?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Нет.         <C:0005,0001,>Да.<C:0003,0000,0A00>",
      "original_text": "<C:0007,0000,>Отправиться в мир грез?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Нет.         <C:0005,0001,>Да.<C:0003,0000,0A00>",
      "original_tokenized_text": "<C:0007,0000,>Отправиться в мир грез?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Нет.         <C:0005,0001,>Да.<C:0003,0000,0A00>",
      "raw_full_hex": "0E000700000000001E0442043F04400430043204380442044C0441044F042000320420003C0438044004200033044004350437043F000E000300000002000A000A000E000100010000000E000500010000001D04350442042E002000200020002000200020002000200020000E00050001000000140430042E000E000300000002000A000000"
    },
    "1": {
      "text": "<C:0007,0000,><C:0001,0001,><C:0001,0004,>Остановитесь!<C:0003,0000,1E00>",
      "tokenized_text": "<C:0007,0000,><C:0001,0001,><C:0001,0004,>Остановитесь!<C:0003,0000,1E00>",
      "original_text": "<C:0007,0000,><C:0001,0001,><C:0001,0004,>Остановитесь!<C:0003,0000,1E00>",
      "original_tokenized_text": "<C:0007,0000,><C:0001,0001,><C:0001,0004,>Остановитесь!<C:0003,0000,1E00>",
      "raw_full_hex": "0E000700000000000E000100010000000E000100040000001E044104420430043D043E04320438044204350441044C0421000E000300000002001E000000"
    },
    "2": {
      "text": "За дверью сей...<C:0003,0001,>",
      "tokenized_text": "За дверью сей...<C:0003,0001,>",
      "original_text": "За дверью сей...<C:0003,0001,>",
      "original_tokenized_text": "За дверью сей...<C:0003,0001,>",
      "raw_full_hex": "17043004200034043204350440044C044E0420004104350439042E002E002E000E000300010000000000"
    },
    "3": {
      "text": "Коварный Мракула!<C:0003,0001,>",
      "tokenized_text": "Коварный Мракула!<C:0003,0001,>",
      "original_text": "Коварный Мракула!<C:0003,0001,>",
      "original_tokenized_text": "Коварный Мракула!<C:0003,0001,>",
      "raw_full_hex": "1A043E043204300440043D044B04390420001C04400430043A0443043B04300421000E000300010000000000"
    },
    "4": {
      "text": "Марио! Луиджи!\nПришло время завершить начатое!<C:0003,0001,>",
      "tokenized_text": "Марио! Луиджи!\nПришло время завершить начатое!<C:0003,0001,>",
      "original_text": "Марио! Луиджи!\nПришло время завершить начатое!<C:0003,0001,>",
      "original_tokenized_text": "Марио! Луиджи!\nПришло время завершить начатое!<C:0003,0001,>",
      "raw_full_hex": "1C043004400438043E04210020001B044304380434043604380421000A001F044004380448043B043E0420003204400435043C044F042000370430043204350440044804380442044C0420003D0430044704300442043E04350421000E000300010000000000"
    },
    "5": {
      "text": "Это пламя...<C:0003,0001,>",
      "tokenized_text": "Это пламя...<C:0003,0001,>",
      "original_text": "Это пламя...<C:0003,0001,>",
      "original_tokenized_text": "Это пламя...<C:0003,0001,>",
      "raw_full_hex": "2D0442043E0420003F043B0430043C044F042E002E002E000E000300010000000000"
    },
    "6": {
      "text": "Из недр мира грез оно...<C:0003,0001,>",
      "tokenized_text": "Из недр мира грез оно...<C:0003,0001,>",
      "original_text": "Из недр мира грез оно...<C:0003,0001,>",
      "original_tokenized_text": "Из недр мира грез оно...<C:0003,0001,>",
      "raw_full_hex": "1804370420003D0435043404400420003C043804400430042000330440043504370420003E043D043E042E002E002E000E000300010000000000"
    },
    "7": {
      "text": "Сомнений нет — чтобы затушить его, \nнам нужно отправиться туда.<C:0003,0001,>",
      "tokenized_text": "Сомнений нет — чтобы затушить его, \nнам нужно отправиться туда.<C:0003,0001,>",
      "original_text": "Сомнений нет — чтобы затушить его, \nнам нужно отправиться туда.<C:0003,0001,>",
      "original_tokenized_text": "Сомнений нет — чтобы затушить его, \nнам нужно отправиться туда.<C:0003,0001,>",
      "raw_full_hex": "21043E043C043D0435043D043804390420003D0435044204200014202000470442043E0431044B04200037043004420443044804380442044C042000350433043E042C0020000A003D0430043C0420003D04430436043D043E0420003E0442043F04400430043204380442044C0441044F04200042044304340430042E000E000300010000000000"
    },
    "8": {
      "text": "Недалече от пламени\nдолжна быть сономалия!<C:0003,0001,><C:0000,0004,><C:0001,0001,><C:0001,0004,>Разыщем же ее и угасим огонь!<C:0003,0001,>",
      "tokenized_text": "Недалече от пламени\nдолжна быть сономалия!<C:0003,0001,><C:0000,0004,><C:0001,0001,><C:0001,0004,>Разыщем же ее и угасим огонь!<C:0003,0001,>",
      "original_text": "Недалече от пламени\nдолжна быть сономалия!<C:0003,0001,><C:0000,0004,><C:0001,0001,><C:0001,0004,>Разыщем же ее и угасим огонь!<C:0003,0001,>",
      "original_tokenized_text": "Недалече от пламени\nдолжна быть сономалия!<C:0003,0001,><C:0000,0004,><C:0001,0001,><C:0001,0004,>Разыщем же ее и угасим огонь!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "9": {
      "text": "<C:0007,0000,><C:0001,0001,><C:0001,0004,>Ей-ей!<C:0003,0000,1E00>",
      "tokenized_text": "<C:0007,0000,><C:0001,0001,><C:0001,0004,>Ей-ей!<C:0003,0000,1E00>",
      "original_text": "<C:0007,0000,><C:0001,0001,><C:0001,0004,>Ей-ей!<C:0003,0000,1E00>",
      "original_tokenized_text": "<C:0007,0000,><C:0001,0001,><C:0001,0004,>Ей-ей!<C:0003,0000,1E00>",
      "raw_full_hex": "0E000700000000000E000100010000000E00010004000000150439042D003504390421000E000300000002001E000000"
    },
    "10": {
      "text": "Осталось два еще! \nБез промедления вперед!<C:0003,0001,>",
      "tokenized_text": "Осталось два еще! \nБез промедления вперед!<C:0003,0001,>",
      "original_text": "Осталось два еще! \nБез промедления вперед!<C:0003,0001,>",
