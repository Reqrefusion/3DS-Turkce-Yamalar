    "10": {
      "text": "Speravi davvero di servirti\ndi me, il grande Bowser?!<C:0003,0001,><C:0000,0004,>Sono io che ti ho usato\nfinora!<C:0003,0001,>",
      "tokenized_text": "Speravi davvero di servirti\ndi me, il grande Bowser?!<C:0003,0001,><C:0000,0004,>Sono io che ti ho usato\nfinora!<C:0003,0001,>",
      "original_text": "Speravi davvero di servirti\ndi me, il grande Bowser?!<C:0003,0001,><C:0000,0004,>Sono io che ti ho usato\nfinora!<C:0003,0001,>",
      "original_tokenized_text": "Speravi davvero di servirti\ndi me, il grande Bowser?!<C:0003,0001,><C:0000,0004,>Sono io che ti ho usato\nfinora!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "11": {
      "text": "Non è possibile!\nCome hai potuto?!<C:0003,0001,>",
