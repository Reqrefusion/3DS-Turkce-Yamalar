    },
    "12": {
      "text": "Ora ti chiarisco le idee: hai presente questo\ncastello? Peach? La Pietra onirica?<C:0003,0001,><C:0000,0004,>È TUTTA ROBA MIA! E non la dividerò\ncon nessuno!<C:0003,0001,>",
      "tokenized_text": "Ora ti chiarisco le idee: hai presente questo\ncastello? Peach? La Pietra onirica?<C:0003,0001,><C:0000,0004,>È TUTTA ROBA MIA! E non la dividerò\ncon nessuno!<C:0003,0001,>",
      "original_text": "Ora ti chiarisco le idee: hai presente questo\ncastello? Peach? La Pietra onirica?<C:0003,0001,><C:0000,0004,>È TUTTA ROBA MIA! E non la dividerò\ncon nessuno!<C:0003,0001,>",
      "original_tokenized_text": "Ora ti chiarisco le idee: hai presente questo\ncastello? Peach? La Pietra onirica?<C:0003,0001,><C:0000,0004,>È TUTTA ROBA MIA! E non la dividerò\ncon nessuno!<C:0003,0001,>",
      "raw_full_hex": ""
