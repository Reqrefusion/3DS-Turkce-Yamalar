    "30": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,><C:0007,0000,><C:0001,0001,><C:0000,0003,FFFFFFFF>Hai ottenuto un <C:0000,0003,00EAFFFF>Uovo onirico<C:0000,0003,FFFFFFFF>!<C:0000,0003,000000FF><C:0003,0000,1E00><C:0003,0001,><C:0000,0003,FFFFFFFF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,><C:0007,0000,><C:0001,0001,><C:0000,0003,FFFFFFFF>Hai ottenuto un <C:0000,0003,00EAFFFF>Uovo onirico<C:0000,0003,FFFFFFFF>!<C:0000,0003,000000FF><C:0003,0000,1E00><C:0003,0001,><C:0000,0003,FFFFFFFF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,><C:0007,0000,><C:0001,0001,><C:0000,0003,FFFFFFFF>Hai ottenuto un <C:0000,0003,00EAFFFF>Uovo onirico<C:0000,0003,FFFFFFFF>!<C:0000,0003,000000FF><C:0003,0000,1E00><C:0003,0001,><C:0000,0003,FFFFFFFF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,><C:0007,0000,><C:0001,0001,><C:0000,0003,FFFFFFFF>Hai ottenuto un <C:0000,0003,00EAFFFF>Uovo onirico<C:0000,0003,FFFFFFFF>!<C:0000,0003,000000FF><C:0003,0000,1E00><C:0003,0001,><C:0000,0003,FFFFFFFF>",
      "raw_full_hex": ""
    },
    "31": {
      "text": "<C:0001,0004,>Grandioso!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Grandioso!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Grandioso!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Grandioso!<C:0003,0001,>",
      "raw_full_hex": "0E000100040000004700720061006E00640069006F0073006F0021000E000300010000000000"
    },
    "32": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Ora abbiamo tre <C:0000,0003,2C65FFFF>Uova oniriche<C:0000,0003,000000FF>!<C:0003,0001,><C:0000,0004,>Torniamo indietro, Ippoprimo\ne la principessa ci aspettano.<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Ora abbiamo tre <C:0000,0003,2C65FFFF>Uova oniriche<C:0000,0003,000000FF>!<C:0003,0001,><C:0000,0004,>Torniamo indietro, Ippoprimo\ne la principessa ci aspettano.<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Ora abbiamo tre <C:0000,0003,2C65FFFF>Uova oniriche<C:0000,0003,000000FF>!<C:0003,0001,><C:0000,0004,>Torniamo indietro, Ippoprimo\ne la principessa ci aspettano.<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Ora abbiamo tre <C:0000,0003,2C65FFFF>Uova oniriche<C:0000,0003,000000FF>!<C:0003,0001,><C:0000,0004,>Torniamo indietro, Ippoprimo\ne la principessa ci aspettano.<C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": ""
    },
    "33": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>OK.<C:0003,0000,0A00> Dirigiamoci al prossimo dormipunto\ne troviamo l'altro Ipposogno!<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>OK.<C:0003,0000,0A00> Dirigiamoci al prossimo dormipunto\ne troviamo l'altro Ipposogno!<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>OK.<C:0003,0000,0A00> Dirigiamoci al prossimo dormipunto\ne troviamo l'altro Ipposogno!<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>OK.<C:0003,0000,0A00> Dirigiamoci al prossimo dormipunto\ne troviamo l'altro Ipposogno!<C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": ""
    },
    "34": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Al prossimo sogno! Mi preparerò per\nbene e stenterete a riconoscermi!<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Al prossimo sogno! Mi preparerò per\nbene e stenterete a riconoscermi!<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Al prossimo sogno! Mi preparerò per\nbene e stenterete a riconoscermi!<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Al prossimo sogno! Mi preparerò per\nbene e stenterete a riconoscermi!<C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": ""
    },
    "35": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Anche se prima mi hai detto che\nsono splendida, non sei il mio tipo...<C:0000,0003,000000FF><C:0003,0001,>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Anche se prima mi hai detto che\nsono splendida, non sei il mio tipo...<C:0000,0003,000000FF><C:0003,0001,>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Anche se prima mi hai detto che\nsono splendida, non sei il mio tipo...<C:0000,0003,000000FF><C:0003,0001,>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Anche se prima mi hai detto che\nsono splendida, non sei il mio tipo...<C:0000,0003,000000FF><C:0003,0001,>",
      "raw_full_hex": ""
    },
    "36": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Il mio sogno è...<C:0003,0000,0A00> essere rapita dal\nprincipe azzurro in sella al suo destriero!<C:0003,0001,><C:0000,0003,000000FF><C:0000,0004,>L'esatto opposto di te! Sembri più\nun cuscino che un principe!<C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Il mio sogno è...<C:0003,0000,0A00> essere rapita dal\nprincipe azzurro in sella al suo destriero!<C:0003,0001,><C:0000,0003,000000FF><C:0000,0004,>L'esatto opposto di te! Sembri più\nun cuscino che un principe!<C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Il mio sogno è...<C:0003,0000,0A00> essere rapita dal\nprincipe azzurro in sella al suo destriero!<C:0003,0001,><C:0000,0003,000000FF><C:0000,0004,>L'esatto opposto di te! Sembri più\nun cuscino che un principe!<C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Il mio sogno è...<C:0003,0000,0A00> essere rapita dal\nprincipe azzurro in sella al suo destriero!<C:0003,0001,><C:0000,0003,000000FF><C:0000,0004,>L'esatto opposto di te! Sembri più\nun cuscino che un principe!<C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": ""
    },
    "37": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Che sogno romantico, vero?<C:0003,0000,0A00>\nVERO?!<C:0000,0003,000000FF><C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Che sogno romantico, vero?<C:0003,0000,0A00>\nVERO?!<C:0000,0003,000000FF><C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Che sogno romantico, vero?<C:0003,0000,0A00>\nVERO?!<C:0000,0003,000000FF><C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Che sogno romantico, vero?<C:0003,0000,0A00>\nVERO?!<C:0000,0003,000000FF><C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": "0E00000003000400000000FF0E00010004000000430068006500200073006F0067006E006F00200072006F006D0061006E007400690063006F002C0020007600650072006F003F000E000300000002000A000A005600450052004F003F0021000E00000003000400000000FF0E00000003000400000000FF0E000300010000000E00000003000400000000FF0000"
    },
    "38": {
