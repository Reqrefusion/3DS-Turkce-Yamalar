      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Ehm...<C:0003,0000,0A00> Mi state\nascoltando o no?<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Ehm...<C:0003,0000,0A00> Mi state\nascoltando o no?<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Ehm...<C:0003,0000,0A00> Mi state\nascoltando o no?<C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": "0E00000003000400000000FF0E00010004000000450068006D002E002E002E000E000300000002000A0020004D0069002000730074006100740065000A006100730063006F006C00740061006E0064006F0020006F0020006E006F003F000E000300010000000E00000003000400000000FF0000"
    },
    "39": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Pensate che io\nsia noiosa, eh?<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Pensate che io\nsia noiosa, eh?<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Pensate che io\nsia noiosa, eh?<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Pensate che io\nsia noiosa, eh?<C:0003,0001,><C:0000,0003,000000FF>",
