      "tokenized_text": "<C:0000,0002,6400><C:0000,0003,000000FF><C:0001,0004,>Ipponia è splendida come una\nsirena, anche al naturale!<C:0000,0003,000000FF><C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,6400><C:0000,0003,000000FF><C:0001,0004,>Ipponia è splendida come una\nsirena, anche al naturale!<C:0000,0003,000000FF><C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400>",
