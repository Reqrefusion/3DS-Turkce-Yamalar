      "raw_full_hex": ""
    },
    "20": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Mario!<C:0003,0000,0A00> Eccoti qua! Però il Mondo\nonirico finisce qui.<C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF><C:0000,0004,>A meno che... tu non abbia un altro\n<C:0000,0003,2C65FFFF>Uovo onirico<C:0000,0003,000000FF>?<C:0000,0003,000000FF><C:0003,0000,0A00> Ce l'hai? Eh? Ce l'hai?<C:0000,0003,000000FF><C:0000,0003,000000FF><C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Mario!<C:0003,0000,0A00> Eccoti qua! Però il Mondo\nonirico finisce qui.<C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF><C:0000,0004,>A meno che... tu non abbia un altro\n<C:0000,0003,2C65FFFF>Uovo onirico<C:0000,0003,000000FF>?<C:0000,0003,000000FF><C:0003,0000,0A00> Ce l'hai? Eh? Ce l'hai?<C:0000,0003,000000FF><C:0000,0003,000000FF><C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
