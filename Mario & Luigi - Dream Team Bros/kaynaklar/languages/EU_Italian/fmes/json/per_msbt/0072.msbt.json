    "1": {
      "text": "Se lasciano la grotta,\nnon li riacciufferemo più!<C:0003,0001,><C:0000,0004,>Non lasciateli fuggire!<C:0003,0001,>",
      "tokenized_text": "Se lasciano la grotta,\nnon li riacciufferemo più!<C:0003,0001,><C:0000,0004,>Non lasciateli fuggire!<C:0003,0001,>",
