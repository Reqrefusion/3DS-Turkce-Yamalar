    },
    "6": {
      "text": "<C:0001,0004,>Ik sta bij jullie\nin het krijt!<C:0003,0001,><C:0000,0004,>Heel hartelijk\ndank!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Ik sta bij jullie\nin het krijt!<C:0003,0001,><C:0000,0004,>Heel hartelijk\ndank!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Ik sta bij jullie\nin het krijt!<C:0003,0001,><C:0000,0004,>Heel hartelijk\ndank!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Ik sta bij jullie\nin het krijt!<C:0003,0001,><C:0000,0004,>Heel hartelijk\ndank!<C:0003,0001,>",
