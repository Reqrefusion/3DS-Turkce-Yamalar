    },
    "8": {
      "text": "<C:0001,0004,>Ah, ik snap het...<C:0003,0001,><C:0000,0004,>Jullie willen daar naar\nde Snurkvogel zoeken...<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Ah, ik snap het...<C:0003,0001,><C:0000,0004,>Jullie willen daar naar\nde Snurkvogel zoeken...<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Ah, ik snap het...<C:0003,0001,><C:0000,0004,>Jullie willen daar naar\nde Snurkvogel zoeken...<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Ah, ik snap het...<C:0003,0001,><C:0000,0004,>Jullie willen daar naar\nde Snurkvogel zoeken...<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "9": {
      "text": "<C:0001,0004,>Als dat jullie doel is,\nhebben jullie dit nodig!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Als dat jullie doel is,\nhebben jullie dit nodig!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Als dat jullie doel is,\nhebben jullie dit nodig!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Als dat jullie doel is,\nhebben jullie dit nodig!<C:0003,0001,>",
      "raw_full_hex": "0E0001000400000041006C007300200064006100740020006A0075006C006C0069006500200064006F0065006C002000690073002C000A00680065006200620065006E0020006A0075006C006C0069006500200064006900740020006E006F0064006900670021000E000300010000000000"
    },
    "10": {
      "text": "<C:0001,0004,>De droomkracht in dit woud overtreft\nalle andere droomkracht ter wereld.<C:0003,0001,><C:0000,0004,>Daarom hebben we de tempel hier gebouwd.\nOm die droomkracht te kanaliseren...<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>De droomkracht in dit woud overtreft\nalle andere droomkracht ter wereld.<C:0003,0001,><C:0000,0004,>Daarom hebben we de tempel hier gebouwd.\nOm die droomkracht te kanaliseren...<C:0003,0001,>",
      "original_text": "<C:0001,0004,>De droomkracht in dit woud overtreft\nalle andere droomkracht ter wereld.<C:0003,0001,><C:0000,0004,>Daarom hebben we de tempel hier gebouwd.\nOm die droomkracht te kanaliseren...<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>De droomkracht in dit woud overtreft\nalle andere droomkracht ter wereld.<C:0003,0001,><C:0000,0004,>Daarom hebben we de tempel hier gebouwd.\nOm die droomkracht te kanaliseren...<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "11": {
      "text": "<C:0001,0004,>De droomstroom is altijd\nkrachtig in de tempel.<C:0003,0001,><C:0000,0004,>En als je dan ook nog\nhet droombed hebt om je\nslaapkracht te vergroten...<C:0003,0001,><C:0000,0004,>...moet het zeker lukken om\nde Snurkvogel te vinden!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>De droomstroom is altijd\nkrachtig in de tempel.<C:0003,0001,><C:0000,0004,>En als je dan ook nog\nhet droombed hebt om je\nslaapkracht te vergroten...<C:0003,0001,><C:0000,0004,>...moet het zeker lukken om\nde Snurkvogel te vinden!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>De droomstroom is altijd\nkrachtig in de tempel.<C:0003,0001,><C:0000,0004,>En als je dan ook nog\nhet droombed hebt om je\nslaapkracht te vergroten...<C:0003,0001,><C:0000,0004,>...moet het zeker lukken om\nde Snurkvogel te vinden!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>De droomstroom is altijd\nkrachtig in de tempel.<C:0003,0001,><C:0000,0004,>En als je dan ook nog\nhet droombed hebt om je\nslaapkracht te vergroten...<C:0003,0001,><C:0000,0004,>...moet het zeker lukken om\nde Snurkvogel te vinden!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "12": {
      "text": "<C:0001,0004,>Ik smeek jullie...<C:0003,0001,><C:0000,0004,>Red de wereld uit de\nklauwen van het kwaad!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Ik smeek jullie...<C:0003,0001,><C:0000,0004,>Red de wereld uit de\nklauwen van het kwaad!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Ik smeek jullie...<C:0003,0001,><C:0000,0004,>Red de wereld uit de\nklauwen van het kwaad!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Ik smeek jullie...<C:0003,0001,><C:0000,0004,>Red de wereld uit de\nklauwen van het kwaad!<C:0003,0001,>",
      "raw_full_hex": ""
    },
