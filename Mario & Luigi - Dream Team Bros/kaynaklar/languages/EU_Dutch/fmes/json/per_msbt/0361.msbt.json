    "8": {
      "text": "<C:0001,0004,>Hierachter ligt het diepste\ndeel van dromenland!<C:0003,0001,><C:0000,0004,>Geloof me, NIEMAND gaat\nPeach daar kunnen vinden!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Hierachter ligt het diepste\ndeel van dromenland!<C:0003,0001,><C:0000,0004,>Geloof me, NIEMAND gaat\nPeach daar kunnen vinden!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Hierachter ligt het diepste\ndeel van dromenland!<C:0003,0001,><C:0000,0004,>Geloof me, NIEMAND gaat\nPeach daar kunnen vinden!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Hierachter ligt het diepste\ndeel van dromenland!<C:0003,0001,><C:0000,0004,>Geloof me, NIEMAND gaat\nPeach daar kunnen vinden!<C:0003,0001,>",
      "raw_full_hex": ""
    },
