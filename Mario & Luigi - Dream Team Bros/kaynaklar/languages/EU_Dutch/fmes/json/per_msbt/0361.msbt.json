      "text": "<C:0001,0004,>Kijk eens aan!<C:0003,0000,0A00>\nDat is 'm echt!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Kijk eens aan!<C:0003,0000,0A00>\nDat is 'm echt!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Kijk eens aan!<C:0003,0000,0A00>\nDat is 'm echt!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Kijk eens aan!<C:0003,0000,0A00>\nDat is 'm echt!<C:0003,0001,>",
