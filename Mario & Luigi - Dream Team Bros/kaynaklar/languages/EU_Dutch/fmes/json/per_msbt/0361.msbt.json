    "3": {
      "text": "<C:0001,0004,>Jongens, hoe STAAN de zaken?<C:0003,0000,0A00>\nHebben jullie het laatste <C:0000,0003,2C65FFFF>droomei<C:0000,0003,000000FF><C:0000,0003,000000FF>?<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0001,0004,>Jongens, hoe STAAN de zaken?<C:0003,0000,0A00>\nHebben jullie het laatste <C:0000,0003,2C65FFFF>droomei<C:0000,0003,000000FF><C:0000,0003,000000FF>?<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0001,0004,>Jongens, hoe STAAN de zaken?<C:0003,0000,0A00>\nHebben jullie het laatste <C:0000,0003,2C65FFFF>droomei<C:0000,0003,000000FF><C:0000,0003,000000FF>?<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0001,0004,>Jongens, hoe STAAN de zaken?<C:0003,0000,0A00>\nHebben jullie het laatste <C:0000,0003,2C65FFFF>droomei<C:0000,0003,000000FF><C:0000,0003,000000FF>?<C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": ""
