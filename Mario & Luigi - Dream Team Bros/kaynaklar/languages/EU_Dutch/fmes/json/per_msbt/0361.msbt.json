    "15": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Mario...<C:0000,0003,000000FF><C:0003,0001,>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Mario...<C:0000,0003,000000FF><C:0003,0001,>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Mario...<C:0000,0003,000000FF><C:0003,0001,>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Mario...<C:0000,0003,000000FF><C:0003,0001,>",
      "raw_full_hex": "0E00000003000400000000FF0E000100040000004D006100720069006F002E002E002E000E00000003000400000000FF0E000300010000000000"
    },
    "16": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Zei Seadric nou dat iemand monsters\ndromenland in aan het lokken is?<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Zei Seadric nou dat iemand monsters\ndromenland in aan het lokken is?<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Zei Seadric nou dat iemand monsters\ndromenland in aan het lokken is?<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Zei Seadric nou dat iemand monsters\ndromenland in aan het lokken is?<C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": ""
    },
    "17": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Ik heb niemand gezien, maar...\ndat is best wel zorgwekkend...<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Ik heb niemand gezien, maar...\ndat is best wel zorgwekkend...<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Ik heb niemand gezien, maar...\ndat is best wel zorgwekkend...<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Ik heb niemand gezien, maar...\ndat is best wel zorgwekkend...<C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": ""
    },
    "18": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>O, maar ik wil je niet bezorgd maken.\nGa maar de weg vooruit verkennen.<C:0003,0001,><C:0000,0004,>Maar beloof me alsjeblieft\ndat je voorzichtig zult zijn.<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>O, maar ik wil je niet bezorgd maken.\nGa maar de weg vooruit verkennen.<C:0003,0001,><C:0000,0004,>Maar beloof me alsjeblieft\ndat je voorzichtig zult zijn.<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>O, maar ik wil je niet bezorgd maken.\nGa maar de weg vooruit verkennen.<C:0003,0001,><C:0000,0004,>Maar beloof me alsjeblieft\ndat je voorzichtig zult zijn.<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>O, maar ik wil je niet bezorgd maken.\nGa maar de weg vooruit verkennen.<C:0003,0001,><C:0000,0004,>Maar beloof me alsjeblieft\ndat je voorzichtig zult zijn.<C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": ""
    },
    "19": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Hopelijk kan ik me nog dieper\nin de droom verbergen...<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Hopelijk kan ik me nog dieper\nin de droom verbergen...<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Hopelijk kan ik me nog dieper\nin de droom verbergen...<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Hopelijk kan ik me nog dieper\nin de droom verbergen...<C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": ""
    },
    "20": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Hoe is HET?<C:0003,0000,0A00> Fijn dat jullie er zijn.\nMaar... dit is het einde van dromenland.<C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF><C:0000,0004,>Tenzij... jullie nog een <C:0000,0003,2C65FFFF>droomei<C:0000,0003,000000FF> hebben.<C:0000,0003,000000FF><C:0003,0000,0A00>\nEn? Hebben jullie er nog eentje?<C:0000,0003,000000FF><C:0000,0003,000000FF><C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Hoe is HET?<C:0003,0000,0A00> Fijn dat jullie er zijn.\nMaar... dit is het einde van dromenland.<C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF><C:0000,0004,>Tenzij... jullie nog een <C:0000,0003,2C65FFFF>droomei<C:0000,0003,000000FF> hebben.<C:0000,0003,000000FF><C:0003,0000,0A00>\nEn? Hebben jullie er nog eentje?<C:0000,0003,000000FF><C:0000,0003,000000FF><C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Hoe is HET?<C:0003,0000,0A00> Fijn dat jullie er zijn.\nMaar... dit is het einde van dromenland.<C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF><C:0000,0004,>Tenzij... jullie nog een <C:0000,0003,2C65FFFF>droomei<C:0000,0003,000000FF> hebben.<C:0000,0003,000000FF><C:0003,0000,0A00>\nEn? Hebben jullie er nog eentje?<C:0000,0003,000000FF><C:0000,0003,000000FF><C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Hoe is HET?<C:0003,0000,0A00> Fijn dat jullie er zijn.\nMaar... dit is het einde van dromenland.<C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF><C:0000,0004,>Tenzij... jullie nog een <C:0000,0003,2C65FFFF>droomei<C:0000,0003,000000FF> hebben.<C:0000,0003,000000FF><C:0003,0000,0A00>\nEn? Hebben jullie er nog eentje?<C:0000,0003,000000FF><C:0000,0003,000000FF><C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": ""
    },
    "21": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>O, oké...<C:0003,0000,0A00> Nog niet, dus?\nGa dan een nieuw droompunt zoeken!<C:0003,0001,><C:0000,0003,000000FF><C:0000,0004,><C:0001,0004,>Zal ik jullie terugwarpen naar de ingang?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Nee          <C:0005,0001,>Ja<C:0000,0003,000000FF><C:0003,0000,0A00><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>O, oké...<C:0003,0000,0A00> Nog niet, dus?\nGa dan een nieuw droompunt zoeken!<C:0003,0001,><C:0000,0003,000000FF><C:0000,0004,><C:0001,0004,>Zal ik jullie terugwarpen naar de ingang?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Nee          <C:0005,0001,>Ja<C:0000,0003,000000FF><C:0003,0000,0A00><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>O, oké...<C:0003,0000,0A00> Nog niet, dus?\nGa dan een nieuw droompunt zoeken!<C:0003,0001,><C:0000,0003,000000FF><C:0000,0004,><C:0001,0004,>Zal ik jullie terugwarpen naar de ingang?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Nee          <C:0005,0001,>Ja<C:0000,0003,000000FF><C:0003,0000,0A00><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>O, oké...<C:0003,0000,0A00> Nog niet, dus?\nGa dan een nieuw droompunt zoeken!<C:0003,0001,><C:0000,0003,000000FF><C:0000,0004,><C:0001,0004,>Zal ik jullie terugwarpen naar de ingang?<C:0003,0000,0A00>\n<C:0001,0001,><C:0005,0001,>Nee          <C:0005,0001,>Ja<C:0000,0003,000000FF><C:0003,0000,0A00><C:0000,0003,000000FF>",
