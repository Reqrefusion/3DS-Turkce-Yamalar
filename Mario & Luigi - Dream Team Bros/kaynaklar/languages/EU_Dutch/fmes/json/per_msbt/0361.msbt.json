    "11": {
      "text": "<C:0001,0004,>Nou, volgens mij ben ik wel klaar hier.\nHet was leuk, maar IK BEN WEG!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Nou, volgens mij ben ik wel klaar hier.\nHet was leuk, maar IK BEN WEG!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Nou, volgens mij ben ik wel klaar hier.\nHet was leuk, maar IK BEN WEG!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Nou, volgens mij ben ik wel klaar hier.\nHet was leuk, maar IK BEN WEG!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "12": {
      "text": "<C:0001,0004,>Zeg, voor ik het vergeet...\nAl die monsters hier?<C:0003,0001,><C:0000,0004,>Enig idee wie ze hier naar\nbinnen heeft gelokt?<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Zeg, voor ik het vergeet...\nAl die monsters hier?<C:0003,0001,><C:0000,0004,>Enig idee wie ze hier naar\nbinnen heeft gelokt?<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Zeg, voor ik het vergeet...\nAl die monsters hier?<C:0003,0001,><C:0000,0004,>Enig idee wie ze hier naar\nbinnen heeft gelokt?<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Zeg, voor ik het vergeet...\nAl die monsters hier?<C:0003,0001,><C:0000,0004,>Enig idee wie ze hier naar\nbinnen heeft gelokt?<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "13": {
      "text": "<C:0001,0004,>Bowser en zijn onderdanen\nzoeken de prinses, toch?<C:0003,0001,><C:0000,0004,>Ik begrijp het.<C:0003,0000,0A00> Dat is geen pretje.\nIk zal een oogje in het zeil houden!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Bowser en zijn onderdanen\nzoeken de prinses, toch?<C:0003,0001,><C:0000,0004,>Ik begrijp het.<C:0003,0000,0A00> Dat is geen pretje.\nIk zal een oogje in het zeil houden!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Bowser en zijn onderdanen\nzoeken de prinses, toch?<C:0003,0001,><C:0000,0004,>Ik begrijp het.<C:0003,0000,0A00> Dat is geen pretje.\nIk zal een oogje in het zeil houden!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Bowser en zijn onderdanen\nzoeken de prinses, toch?<C:0003,0001,><C:0000,0004,>Ik begrijp het.<C:0003,0000,0A00> Dat is geen pretje.\nIk zal een oogje in het zeil houden!<C:0003,0001,>",
      "raw_full_hex": ""
    },
