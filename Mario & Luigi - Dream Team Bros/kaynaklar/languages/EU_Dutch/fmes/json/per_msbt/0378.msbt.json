      "original_text": "",
      "original_tokenized_text": "",
      "raw_full_hex": "0000"
    },
    "27": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,><C:0007,0000,><C:0001,0001,><C:0000,0003,FFFFFFFF>Je hebt een <C:0000,0003,00EAFFFF>droomei<C:0000,0003,FFFFFFFF> gekregen! <C:0000,0003,000000FF><C:0003,0000,1E00><C:0003,0001,><C:0000,0003,FFFFFFFF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,><C:0007,0000,><C:0001,0001,><C:0000,0003,FFFFFFFF>Je hebt een <C:0000,0003,00EAFFFF>droomei<C:0000,0003,FFFFFFFF> gekregen! <C:0000,0003,000000FF><C:0003,0000,1E00><C:0003,0001,><C:0000,0003,FFFFFFFF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,><C:0007,0000,><C:0001,0001,><C:0000,0003,FFFFFFFF>Je hebt een <C:0000,0003,00EAFFFF>droomei<C:0000,0003,FFFFFFFF> gekregen! <C:0000,0003,000000FF><C:0003,0000,1E00><C:0003,0001,><C:0000,0003,FFFFFFFF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,><C:0007,0000,><C:0001,0001,><C:0000,0003,FFFFFFFF>Je hebt een <C:0000,0003,00EAFFFF>droomei<C:0000,0003,FFFFFFFF> gekregen! <C:0000,0003,000000FF><C:0003,0000,1E00><C:0003,0001,><C:0000,0003,FFFFFFFF>",
      "raw_full_hex": ""
    },
    "28": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Nu hebben we alle drie\nde <C:0000,0003,2C65FFFF>droomeieren<C:0000,0003,000000FF>!<C:0003,0001,><C:0000,0004,>Laten we snel terug\nnaar Peach gaan.<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Nu hebben we alle drie\nde <C:0000,0003,2C65FFFF>droomeieren<C:0000,0003,000000FF>!<C:0003,0001,><C:0000,0004,>Laten we snel terug\nnaar Peach gaan.<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Nu hebben we alle drie\nde <C:0000,0003,2C65FFFF>droomeieren<C:0000,0003,000000FF>!<C:0003,0001,><C:0000,0004,>Laten we snel terug\nnaar Peach gaan.<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Nu hebben we alle drie\nde <C:0000,0003,2C65FFFF>droomeieren<C:0000,0003,000000FF>!<C:0003,0001,><C:0000,0004,>Laten we snel terug\nnaar Peach gaan.<C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": ""
    },
    "29": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Oké!<C:0003,0000,0A00> Op naar het volgende droompunt\nen de volgende Seadring.<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Oké!<C:0003,0000,0A00> Op naar het volgende droompunt\nen de volgende Seadring.<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Oké!<C:0003,0000,0A00> Op naar het volgende droompunt\nen de volgende Seadring.<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Oké!<C:0003,0000,0A00> Op naar het volgende droompunt\nen de volgende Seadring.<C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": ""
    },
