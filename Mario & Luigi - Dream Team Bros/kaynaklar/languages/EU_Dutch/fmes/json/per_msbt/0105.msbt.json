    "3": {
      "text": "<C:0007,0000,><C:0001,0001,>Instructies voor de pedaalbaan:<C:0003,0001,><C:0000,0004,><C:0007,0000,>Je hebt twee mensen\nnodig om te rijden.<C:0003,0001,><C:0000,0004,><C:0007,0000,>Druk op het juiste\nmoment op <C:0000,0002,4B00><C:0000,0003,FF4F4FFF><C:0000,0003,FFFFFFFF><C:0000,0002,6400> en <C:0000,0002,4B00><C:0000,0003,7DFF00FF><C:0000,0003,FFFFFFFF><C:0000,0002,6400>.<C:0003,0001,><C:0000,0004,><C:0007,0000,>Druk als het pedaal\n<C:0000,0003,00EAFFFF>op z'n hoogst<C:0000,0003,FFFFFFFF> is.<C:0003,0001,><C:0000,0004,><C:0007,0000,>Mensen met wagenziekte raden we\naf de pedaalbaan te gebruiken.<C:0003,0001,>",
      "tokenized_text": "<C:0007,0000,><C:0001,0001,>Instructies voor de pedaalbaan:<C:0003,0001,><C:0000,0004,><C:0007,0000,>Je hebt twee mensen\nnodig om te rijden.<C:0003,0001,><C:0000,0004,><C:0007,0000,>Druk op het juiste\nmoment op <C:0000,0002,4B00><C:0000,0003,FF4F4FFF><C:0000,0003,FFFFFFFF><C:0000,0002,6400> en <C:0000,0002,4B00><C:0000,0003,7DFF00FF><C:0000,0003,FFFFFFFF><C:0000,0002,6400>.<C:0003,0001,><C:0000,0004,><C:0007,0000,>Druk als het pedaal\n<C:0000,0003,00EAFFFF>op z'n hoogst<C:0000,0003,FFFFFFFF> is.<C:0003,0001,><C:0000,0004,><C:0007,0000,>Mensen met wagenziekte raden we\naf de pedaalbaan te gebruiken.<C:0003,0001,>",
      "original_text": "<C:0007,0000,><C:0001,0001,>Instructies voor de pedaalbaan:<C:0003,0001,><C:0000,0004,><C:0007,0000,>Je hebt twee mensen\nnodig om te rijden.<C:0003,0001,><C:0000,0004,><C:0007,0000,>Druk op het juiste\nmoment op <C:0000,0002,4B00><C:0000,0003,FF4F4FFF><C:0000,0003,FFFFFFFF><C:0000,0002,6400> en <C:0000,0002,4B00><C:0000,0003,7DFF00FF><C:0000,0003,FFFFFFFF><C:0000,0002,6400>.<C:0003,0001,><C:0000,0004,><C:0007,0000,>Druk als het pedaal\n<C:0000,0003,00EAFFFF>op z'n hoogst<C:0000,0003,FFFFFFFF> is.<C:0003,0001,><C:0000,0004,><C:0007,0000,>Mensen met wagenziekte raden we\naf de pedaalbaan te gebruiken.<C:0003,0001,>",
