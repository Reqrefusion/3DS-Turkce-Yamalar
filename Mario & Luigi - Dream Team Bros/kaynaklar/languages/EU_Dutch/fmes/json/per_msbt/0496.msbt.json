      "original_tokenized_text": "",
      "raw_full_hex": "0000"
    },
    "13": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>We moeten deze vaardigheid\ngebruiken om verder te komen!<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>We moeten deze vaardigheid\ngebruiken om verder te komen!<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>We moeten deze vaardigheid\ngebruiken om verder te komen!<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>We moeten deze vaardigheid\ngebruiken om verder te komen!<C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": ""
    },
    "14": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Ik zal Starlow in de wakkere\nwereld op de hoogte brengen.<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Ik zal Starlow in de wakkere\nwereld op de hoogte brengen.<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Ik zal Starlow in de wakkere\nwereld op de hoogte brengen.<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Ik zal Starlow in de wakkere\nwereld op de hoogte brengen.<C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": ""
    },
