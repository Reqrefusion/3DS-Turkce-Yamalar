    },
    "5": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Wat zou er gebeuren\nals we hem gebruiken?<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Wat zou er gebeuren\nals we hem gebruiken?<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Wat zou er gebeuren\nals we hem gebruiken?<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Wat zou er gebeuren\nals we hem gebruiken?<C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": "0E00000003000400000000FF0E0001000400000057006100740020007A006F007500200065007200200067006500620065007500720065006E000A0061006C0073002000770065002000680065006D0020006700650062007200750069006B0065006E003F000E000300010000000E00000003000400000000FF0000"
    },
    "6": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>De bevroren pilaren\nzijn gesmolten!<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>De bevroren pilaren\nzijn gesmolten!<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>De bevroren pilaren\nzijn gesmolten!<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>De bevroren pilaren\nzijn gesmolten!<C:0003,0001,><C:0000,0003,000000FF>",
