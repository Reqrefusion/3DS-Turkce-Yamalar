    },
    "5": {
      "text": "<C:0007,0000,><C:0001,0001,><C:0001,0004,>Ben je nou helemaal\nvan lotje getikt?!<C:0003,0001,>",
      "tokenized_text": "<C:0007,0000,><C:0001,0001,><C:0001,0004,>Ben je nou helemaal\nvan lotje getikt?!<C:0003,0001,>",
      "original_text": "<C:0007,0000,><C:0001,0001,><C:0001,0004,>Ben je nou helemaal\nvan lotje getikt?!<C:0003,0001,>",
      "original_tokenized_text": "<C:0007,0000,><C:0001,0001,><C:0001,0004,>Ben je nou helemaal\nvan lotje getikt?!<C:0003,0001,>",
