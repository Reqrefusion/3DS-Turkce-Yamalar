      "raw_full_hex": "0E000100040000005700610074002000650065006E0020006E0061006100720020006E006900650075007700730020006F006D00200074006500200068006F00720065006E000A00640061007400200041006E007400610073006D006100200077006500650072002000740065007200750067002000690073002E002E002E000E000300010000000000"
    },
    "32": {
      "text": "<C:0001,0004,>Ooit was Antasma een kleine vleermuis\ndie op het eiland leefde...<C:0003,0001,><C:0000,0004,>...maar op een dag at hij op een of andere\nmanier de nachtmerrie van een Sluimer op...<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Ooit was Antasma een kleine vleermuis\ndie op het eiland leefde...<C:0003,0001,><C:0000,0004,>...maar op een dag at hij op een of andere\nmanier de nachtmerrie van een Sluimer op...<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Ooit was Antasma een kleine vleermuis\ndie op het eiland leefde...<C:0003,0001,><C:0000,0004,>...maar op een dag at hij op een of andere\nmanier de nachtmerrie van een Sluimer op...<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Ooit was Antasma een kleine vleermuis\ndie op het eiland leefde...<C:0003,0001,><C:0000,0004,>...maar op een dag at hij op een of andere\nmanier de nachtmerrie van een Sluimer op...<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "33": {
      "text": "<C:0000,0002,6400><C:0001,0004,>Hij kreeg de smaak\nvan duistere dromen\ngoed te pakken en\nat er steeds meer...<C:0003,0001,><C:0000,0004,>...waardoor hij langzaam\nveranderde in de griezel\ndie hij nu is.<C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Hij kreeg de smaak\nvan duistere dromen\ngoed te pakken en\nat er steeds meer...<C:0003,0001,><C:0000,0004,>...waardoor hij langzaam\nveranderde in de griezel\ndie hij nu is.<C:0003,0001,><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,6400><C:0001,0004,>Hij kreeg de smaak\nvan duistere dromen\ngoed te pakken en\nat er steeds meer...<C:0003,0001,><C:0000,0004,>...waardoor hij langzaam\nveranderde in de griezel\ndie hij nu is.<C:0003,0001,><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Hij kreeg de smaak\nvan duistere dromen\ngoed te pakken en\nat er steeds meer...<C:0003,0001,><C:0000,0004,>...waardoor hij langzaam\nveranderde in de griezel\ndie hij nu is.<C:0003,0001,><C:0000,0002,6400>",
      "raw_full_hex": ""
    },
    "34": {
      "text": "<C:0001,0004,>We hebben hem al een keer weten\nop te sluiten, maar nu is hij terug...<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>We hebben hem al een keer weten\nop te sluiten, maar nu is hij terug...<C:0003,0001,>",
      "original_text": "<C:0001,0004,>We hebben hem al een keer weten\nop te sluiten, maar nu is hij terug...<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>We hebben hem al een keer weten\nop te sluiten, maar nu is hij terug...<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "35": {
      "text": "<C:0001,0004,>Beëindig alsjeblieft zijn\nkwaadaardige plannen!<C:0003,0001,><C:0000,0004,>We hebben je nodig!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Beëindig alsjeblieft zijn\nkwaadaardige plannen!<C:0003,0001,><C:0000,0004,>We hebben je nodig!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Beëindig alsjeblieft zijn\nkwaadaardige plannen!<C:0003,0001,><C:0000,0004,>We hebben je nodig!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Beëindig alsjeblieft zijn\nkwaadaardige plannen!<C:0003,0001,><C:0000,0004,>We hebben je nodig!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "36": {
      "text": "<C:0001,0004,><C:0000,0003,2C65FFFF><C:0007,0000,><C:0000,0003,FFFFFFFF>Je hebt een <C:0000,0003,00EAFFFF>slaapwandelsteen<C:0000,0003,FFFFFFFF> gekregen!<C:0003,0000,1E00><C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,><C:0000,0003,2C65FFFF><C:0007,0000,><C:0000,0003,FFFFFFFF>Je hebt een <C:0000,0003,00EAFFFF>slaapwandelsteen<C:0000,0003,FFFFFFFF> gekregen!<C:0003,0000,1E00><C:0003,0001,>",
      "original_text": "<C:0001,0004,><C:0000,0003,2C65FFFF><C:0007,0000,><C:0000,0003,FFFFFFFF>Je hebt een <C:0000,0003,00EAFFFF>slaapwandelsteen<C:0000,0003,FFFFFFFF> gekregen!<C:0003,0000,1E00><C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,><C:0000,0003,2C65FFFF><C:0007,0000,><C:0000,0003,FFFFFFFF>Je hebt een <C:0000,0003,00EAFFFF>slaapwandelsteen<C:0000,0003,FFFFFFFF> gekregen!<C:0003,0000,1E00><C:0003,0001,>",
      "raw_full_hex": ""
    },
    "37": {
      "text": "<C:0001,0004,>Antasma laat niet\nmet zich sollen.<C:0003,0001,><C:0000,0004,>Wees voorzichtig!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Antasma laat niet\nmet zich sollen.<C:0003,0001,><C:0000,0004,>Wees voorzichtig!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Antasma laat niet\nmet zich sollen.<C:0003,0001,><C:0000,0004,>Wees voorzichtig!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Antasma laat niet\nmet zich sollen.<C:0003,0001,><C:0000,0004,>Wees voorzichtig!<C:0003,0001,>",
      "raw_full_hex": "0E0001000400000041006E007400610073006D00610020006C0061006100740020006E006900650074000A006D006500740020007A00690063006800200073006F006C006C0065006E002E000E000300010000000E000000040000005700650065007300200076006F006F0072007A0069006300680074006900670021000E000300010000000000"
    },
    "38": {
      "text": "<C:0001,0004,>Ik hoorde dat jullie Antasma\nin het nauw hebben gedreven!<C:0003,0001,><C:0000,0004,>Dat is fantastisch!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Ik hoorde dat jullie Antasma\nin het nauw hebben gedreven!<C:0003,0001,><C:0000,0004,>Dat is fantastisch!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Ik hoorde dat jullie Antasma\nin het nauw hebben gedreven!<C:0003,0001,><C:0000,0004,>Dat is fantastisch!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Ik hoorde dat jullie Antasma\nin het nauw hebben gedreven!<C:0003,0001,><C:0000,0004,>Dat is fantastisch!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "39": {
      "text": "<C:0000,0002,6400><C:0001,0004,>Nommon respect\nvoor groot spelen!<C:0003,0001,><C:0000,0004,>Jij speelt groot,\njij BENT groot!<C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Nommon respect\nvoor groot spelen!<C:0003,0001,><C:0000,0004,>Jij speelt groot,\njij BENT groot!<C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,6400><C:0001,0004,>Nommon respect\nvoor groot spelen!<C:0003,0001,><C:0000,0004,>Jij speelt groot,\njij BENT groot!<C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Nommon respect\nvoor groot spelen!<C:0003,0001,><C:0000,0004,>Jij speelt groot,\njij BENT groot!<C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400>",
      "raw_full_hex": ""
    },
    "40": {
      "text": "<C:0000,0002,6400><C:0001,0004,>Nommon groot druk!<C:0003,0001,><C:0000,0002,6400><C:0000,0004,>Begraaf steen.<C:0000,0002,6400><C:0003,0000,0500> Graaf op.<C:0000,0002,6400><C:0003,0000,0500><C:0000,0002,6400>\nSteengraafspel leuk.<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Leuk spel is werk.<C:0000,0002,6400>\nWerk is leuk spel.<C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Nommon groot druk!<C:0003,0001,><C:0000,0002,6400><C:0000,0004,>Begraaf steen.<C:0000,0002,6400><C:0003,0000,0500> Graaf op.<C:0000,0002,6400><C:0003,0000,0500><C:0000,0002,6400>\nSteengraafspel leuk.<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Leuk spel is werk.<C:0000,0002,6400>\nWerk is leuk spel.<C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400>",
