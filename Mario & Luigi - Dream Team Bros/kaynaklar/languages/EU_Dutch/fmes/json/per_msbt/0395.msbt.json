    },
    "25": {
      "text": "Blijf de steen\naanraken en...<C:0003,0001,><C:0000,0004,>...sleep hem op\nhet paneel.<C:0003,0001,>",
      "tokenized_text": "Blijf de steen\naanraken en...<C:0003,0001,><C:0000,0004,>...sleep hem op\nhet paneel.<C:0003,0001,>",
