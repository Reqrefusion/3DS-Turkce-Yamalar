    "17": {
      "text": "<C:0000,0002,6400><C:0001,0004,>Je hebt vele slaapwandelstenen nodig\nom in de tempel te kunnen komen.<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Je hebt vele slaapwandelstenen nodig\nom in de tempel te kunnen komen.<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,6400><C:0001,0004,>Je hebt vele slaapwandelstenen nodig\nom in de tempel te kunnen komen.<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Je hebt vele slaapwandelstenen nodig\nom in de tempel te kunnen komen.<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "raw_full_hex": ""
    },
    "18": {
      "text": "<C:0000,0002,6400><C:0001,0004,>Jullie zullen nog wel andere versteende\nSluimermeesters op jullie pad tegenkomen...<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Jullie zullen nog wel andere versteende\nSluimermeesters op jullie pad tegenkomen...<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,6400><C:0001,0004,>Jullie zullen nog wel andere versteende\nSluimermeesters op jullie pad tegenkomen...<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Jullie zullen nog wel andere versteende\nSluimermeesters op jullie pad tegenkomen...<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "raw_full_hex": ""
    },
    "19": {
      "text": "<C:0000,0002,6400><C:0001,0004,>Als je ze allemaal helpt, zullen ze je ongetwijfeld\nnog meer slaapwandelstenen geven.<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Je zult de hulp van vele meesters nodig\nhebben om de tempel te bereiken.<C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Als je ze allemaal helpt, zullen ze je ongetwijfeld\nnog meer slaapwandelstenen geven.<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Je zult de hulp van vele meesters nodig\nhebben om de tempel te bereiken.<C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,6400><C:0001,0004,>Als je ze allemaal helpt, zullen ze je ongetwijfeld\nnog meer slaapwandelstenen geven.<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Je zult de hulp van vele meesters nodig\nhebben om de tempel te bereiken.<C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Als je ze allemaal helpt, zullen ze je ongetwijfeld\nnog meer slaapwandelstenen geven.<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Je zult de hulp van vele meesters nodig\nhebben om de tempel te bereiken.<C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "raw_full_hex": ""
    },
    "20": {
      "text": "<C:0000,0002,6400><C:0001,0004,>Ik blijf hier en zal\nover jullie waken.<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Ik blijf hier en zal\nover jullie waken.<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,6400><C:0001,0004,>Ik blijf hier en zal\nover jullie waken.<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Ik blijf hier en zal\nover jullie waken.<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "raw_full_hex": "0E0000000200020064000E0001000400000049006B00200062006C0069006A00660020006800690065007200200065006E0020007A0061006C000A006F0076006500720020006A0075006C006C00690065002000770061006B0065006E002E000E0000000200020064000E000300010000000E0000000200020064000E0000000200020064000000"
    },
    "21": {
      "text": "<C:0000,0002,6400><C:0001,0004,>Antasma's ultieme\nnederlaag is nabij!<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Rust niet tot hij\ndaadwerkelijk\nis verslagen!<C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Antasma's ultieme\nnederlaag is nabij!<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Rust niet tot hij\ndaadwerkelijk\nis verslagen!<C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,6400><C:0001,0004,>Antasma's ultieme\nnederlaag is nabij!<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Rust niet tot hij\ndaadwerkelijk\nis verslagen!<C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,6400><C:0001,0004,>Antasma's ultieme\nnederlaag is nabij!<C:0000,0002,6400><C:0003,0001,><C:0000,0004,>Rust niet tot hij\ndaadwerkelijk\nis verslagen!<C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0002,6400>",
      "raw_full_hex": ""
    },
    "22": {
      "text": "<C:0001,0004,><C:0000,0003,2C65FFFF><C:0007,0000,><C:0000,0003,FFFFFFFF>Je hebt een <C:0000,0003,00EAFFFF>slaapwandelsteen<C:0000,0003,FFFFFFFF> gekregen!<C:0003,0000,1E00><C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,><C:0000,0003,2C65FFFF><C:0007,0000,><C:0000,0003,FFFFFFFF>Je hebt een <C:0000,0003,00EAFFFF>slaapwandelsteen<C:0000,0003,FFFFFFFF> gekregen!<C:0003,0000,1E00><C:0003,0001,>",
      "original_text": "<C:0001,0004,><C:0000,0003,2C65FFFF><C:0007,0000,><C:0000,0003,FFFFFFFF>Je hebt een <C:0000,0003,00EAFFFF>slaapwandelsteen<C:0000,0003,FFFFFFFF> gekregen!<C:0003,0000,1E00><C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,><C:0000,0003,2C65FFFF><C:0007,0000,><C:0000,0003,FFFFFFFF>Je hebt een <C:0000,0003,00EAFFFF>slaapwandelsteen<C:0000,0003,FFFFFFFF> gekregen!<C:0003,0000,1E00><C:0003,0001,>",
      "raw_full_hex": ""
    },
    "23": {
      "text": "Plaats stenen...<C:0003,0001,><C:0000,0004,>Maak een pad.<C:0003,0001,>",
      "tokenized_text": "Plaats stenen...<C:0003,0001,><C:0000,0004,>Maak een pad.<C:0003,0001,>",
      "original_text": "Plaats stenen...<C:0003,0001,><C:0000,0004,>Maak een pad.<C:0003,0001,>",
      "original_tokenized_text": "Plaats stenen...<C:0003,0001,><C:0000,0004,>Maak een pad.<C:0003,0001,>",
