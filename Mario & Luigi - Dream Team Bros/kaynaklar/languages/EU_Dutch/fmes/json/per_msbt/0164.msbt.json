    "16": {
      "text": "<C:0001,0004,>En die snor! Die 'eeft iets...\nmagique... iets... je ne sais quoi!<C:0003,0001,><C:0000,0004,>Deze très charmante Luigi\nies een droom van een man!<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>En die snor! Die 'eeft iets...\nmagique... iets... je ne sais quoi!<C:0003,0001,><C:0000,0004,>Deze très charmante Luigi\nies een droom van een man!<C:0003,0001,>",
      "original_text": "<C:0001,0004,>En die snor! Die 'eeft iets...\nmagique... iets... je ne sais quoi!<C:0003,0001,><C:0000,0004,>Deze très charmante Luigi\nies een droom van een man!<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>En die snor! Die 'eeft iets...\nmagique... iets... je ne sais quoi!<C:0003,0001,><C:0000,0004,>Deze très charmante Luigi\nies een droom van een man!<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "17": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>En misschien 'eb iek 'et mis,\nmaar volgens mij ies 'ij 'ier\nom je te 'elpen!<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>En misschien 'eb iek 'et mis,\nmaar volgens mij ies 'ij 'ier\nom je te 'elpen!<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>En misschien 'eb iek 'et mis,\nmaar volgens mij ies 'ij 'ier\nom je te 'elpen!<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>En misschien 'eb iek 'et mis,\nmaar volgens mij ies 'ij 'ier\nom je te 'elpen!<C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": ""
    },
    "18": {
