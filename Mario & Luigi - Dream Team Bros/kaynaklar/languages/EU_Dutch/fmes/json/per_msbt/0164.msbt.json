      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>O!<C:0000,0003,000000FF><C:0003,0000,0A00> Wat een broederliefde...\nLuigi, je bent magnifique!<C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>O!<C:0000,0003,000000FF><C:0003,0000,0A00> Wat een broederliefde...\nLuigi, je bent magnifique!<C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>O!<C:0000,0003,000000FF><C:0003,0000,0A00> Wat een broederliefde...\nLuigi, je bent magnifique!<C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": ""
    },
