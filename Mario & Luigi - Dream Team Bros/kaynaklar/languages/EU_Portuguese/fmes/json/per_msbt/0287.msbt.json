    "15": {
      "text": "<C:0001,0004,><C:0000,0003,2C65FFFF>Terão de vencer apenas com golpes Excelentes!<C:0000,0003,000000FF><C:0000,0003,2C65FFFF><C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0001,0004,><C:0000,0003,2C65FFFF>Terão de vencer apenas com golpes Excelentes!<C:0000,0003,000000FF><C:0000,0003,2C65FFFF><C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0001,0004,><C:0000,0003,2C65FFFF>Terão de vencer apenas com golpes Excelentes!<C:0000,0003,000000FF><C:0000,0003,2C65FFFF><C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0001,0004,><C:0000,0003,2C65FFFF>Terão de vencer apenas com golpes Excelentes!<C:0000,0003,000000FF><C:0000,0003,2C65FFFF><C:0003,0001,><C:0000,0003,000000FF>",
