      "original_text": "<C:0000,0003,000000FF><C:0001,0004,><C:0007,0000,><C:0001,0001,><C:0000,0003,FFFFFFFF>Recebeste um <C:0000,0003,00EAFFFF>ovo onírico<C:0000,0003,FFFFFFFF>! <C:0000,0003,000000FF><C:0003,0000,1E00><C:0003,0001,><C:0000,0003,FFFFFFFF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,><C:0007,0000,><C:0001,0001,><C:0000,0003,FFFFFFFF>Recebeste um <C:0000,0003,00EAFFFF>ovo onírico<C:0000,0003,FFFFFFFF>! <C:0000,0003,000000FF><C:0003,0000,1E00><C:0003,0001,><C:0000,0003,FFFFFFFF>",
