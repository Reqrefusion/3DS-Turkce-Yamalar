      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Já temos os três\n<C:0000,0003,2C65FFFF>ovos oníricos<C:0000,0003,000000FF>!<C:0003,0001,><C:0000,0004,>Regressemos ao mundo onírico,\nque a Peach está à nossa espera.<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Já temos os três\n<C:0000,0003,2C65FFFF>ovos oníricos<C:0000,0003,000000FF>!<C:0003,0001,><C:0000,0004,>Regressemos ao mundo onírico,\nque a Peach está à nossa espera.<C:0003,0001,><C:0000,0003,000000FF>",
