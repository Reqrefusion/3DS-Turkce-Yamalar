    },
    "40": {
      "text": "\u0002\u0002d<C:0000,0003,000000FF><C:0001,0004,>Ama ne yazık ki uykuya vakit yok!<C:0003,0000,0A00>\nZeekeeper'ı görmeliyiz...<C:0003,0001,><C:0000,0003,000000FF><C:0000,0002,6400>",
      "tokenized_text": "\u0002\u0002d<C:0000,0003,000000FF><C:0001,0004,>Ama ne yazık ki uykuya vakit yok!<C:0003,0000,0A00>\nZeekeeper'ı görmeliyiz...<C:0003,0001,><C:0000,0003,000000FF><C:0000,0002,6400>",
      "original_text": "\u0002\u0002d<C:0000,0003,000000FF><C:0001,0004,>Ama ne yazık ki uykuya vakit yok!<C:0003,0000,0A00>\nZeekeeper'ı görmeliyiz...<C:0003,0001,><C:0000,0003,000000FF><C:0000,0002,6400>",
      "original_tokenized_text": "\u0002\u0002d<C:0000,0003,000000FF><C:0001,0004,>Ama ne yazık ki uykuya vakit yok!<C:0003,0000,0A00>\nZeekeeper'ı görmeliyiz...<C:0003,0001,><C:0000,0003,000000FF><C:0000,0002,6400>",
      "raw_full_hex": ""
    },
    "41": {
      "text": "\u0002\u0002d<C:0000,0003,000000FF><C:0001,0004,>Ve yardımını alana kadar\ngardımızı düşürmemeliyiz...<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400>",
      "tokenized_text": "\u0002\u0002d<C:0000,0003,000000FF><C:0001,0004,>Ve yardımını alana kadar\ngardımızı düşürmemeliyiz...<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400>",
      "original_text": "\u0002\u0002d<C:0000,0003,000000FF><C:0001,0004,>Ve yardımını alana kadar\ngardımızı düşürmemeliyiz...<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400>",
      "original_tokenized_text": "\u0002\u0002d<C:0000,0003,000000FF><C:0001,0004,>Ve yardımını alana kadar\ngardımızı düşürmemeliyiz...<C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400>",
      "raw_full_hex": ""
    },
    "42": {
      "text": "\u0002\u0002<C:0000,0003,000000FF><C:0001,0004,><C:0000,0002,9600><C:0000,0003,000000FF>UYANIK!<C:0003,0000,0A00> OLUN!<C:0000,0003,000000FF><C:0003,0001,><C:0000,0002,9600><C:0000,0003,000000FF><C:0000,0002,6400>",
      "tokenized_text": "\u0002\u0002<C:0000,0003,000000FF><C:0001,0004,><C:0000,0002,9600><C:0000,0003,000000FF>UYANIK!<C:0003,0000,0A00> OLUN!<C:0000,0003,000000FF><C:0003,0001,><C:0000,0002,9600><C:0000,0003,000000FF><C:0000,0002,6400>",
      "original_text": "\u0002\u0002<C:0000,0003,000000FF><C:0001,0004,><C:0000,0002,9600><C:0000,0003,000000FF>UYANIK!<C:0003,0000,0A00> OLUN!<C:0000,0003,000000FF><C:0003,0001,><C:0000,0002,9600><C:0000,0003,000000FF><C:0000,0002,6400>",
      "original_tokenized_text": "\u0002\u0002<C:0000,0003,000000FF><C:0001,0004,><C:0000,0002,9600><C:0000,0003,000000FF>UYANIK!<C:0003,0000,0A00> OLUN!<C:0000,0003,000000FF><C:0003,0001,><C:0000,0002,9600><C:0000,0003,000000FF><C:0000,0002,6400>",
      "raw_full_hex": "0200020096000E00000003000400000000FF0E000100040000000E0000000200020096000E00000003000400000000FF5500590041004E0049004B0021000E000300000002000A0020004F004C0055004E0021000E00000003000400000000FF0E000300010000000E0000000200020096000E00000003000400000000FF0E0000000200020064000000"
