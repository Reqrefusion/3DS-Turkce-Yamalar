    "20": {
      "text": "<C:0000,0002,6400><C:0000,0003,000000FF><C:0001,0004,>O efsanevi kraliyet yumuşaklığı!<C:0000,0002,6400><C:0003,0000,0A00>\nTek istediğim minicik bir şekerleme!<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,6400><C:0000,0003,000000FF><C:0001,0004,>O efsanevi kraliyet yumuşaklığı!<C:0000,0002,6400><C:0003,0000,0A00>\nTek istediğim minicik bir şekerleme!<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,6400><C:0000,0003,000000FF><C:0001,0004,>O efsanevi kraliyet yumuşaklığı!<C:0000,0002,6400><C:0003,0000,0A00>\nTek istediğim minicik bir şekerleme!<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400>",
      "original_tokenized_text": "<C:0000,0002,6400><C:0000,0003,000000FF><C:0001,0004,>O efsanevi kraliyet yumuşaklığı!<C:0000,0002,6400><C:0003,0000,0A00>\nTek istediğim minicik bir şekerleme!<C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400><C:0000,0002,6400><C:0003,0001,><C:0000,0002,6400>",
