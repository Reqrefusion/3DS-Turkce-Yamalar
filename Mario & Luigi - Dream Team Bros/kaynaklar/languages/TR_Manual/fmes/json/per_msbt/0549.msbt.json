    "43": {
      "text": "<C:0000,0002,6400><C:0000,0003,000000FF><C:0001,0004,>İster rüyaların, ister aşkın,<C:0003,0000,0A00> ister kusursuz uykunun peşine düşün<C:0000,0002,6400>...<C:0003,0001,><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400>\nTetikte olmak her zaman şarttır.<C:0003,0001,><C:0000,0002,6400>",
      "tokenized_text": "<C:0000,0002,6400><C:0000,0003,000000FF><C:0001,0004,>İster rüyaların, ister aşkın,<C:0003,0000,0A00> ister kusursuz uykunun peşine düşün<C:0000,0002,6400>...<C:0003,0001,><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400>\nTetikte olmak her zaman şarttır.<C:0003,0001,><C:0000,0002,6400>",
      "original_text": "<C:0000,0002,6400><C:0000,0003,000000FF><C:0001,0004,>İster rüyaların, ister aşkın,<C:0003,0000,0A00> ister kusursuz uykunun peşine düşün<C:0000,0002,6400>...<C:0003,0001,><C:0000,0002,6400><C:0000,0003,000000FF><C:0000,0002,6400>\nTetikte olmak her zaman şarttır.<C:0003,0001,><C:0000,0002,6400>",
