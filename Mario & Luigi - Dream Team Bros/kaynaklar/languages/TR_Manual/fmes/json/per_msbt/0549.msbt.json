    "39": {
      "text": "\u0002\u0002<C:0000,0003,000000FF><C:0001,0004,><C:0000,0002,9600><C:0000,0003,000000FF>BEDSMITH!<C:0003,0000,0A00> UYKULU!<C:0000,0003,000000FF><C:0003,0001,><C:0000,0002,9600><C:0000,0003,000000FF><C:0000,0002,6400>",
      "tokenized_text": "\u0002\u0002<C:0000,0003,000000FF><C:0001,0004,><C:0000,0002,9600><C:0000,0003,000000FF>BEDSMITH!<C:0003,0000,0A00> UYKULU!<C:0000,0003,000000FF><C:0003,0001,><C:0000,0002,9600><C:0000,0003,000000FF><C:0000,0002,6400>",
