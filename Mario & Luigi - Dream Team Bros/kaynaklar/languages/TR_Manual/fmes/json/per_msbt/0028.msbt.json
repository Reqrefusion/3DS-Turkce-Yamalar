    "70": {
      "text": "?<C:0003,0000,0A00> Birine mi yetişilecek?<C:0003,0000,0A00>\nAcil diyemem ama...<C:0003,0001,><C:0000,0004,>Birinin GERÇEKTEN çok hızlı\ngittiğini gördüm!<C:0003,0001,><C:0000,0004,>Evet, <C:0000,0003,2C65FFFF>güneye\n<C:0000,0003,000000FF>Şafmantar Parkı'na doğru gitti.<C:0003,0001,>",
      "tokenized_text": "?<C:0003,0000,0A00> Birine mi yetişilecek?<C:0003,0000,0A00>\nAcil diyemem ama...<C:0003,0001,><C:0000,0004,>Birinin GERÇEKTEN çok hızlı\ngittiğini gördüm!<C:0003,0001,><C:0000,0004,>Evet, <C:0000,0003,2C65FFFF>güneye\n<C:0000,0003,000000FF>Şafmantar Parkı'na doğru gitti.<C:0003,0001,>",
      "original_text": "?<C:0003,0000,0A00> Birine mi yetişilecek?<C:0003,0000,0A00>\nAcil diyemem ama...<C:0003,0001,><C:0000,0004,>Birinin GERÇEKTEN çok hızlı\ngittiğini gördüm!<C:0003,0001,><C:0000,0004,>Evet, <C:0000,0003,2C65FFFF>güneye\n<C:0000,0003,000000FF>Şafmantar Parkı'na doğru gitti.<C:0003,0001,>",
      "original_tokenized_text": "?<C:0003,0000,0A00> Birine mi yetişilecek?<C:0003,0000,0A00>\nAcil diyemem ama...<C:0003,0001,><C:0000,0004,>Birinin GERÇEKTEN çok hızlı\ngittiğini gördüm!<C:0003,0001,><C:0000,0004,>Evet, <C:0000,0003,2C65FFFF>güneye\n<C:0000,0003,000000FF>Şafmantar Parkı'na doğru gitti.<C:0003,0001,>",
      "raw_full_hex": ""
    },
    "71": {
      "text": "<C:0001,0004,>Birisi az önce topuklayıp\n<C:0000,0003,2C65FFFF>güneye <C:0000,0003,000000FF>Şafmantar Parkı'na gitti...<C:0003,0001,><C:0000,0004,>O adama ne güç verdi bilmiyorum ama\nfena gidiyordu.<C:0003,0001,>",
      "tokenized_text": "<C:0001,0004,>Birisi az önce topuklayıp\n<C:0000,0003,2C65FFFF>güneye <C:0000,0003,000000FF>Şafmantar Parkı'na gitti...<C:0003,0001,><C:0000,0004,>O adama ne güç verdi bilmiyorum ama\nfena gidiyordu.<C:0003,0001,>",
      "original_text": "<C:0001,0004,>Birisi az önce topuklayıp\n<C:0000,0003,2C65FFFF>güneye <C:0000,0003,000000FF>Şafmantar Parkı'na gitti...<C:0003,0001,><C:0000,0004,>O adama ne güç verdi bilmiyorum ama\nfena gidiyordu.<C:0003,0001,>",
      "original_tokenized_text": "<C:0001,0004,>Birisi az önce topuklayıp\n<C:0000,0003,2C65FFFF>güneye <C:0000,0003,000000FF>Şafmantar Parkı'na gitti...<C:0003,0001,><C:0000,0004,>O adama ne güç verdi bilmiyorum ama\nfena gidiyordu.<C:0003,0001,>",
      "raw_full_hex": ""
    },
