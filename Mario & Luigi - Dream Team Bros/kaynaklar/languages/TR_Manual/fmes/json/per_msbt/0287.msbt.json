    "17": {
      "text": "<C:0001,0004,>Vereceğiniz bütün hasar\n<C:0000,0003,2C65FFFF><C:0000,0003,2C65FFFF>Mükemmel<C:0000,0003,2C65FFFF><C:0000,0003,000000FF> vuruşlardan gelmeli!<C:0000,0003,2C65FFFF><C:0003,0001,><C:0000,0003,000000FF>",
