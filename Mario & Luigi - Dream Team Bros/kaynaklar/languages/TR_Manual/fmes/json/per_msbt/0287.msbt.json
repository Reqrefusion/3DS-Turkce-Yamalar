    "16": {
      "text": "<C:0001,0004,>Düşmana tam zamanında zıpladığınızda\n<C:0000,0003,2C65FFFF>Mükemmel <C:0000,0003,000000FF>çıkıyor ya?<C:0000,0003,000000FF><C:0000,0003,2C65FFFF><C:0003,0001,><C:0000,0003,000000FF>",
