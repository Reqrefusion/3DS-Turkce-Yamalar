      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Ay, neyse...<C:0003,0000,0A00>\nDinleyin bakın?<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Ay, neyse...<C:0003,0000,0A00>\nDinleyin bakın?<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Ay, neyse...<C:0003,0000,0A00>\nDinleyin bakın?<C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": "0E00000003000400000000FF0E00010004000000410079002C0020006E0065007900730065002E002E002E000E000300000002000A000A00440069006E006C006500790069006E002000620061006B0031016E003F000E000300010000000E00000003000400000000FF0000"
    },
    "39": {
