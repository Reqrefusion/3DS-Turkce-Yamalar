      "raw_full_hex": "0E0001000400000048006100720069006B00610021000E000300010000000000"
    },
    "32": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Artık üç <C:0000,0003,2C65FFFF>Rüya Yumurtası<C:0000,0003,000000FF>'mız var!<C:0003,0001,><C:0000,0004,>İlk rüya dünyasında Seadric'le\nprensesin\nbeklediği yere geri dönelim.<C:0003,0001,>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Artık üç <C:0000,0003,2C65FFFF>Rüya Yumurtası<C:0000,0003,000000FF>'mız var!<C:0003,0001,><C:0000,0004,>İlk rüya dünyasında Seadric'le\nprensesin\nbeklediği yere geri dönelim.<C:0003,0001,>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Artık üç <C:0000,0003,2C65FFFF>Rüya Yumurtası<C:0000,0003,000000FF>'mız var!<C:0003,0001,><C:0000,0004,>İlk rüya dünyasında Seadric'le\nprensesin\nbeklediği yere geri dönelim.<C:0003,0001,>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Artık üç <C:0000,0003,2C65FFFF>Rüya Yumurtası<C:0000,0003,000000FF>'mız var!<C:0003,0001,><C:0000,0004,>İlk rüya dünyasında Seadric'le\nprensesin\nbeklediği yere geri dönelim.<C:0003,0001,>",
