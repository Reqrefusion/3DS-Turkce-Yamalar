    "26": {
      "text": "<C:0000,0002,6400><C:0000,0003,000000FF><C:0001,0004,>İşte, söyledim, değil mi?<C:0000,0002,6400>\nŞimdi <C:0000,0003,2C65FFFF>Rüya Yumurtası<C:0000,0003,000000FF>'nı alabilir miyiz?<C:0000,0002,6400><C:0000,0003,000000FF><C:0003,0001,>",
      "tokenized_text": "<C:0000,0002,6400><C:0000,0003,000000FF><C:0001,0004,>İşte, söyledim, değil mi?<C:0000,0002,6400>\nŞimdi <C:0000,0003,2C65FFFF>Rüya Yumurtası<C:0000,0003,000000FF>'nı alabilir miyiz?<C:0000,0002,6400><C:0000,0003,000000FF><C:0003,0001,>",
      "original_text": "<C:0000,0002,6400><C:0000,0003,000000FF><C:0001,0004,>İşte, söyledim, değil mi?<C:0000,0002,6400>\nŞimdi <C:0000,0003,2C65FFFF>Rüya Yumurtası<C:0000,0003,000000FF>'nı alabilir miyiz?<C:0000,0002,6400><C:0000,0003,000000FF><C:0003,0001,>",
      "original_tokenized_text": "<C:0000,0002,6400><C:0000,0003,000000FF><C:0001,0004,>İşte, söyledim, değil mi?<C:0000,0002,6400>\nŞimdi <C:0000,0003,2C65FFFF>Rüya Yumurtası<C:0000,0003,000000FF>'nı alabilir miyiz?<C:0000,0002,6400><C:0000,0003,000000FF><C:0003,0001,>",
      "raw_full_hex": ""
    },
    "27": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Pek samimi söyledin mi, emin değilim?\nAma AŞIRI coşkuluydun, o yüzden...<C:0000,0003,000000FF><C:0003,0001,>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Pek samimi söyledin mi, emin değilim?\nAma AŞIRI coşkuluydun, o yüzden...<C:0000,0003,000000FF><C:0003,0001,>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Pek samimi söyledin mi, emin değilim?\nAma AŞIRI coşkuluydun, o yüzden...<C:0000,0003,000000FF><C:0003,0001,>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Pek samimi söyledin mi, emin değilim?\nAma AŞIRI coşkuluydun, o yüzden...<C:0000,0003,000000FF><C:0003,0001,>",
      "raw_full_hex": ""
    },
