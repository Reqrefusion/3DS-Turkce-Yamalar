    "33": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Tamam.<C:0003,0000,0A00> Sıradaki\nDüş Noktası'na gidip sıradaki Seadring'i bulsak iyi olur!<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Tamam.<C:0003,0000,0A00> Sıradaki\nDüş Noktası'na gidip sıradaki Seadring'i bulsak iyi olur!<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Tamam.<C:0003,0000,0A00> Sıradaki\nDüş Noktası'na gidip sıradaki Seadring'i bulsak iyi olur!<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Tamam.<C:0003,0000,0A00> Sıradaki\nDüş Noktası'na gidip sıradaki Seadring'i bulsak iyi olur!<C:0003,0001,><C:0000,0003,000000FF>",
