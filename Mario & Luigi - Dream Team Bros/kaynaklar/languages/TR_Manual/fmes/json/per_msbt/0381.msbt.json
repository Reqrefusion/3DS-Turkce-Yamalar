    "34": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Bir dahaki sefere? Ben, şey, tam süsümü püsümü\nkuşanmışken kesin buluşalım, olur mu?<C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Bir dahaki sefere? Ben, şey, tam süsümü püsümü\nkuşanmışken kesin buluşalım, olur mu?<C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Bir dahaki sefere? Ben, şey, tam süsümü püsümü\nkuşanmışken kesin buluşalım, olur mu?<C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Bir dahaki sefere? Ben, şey, tam süsümü püsümü\nkuşanmışken kesin buluşalım, olur mu?<C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": ""
    },
    "35": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Beni tam bir süpermodel sanan birine göre\nbayağı buz gibisin.<C:0000,0003,000000FF><C:0003,0001,>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Beni tam bir süpermodel sanan birine göre\nbayağı buz gibisin.<C:0000,0003,000000FF><C:0003,0001,>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Beni tam bir süpermodel sanan birine göre\nbayağı buz gibisin.<C:0000,0003,000000FF><C:0003,0001,>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Beni tam bir süpermodel sanan birine göre\nbayağı buz gibisin.<C:0000,0003,000000FF><C:0003,0001,>",
      "raw_full_hex": ""
    },
    "36": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Benim şöyle bir rüyam var:<C:0003,0000,0A00> Beyaz atlı,\naşırı yakışıklı bir şövalye gelip\nbeni alıyor...<C:0003,0001,><C:0000,0003,000000FF><C:0000,0004,>Ve bu şövalye, tanıdığım şu sahte\nyastık prensten tam bir zıt kutup!<C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Benim şöyle bir rüyam var:<C:0003,0000,0A00> Beyaz atlı,\naşırı yakışıklı bir şövalye gelip\nbeni alıyor...<C:0003,0001,><C:0000,0003,000000FF><C:0000,0004,>Ve bu şövalye, tanıdığım şu sahte\nyastık prensten tam bir zıt kutup!<C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Benim şöyle bir rüyam var:<C:0003,0000,0A00> Beyaz atlı,\naşırı yakışıklı bir şövalye gelip\nbeni alıyor...<C:0003,0001,><C:0000,0003,000000FF><C:0000,0004,>Ve bu şövalye, tanıdığım şu sahte\nyastık prensten tam bir zıt kutup!<C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Benim şöyle bir rüyam var:<C:0003,0000,0A00> Beyaz atlı,\naşırı yakışıklı bir şövalye gelip\nbeni alıyor...<C:0003,0001,><C:0000,0003,000000FF><C:0000,0004,>Ve bu şövalye, tanıdığım şu sahte\nyastık prensten tam bir zıt kutup!<C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": ""
    },
    "37": {
      "text": "<C:0000,0003,000000FF><C:0001,0004,>Derin rüya, ha?!<C:0003,0000,0A00>\nEVET. ÇOK ANLAMLI.<C:0000,0003,000000FF><C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Derin rüya, ha?!<C:0003,0000,0A00>\nEVET. ÇOK ANLAMLI.<C:0000,0003,000000FF><C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "original_text": "<C:0000,0003,000000FF><C:0001,0004,>Derin rüya, ha?!<C:0003,0000,0A00>\nEVET. ÇOK ANLAMLI.<C:0000,0003,000000FF><C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "original_tokenized_text": "<C:0000,0003,000000FF><C:0001,0004,>Derin rüya, ha?!<C:0003,0000,0A00>\nEVET. ÇOK ANLAMLI.<C:0000,0003,000000FF><C:0000,0003,000000FF><C:0003,0001,><C:0000,0003,000000FF>",
      "raw_full_hex": "0E00000003000400000000FF0E0001000400000044006500720069006E0020007200FC00790061002C002000680061003F0021000E000300000002000A000A0045005600450054002E002000C7004F004B00200041004E004C0041004D004C0049002E000E00000003000400000000FF0E00000003000400000000FF0E000300010000000E00000003000400000000FF0000"
    },
    "38": {
